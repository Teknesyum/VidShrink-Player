<Project>

  <!-- The single place the version is written. Every project under this directory picks
       it up; no csproj carries a version of its own. The release workflow checks that the
       pushed tag is v$(Version) and that CHANGELOG.md has a heading for it. -->
  <PropertyGroup>
    <Version>0.0.4</Version>
  </PropertyGroup>

  <!-- CI builds Release with -warnaserror. Without this the two disagree: a local
       "dotnet test -c Release" reads green, the push lands, and CI fails on a warning
       the agent never saw. T87 lost a round to exactly that. Release only; a Debug
       build still reports warnings as warnings. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Teknesyum</Company>
    <Product>VidShrink</Product>
    <Authors>Teknesyum</Authors>
    <Copyright>Copyright (c) Teknesyum</Copyright>
    <!-- The SDK appends $(SourceRevisionId) to AssemblyInformationalVersion. The release
         workflow passes a seven-character sha; a local build does not leave it empty, source
         control information fills it with the full forty-character commit id. That full id
         reached the About box and was unreadable, so ShortenSourceRevisionId below trims
         any id to seven characters and both builds now read "0.1.1+abc1234". -->
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
    <SourceRevisionLength>7</SourceRevisionLength>
  </PropertyGroup>

  <!-- Runs before the SDK folds the revision into the informational version, so the length
       is decided in one place. Source control fills SourceRevisionId in the target this one
       depends on; without that dependency the trim would read an empty property. -->
  <Target Name="ShortenSourceRevisionId"
          DependsOnTargets="InitializeSourceControlInformation"
          BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="'$(IncludeSourceRevisionInInformationalVersion)' == 'true'">
    <PropertyGroup Condition="'$(SourceRevisionId)' != '' And $(SourceRevisionId.Length) &gt; $(SourceRevisionLength)">
      <SourceRevisionId>$(SourceRevisionId.Substring(0, $(SourceRevisionLength)))</SourceRevisionId>
    </PropertyGroup>
  </Target>

</Project>
