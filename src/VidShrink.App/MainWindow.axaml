<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:playback="using:VidShrink.App.Playback"
        xmlns:editing="using:VidShrink.App.Editing"
        xmlns:recorder="using:VidShrink.App.Recorder"
        xmlns:loc="using:VidShrink.App.Localization"
        xmlns:share="using:VidShrink.App.Share"
        xmlns:izi="using:VidShrink.App"
        xmlns:core="using:VidShrink.Core"
        x:Class="VidShrink.App.MainWindow"
        Title="{x:Static core:AppIdentity.Name}"
        Width="1560" Height="1060" MinWidth="1136" MinHeight="720"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WorkspaceGradient}"
        TransparencyLevelHint="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        ExtendClientAreaTitleBarHeightHint="-1"
        FontFamily="{StaticResource FontSans}" FontSize="{StaticResource FontSizeMd}"
        Foreground="{StaticResource TextBody}">

  <Window.Styles>
    <Style Selector="Window.reduced-motion Button">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Border.enter">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Ellipse">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion Path:not(.chevron)">
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Window.reduced-motion TabControl /template/ TransitioningContentControl#SelectedContentHost">
      <Setter Property="PageTransition" Value="{x:Null}"/>
    </Style>

    <!--
      Acilir bolum gorunur oldugunda yerine suzulur: Kalite, Ses, Kare, Gelismis, Hakkinda,
      yeniden kes paneli, HDR ilkesi, plan gerekceleri, AI ve basarim ayrintisi, sifirlama
      onayi. Hareketi azaltma acikken hic oynamaz.
    -->
    <Style Selector="Window:not(.reduced-motion) StackPanel.disclose[IsVisible=True]">
      <Style.Animations>
        <Animation Duration="{StaticResource MotionBase}" Easing="CubicEaseOut" FillMode="Forward">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="TranslateTransform.Y" Value="-10"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="TranslateTransform.Y" Value="0"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <!--
      Ust serit bir katman: icerik zaten tam yukseklikte duruyor, serit onun ustunde
      goruntuleniyor. Gizlenip acilirken icerik yer degistirmiyor.
    -->
    <Style Selector="Window.chrome-hidden Border#TitleBar">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Window.chrome-hidden TabControl#Tabs /template/ Panel#TopOverlay">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </Window.Styles>

  <Border x:Name="WindowShell"
          Background="{StaticResource WorkspaceGradient}"
          BorderBrush="{StaticResource NeonBlue}"
          BorderThickness="{StaticResource BorderThin}"
          CornerRadius="{StaticResource RadiusControl}"
          UseLayoutRounding="True">
    <Grid Background="{StaticResource WorkspaceBackground}">

      <Border x:Name="TitleBar"
              VerticalAlignment="Top"
              Height="{StaticResource TitleBarHeight}"
              Background="{StaticResource TitleBarBackground}"
              BorderBrush="{StaticResource NeonBlueBorderStrong}"
              BorderThickness="0,0,0,1"/>


        <TabControl x:Name="Tabs" Theme="{StaticResource NeonTabControl}" SelectedIndex="2" izi:AcilisIsareti.Ad="xaml-sekmeler">
        <TabControl.Tag>
        <StackPanel>
          <Border x:Name="AppliedNotice" Classes="reveal-panel"
                  Margin="{StaticResource NoticeMargin}"
                  IsVisible="False"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource NeonBlueBorder}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusControl}"
                  BoxShadow="{DynamicResource GlowBlue}"
                  Padding="{StaticResource ButtonPaddingSm}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
              <WrapPanel x:Name="AppliedNoticeText" VerticalAlignment="Center" ItemSpacing="{StaticResource SpaceMd}">
                <SarilanMetin x:Name="TxtAppliedLead"
                           Text="{loc:Text main.update.applied}"
                           Theme="{StaticResource Body}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <SarilanMetin x:Name="TxtAppliedVersion"
                           Theme="{StaticResource MonoValue}"
                           Foreground="{StaticResource NeonBlue}"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnWhatsNew"
                        Theme="{StaticResource LinkButton}"
                        Content="{loc:Text main.update.whats-new}"
                        VerticalAlignment="Center"
                        Click="OnWhatsNew"/>
              </WrapPanel>
              <Button Grid.Column="1"
                      x:Name="BtnAppliedDismiss"
                      Content="×"
                      Theme="{StaticResource GhostButton}"
                      FontFamily="{StaticResource FontMono}"
                      VerticalAlignment="Center"
                      auto:AutomationProperties.Name="{loc:Text main.window.close}"
                      Click="OnDismissAppliedNotice"/>
            </Grid>
          </Border>

          <Border x:Name="SettingsRecoveryNotice" Classes="reveal-panel"
                  Margin="{StaticResource NoticeMargin}"
                  IsVisible="False"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource NeonBlueBorder}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusControl}"
                  Padding="{StaticResource ButtonPaddingSm}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
              <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                    Stretch="Uniform" VerticalAlignment="Center"
                    Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
              <SarilanMetin x:Name="TxtSettingsRecovery" Grid.Column="1"
                         Theme="{StaticResource StatusWarning}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="2"
                      x:Name="BtnSettingsRecoveryDismiss"
                      Content="×"
                      Theme="{StaticResource GhostButton}"
                      FontFamily="{StaticResource FontMono}"
                      VerticalAlignment="Center"
                      auto:AutomationProperties.Name="{loc:Text main.window.close}"
                      Click="OnDismissSettingsRecovery"/>
            </Grid>
          </Border>

          <Border x:Name="UpdateNotice" Classes="reveal-panel"
                  Margin="{StaticResource NoticeMargin}"
                  IsVisible="False"
                  Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource NeonPurpleBorder}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource RadiusControl}"
                  BoxShadow="{DynamicResource GlowPurple}"
                  Padding="{StaticResource ButtonPaddingSm}">
            <StackPanel Spacing="{StaticResource SpaceMd}">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                <Image Grid.Column="0"
                       x:Name="UpdateNoticeIcon"
                       Width="{StaticResource IconSizeLg}"
                       Height="{StaticResource IconSizeLg}"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>
                <WrapPanel x:Name="UpdateNoticeText" Grid.Column="1" VerticalAlignment="Center" ItemSpacing="{StaticResource SpaceMd}">
                  <SarilanMetin x:Name="TxtNoticeLead"
                             Text="{loc:Text main.update.available}"
                             Theme="{StaticResource Body}"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"/>
                  <SarilanMetin x:Name="TxtNoticeVersion"
                             Theme="{StaticResource MonoValue}"
                             Foreground="{StaticResource NeonBlue}"
                             VerticalAlignment="Center"/>
                </WrapPanel>
                <Button Grid.Column="2"
                        x:Name="BtnNoticeLater"
                        Content="{loc:Text main.action.later}"
                        Theme="{StaticResource GhostButton}"
                        VerticalAlignment="Center"
                        Click="OnDismissUpdateNotice"/>
                <Button Grid.Column="3"
                        x:Name="BtnNoticeInstall"
                        IsVisible="False"
                        Content="{loc:Text main.action.install}"
                        Theme="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Click="OnInstallUpdate"/>
                <Button Grid.Column="3"
                        x:Name="BtnNoticeUpdate"
                        Content="{loc:Text main.action.update}"
                        Theme="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"
                        Click="OnDownloadAndInstallUpdate"/>
                <Button Grid.Column="4"
                        x:Name="BtnNoticeDismiss"
                        Content="×"
                        Theme="{StaticResource GhostButton}"
                        FontFamily="{StaticResource FontMono}"
                        VerticalAlignment="Center"
                        auto:AutomationProperties.Name="{loc:Text main.window.close}"
                        Click="OnDismissUpdateNotice"/>
              </Grid>
              <Border x:Name="UpdateLogArea"
                      IsVisible="False"
                      ClipToBounds="True"
                      Background="{StaticResource AppBg}"
                      CornerRadius="{StaticResource RadiusChip}">
                <Panel>
                  <StackPanel x:Name="UpdateLogLines"
                              VerticalAlignment="Bottom"
                              Margin="{StaticResource ChipPadding}"/>
                </Panel>
              </Border>
              <Grid x:Name="UpdateProgressRow"
                    IsVisible="False"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="{StaticResource SpaceMd}">
                <Border x:Name="UpdateBarTrack"
                        VerticalAlignment="Center"
                        Height="{StaticResource ProgressBarHeight}"
                        CornerRadius="{StaticResource RadiusChip}"
                        Background="{StaticResource AppBg}"
                        ClipToBounds="True">
                  <Border x:Name="UpdateBarFill"
                          HorizontalAlignment="Left"
                          CornerRadius="{StaticResource RadiusChip}"
                          Background="{StaticResource AccentGradient}"/>
                </Border>
                <SarilanMetin x:Name="TxtUpdatePercent"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Theme="{StaticResource MonoValue}"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
        </TabControl.Tag>
        <TabItem x:Name="TabPlayer" izi:AcilisIsareti.Ad="xaml-oynatici" Header="{loc:Text main.tab.player}" Tag="{StaticResource IconPlayer}" Theme="{StaticResource NeonTabItem}">
          <playback:PlayerView x:Name="Player" auto:AutomationProperties.Name="{loc:Text main.tab.player}"/>
        </TabItem>

        <TabItem x:Name="TabEditor" izi:AcilisIsareti.Ad="xaml-duzenleyici" Header="{loc:Text main.tab.editor}" Tag="{StaticResource IconEditor}" Theme="{StaticResource NeonTabItem}">
          <ContentControl x:Name="PageEditor"/>
        </TabItem>


        <TabItem x:Name="TabShrink" izi:AcilisIsareti.Ad="xaml-kucultme" Header="{loc:Text main.tab.shrink}" Tag="{StaticResource IconShrink}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageShrink" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <izi:KucultSutunlari x:Name="ShrinkColumns" Margin="{StaticResource PageMargin}" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceMd}">

              <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceLg}">

                <Border x:Name="SourcePanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <SarilanMetin Text="{loc:Text main.source.title}" Theme="{StaticResource H2}"/>

                    <Panel x:Name="DropZone" MinHeight="{StaticResource DropZoneMinHeight}">
                      <Rectangle x:Name="DropOutline"
                                 RadiusX="{StaticResource RadiusPanelScalar}"
                                 RadiusY="{StaticResource RadiusPanelScalar}"
                                 Stroke="{StaticResource NeonBlueBorderStrong}"
                                 StrokeThickness="{StaticResource DropOutlineThickness}"
                                 StrokeDashArray="4,4"
                                 Fill="{StaticResource NeonBlueFill}">
                        <Rectangle.Transitions>
                          <Transitions>
                            <BrushTransition Property="Stroke" Duration="{StaticResource MotionFast}"/>
                            <BrushTransition Property="Fill" Duration="{StaticResource MotionFast}"/>
                          </Transitions>
                        </Rectangle.Transitions>
                      </Rectangle>
                      <StackPanel VerticalAlignment="Center" Spacing="{StaticResource SpaceSm}" Margin="{StaticResource DropZonePadding}">
                        <Path x:Name="DropIcon"
                              Width="{StaticResource DropIconSize}"
                              Height="{StaticResource DropIconSize}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Stroke="{StaticResource NeonBlue}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              RenderTransform="none"
                              Data="M 24 6 L 24 31 M 14 21 L 24 31 L 34 21 M 8 33 L 8 42 L 40 42 L 40 33">
                          <Path.Effect>
                            <DropShadowEffect OffsetX="0" OffsetY="0"
                                              BlurRadius="{StaticResource DropIconGlowRadius}"
                                              Color="{StaticResource Renk1Color}"/>
                          </Path.Effect>
                          <Path.Transitions>
                            <Transitions>
                              <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                              <BrushTransition Property="Stroke" Duration="{StaticResource MotionFast}"/>
                            </Transitions>
                          </Path.Transitions>
                        </Path>
                        <SarilanMetin x:Name="TxtDropTitle" Theme="{StaticResource DropTitle}"/>
                        <SarilanMetin x:Name="TxtDropHint" Theme="{StaticResource DropHint}"/>
                        <Button x:Name="BtnBrowseEmpty" Content="{loc:Text main.action.browse}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Center" Click="OnBrowse"/>
                      </StackPanel>
                    </Panel>

                    <DockPanel x:Name="SourceCard" IsVisible="False" HorizontalSpacing="{StaticResource SpaceMd}">
                      <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                        <Button x:Name="BtnMediaDetails" Content="{loc:Text mediainfo.open}" Theme="{StaticResource GhostButton}" Click="OnMediaDetails"/>
                        <Button Content="{loc:Text main.action.browse}" Theme="{StaticResource GhostButton}" Click="OnBrowse"/>
                      </WrapPanel>
                      <SarilanMetin x:Name="TxtFileName" Theme="{StaticResource Body}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding $self.Text}"/>
                    </DockPanel>

                    <SarilanMetin x:Name="TxtSourceStatus" Classes="reveal" Theme="{StaticResource StatusError}" IsVisible="False"/>

                    <Grid x:Name="TitleRow" IsVisible="False" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <SarilanMetin Text="{loc:Text main.title.label}" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
                      <ComboBox Grid.Column="1" x:Name="CmbTitle" auto:AutomationProperties.Name="{loc:Text main.title.label}" HorizontalAlignment="Left" VerticalAlignment="Center" SelectionChanged="OnTitleChanged"/>
                    </Grid>

                    <izi:SutunIzgara x:Name="InfoGrid" MaxColumns="4" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}" IsVisible="False">
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.duration}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtDuration" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.size}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtSize" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.resolution}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtResolution" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.fps}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtFps" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.video-codec}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtVideoCodec" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.audio}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtAudio" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.bitrate}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtBitrate" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                      <StackPanel>
                        <SarilanMetin Text="{loc:Text main.info.hdr}" Theme="{StaticResource Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                        <SarilanMetin x:Name="TxtHdr" Theme="{StaticResource MonoValue}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                      </StackPanel>
                    </izi:SutunIzgara>
                  </StackPanel>
                </Border>

                <Border x:Name="TargetPanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <StackPanel Orientation="Horizontal">
                      <SarilanMetin Text="{loc:Text main.target.title}" Theme="{StaticResource H2}"/>
                    </StackPanel>
                    <!--
                      T61: hedef ve kalite aynı sütun ölçüsünü paylaşır (SharedSizeGroup);
                      sayı kutusunun genişliği NumberBoxWidth belirtecinden gelir.
                    -->
                    <StackPanel Grid.IsSharedSizeScope="True" Spacing="{StaticResource SpaceMd}">
                      <izi:KaydiriciSatiri x:Name="TargetSliderRow" EnDarKaydirici="{StaticResource SliderMinWidth}"
                                           ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}">
                        <izi:KaydiriciSatiri.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="HedefKutu"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="HedefBirim"/>
                        </izi:KaydiriciSatiri.ColumnDefinitions>
                        <Slider x:Name="SliderTarget" auto:AutomationProperties.Name="{loc:Text main.target.title}" Minimum="1" Maximum="500" Value="16" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtTarget" auto:AutomationProperties.Name="{loc:Text main.target.title}" Text="16" Width="{StaticResource NumberBoxWidth}" TextAlignment="Center" Foreground="{StaticResource NeonBlue}" FontWeight="Bold"/>
                        <SarilanMetin Text="{loc:Text main.unit.mb}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      </izi:KaydiriciSatiri>
                    <!--
                      T46/K1: yonga yalnız sayıyı gösterir. Açıklamanın tek yeri balondur ve
                      balonun ilk satırı yonganın eski etiketidir — etiket ekrandan kalktı,
                      bilgi kalkmadı.
                    -->
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                    <SarilanMetin x:Name="TxtTargetCrfLockedNotice"
                               Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"
                               Text="{loc:Text main.target.crf-locked}"/>
                    <izi:YongaSeridi x:Name="ChipStrip">
                      <Button x:Name="ChipArchive" Content="{loc:Text main.intent.archive}" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPresetArchive">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.archive.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="ChipHalf" Content="{loc:Text main.chip.half}" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPresetHalf">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.half.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip8" Content="8" Tag="8" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.8.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="ChipWhatsApp" Content="16" Tag="16" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.chip.whatsapp.label}"/>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.whatsapp.tip}"/>
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip25" Content="25" Tag="25" izi:YongaSeridi.SatirBasi="True" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.25.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip100" Content="100" Tag="100" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.100.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip134" Content="134" Tag="134" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.chip.134.label}"/>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.134.tip}"/>
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="Chip180" Content="180" Tag="180" Theme="{StaticResource ChipButton}" Margin="{StaticResource WrapItemMargin}" Click="OnPreset">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.chip.180.label}"/>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.chip.180.tip}"/>
                            </StackPanel>
                          </StackPanel>
                        </ToolTip.Tip>
                      </Button>
                      <!--
                        Kullanıcının kendi ön ayarları gömülü sekizin ardında, ince bir
                        ayırıcının arkasında duruyor; en son eleman her zaman "+". Ayırıcı
                        kullanıcı ön ayarı yokken görünmüyor.
                      -->
                      <Border x:Name="ChipUserSeparator" Width="1" IsVisible="False"
                              VerticalAlignment="Stretch"
                              Margin="{StaticResource WrapItemMargin}"
                              Background="{StaticResource NeonBlueBorder}"/>
                      <Button x:Name="ChipAddPreset" Content="+" Theme="{StaticResource ChipButton}" Classes="eylem"
                              Margin="{StaticResource WrapItemMargin}"
                              AutomationProperties.Name="{loc:Text main.preset.add.name}">
                        <ToolTip.Tip>
                          <StackPanel Spacing="{StaticResource SpaceSm}">
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.preset.add.tip}"/>
                          </StackPanel>
                        </ToolTip.Tip>
                        <Button.Flyout>
                          <Flyout>
                            <StackPanel Spacing="{StaticResource SpaceSm}" MinWidth="220">
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.preset.name.label}"/>
                              <TextBox x:Name="TxtPresetName" auto:AutomationProperties.Name="{loc:Text main.preset.name.label}" MaxLength="60"/>
                              <SarilanMetin x:Name="TxtPresetNotice" Theme="{StaticResource Hint}"
                                         TextWrapping="Wrap" IsVisible="False"/>
                              <Button x:Name="BtnPresetSave" Content="{loc:Text main.preset.save}" Click="OnPresetSave"/>
                              <Border Theme="{StaticResource PanelRule}"/>
                              <WrapPanel>
                                <Button x:Name="BtnPresetImport" Content="{loc:Text main.preset.import}" Theme="{StaticResource GhostButton}"
                                        Margin="{StaticResource WrapItemMargin}" Click="OnPresetImport"/>
                                <Button x:Name="BtnPresetExport" Content="{loc:Text main.preset.export}" Theme="{StaticResource GhostButton}"
                                        Margin="{StaticResource WrapItemMargin}" Click="OnPresetExport"/>
                              </WrapPanel>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </izi:YongaSeridi>
                    <SarilanMetin x:Name="TxtChipDerivation" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <!--
                      Silme onay penceresi istemiyor: yonga kalkıyor, bu satır beliriyor ve
                      geri alma silinen ön ayarı geri yazıyor.
                    -->
                    <StackPanel x:Name="PresetUndoBar" Classes="reveal-panel" Orientation="Horizontal" IsVisible="False"
                                Spacing="{StaticResource SpaceSm}">
                      <SarilanMetin x:Name="TxtPresetUndo" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <Button x:Name="BtnPresetUndo" Content="{loc:Text main.preset.undo}"
                              Theme="{StaticResource ChipButton}" Click="OnPresetUndo"/>
                    </StackPanel>
                    </StackPanel>

                      <SarilanMetin Text="{loc:Text main.quality.title}" Theme="{StaticResource H2}"/>
                      <izi:KaydiriciSatiri x:Name="QualitySliderRow" EnDarKaydirici="{StaticResource SliderMinWidth}"
                                           ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}">
                        <izi:KaydiriciSatiri.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="HedefKutu"/>
                          <ColumnDefinition Width="Auto" SharedSizeGroup="HedefBirim"/>
                        </izi:KaydiriciSatiri.ColumnDefinitions>
                        <Slider x:Name="SliderQualityTarget" auto:AutomationProperties.Name="{loc:Text main.quality.title}" Minimum="1" Maximum="100" Value="60" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQualityTarget" auto:AutomationProperties.Name="{loc:Text main.quality.title}" Text="60" Width="{StaticResource NumberBoxWidth}" TextAlignment="Center" Foreground="{StaticResource NeonBlue}" FontWeight="Bold"/>
                        <SarilanMetin Text="{loc:Text main.unit.score-suffix}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      </izi:KaydiriciSatiri>
                      <SarilanMetin x:Name="TxtQualityTargetNotice" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>

              <!--
                Orta sütun iki katmandır: üstte karşılaştırma paneli, altında yapılacak
                işlem paneli. Üç sütunlu düzen bozulmuyor — panel kendi sütununu almıyor,
                ortadaki sütunun başına giriyor (T43/K1).
              -->
              <!--
                T54/K4: artan yer önizlemeye gider. Önizleme esneyen satırdadır, plan
                paneli varsayılan olarak içeriği kadar büyür — istediği kadarını alır,
                kalanını önizlemeye bırakır. Eski düzende esneyen satır MaxHeight'lı plan
                panelindeydi ve artan yer kimseye gitmiyordu.

                T74/K1: "Preview" başlığı ve onu taşıyan Auto satır kaldırıldı. Yan
                sütunlar panelle başlıyor, orta sütun başlıkla başlıyordu; başlık gidince
                üç sütunun tepesi de aynı hizaya oturuyor.

                T163/K3: kullanıcının sürüklediği yer artık kalıcı. İkinci satırdaki
                GridSplitter üçüncü satırın (plan paneli) yüksekliğini değiştirir; hiç
                sürüklenmemişse satır Auto kalır ve K1/K2'nin ölçtüğü içerik-güdümlü
                boy geçerli olmaya devam eder — eski ölçüm burada bozulmuyor. Sürüklenince
                satır piksele döner, taban ve tavan PlanPanelRow üzerinde durur (GridSplitter
                onlara bakar), konum ApplySplitterSettings/OnSplitterMoved ile diske yazılır.
              -->
              <Grid Grid.Column="1" x:Name="PreviewPlanGrid">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"
                                 MinHeight="{StaticResource PlanPanelMinHeight}"
                                 MaxHeight="{StaticResource PlanPanelMaxHeight}"/>
                </Grid.RowDefinitions>

                <playback:ComparisonPanel Grid.Row="0" x:Name="Preview" VerticalAlignment="Stretch"/>

                <GridSplitter Grid.Row="1" x:Name="PlanSplitter" Theme="{StaticResource PlanSplitter}"
                              HorizontalAlignment="Stretch" ResizeDirection="Rows"
                              auto:AutomationProperties.Name="{loc:Text main.plan.splitter}"/>

              <Border x:Name="PlanPanel"
                      Grid.Row="2"
                      Theme="{StaticResource Panel}"
                      MinHeight="{StaticResource PlanPanelMinHeight}"
                      MaxHeight="{StaticResource PlanPanelMaxHeight}">
                <Grid RowDefinitions="Auto,*" RowSpacing="{StaticResource SpaceMd}">
                  <SarilanMetin Grid.Row="0" Text="{loc:Text main.plan.title}" Theme="{StaticResource H2}"/>
                  <ScrollViewer Grid.Row="1" x:Name="PlanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <StackPanel x:Name="PlanBody" Spacing="{StaticResource SpaceMd}">
                      <SarilanMetin x:Name="TxtPlanEmpty" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text main.plan.empty}"/>
                      <izi:CiftIzgara x:Name="PlanFacts" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}"/>
                      <Border x:Name="PlanRule" Theme="{StaticResource PanelRule}" IsVisible="False"/>
                      <!--
                        T46/K6: gerekçeler katlanır. Metin kısalmıyor, yalnız katlanıyor —
                        panelin varsayılan hâli planın net özeti (olgular), gerekçeler bir
                        tıkla açılıyor. Ölçüm: gerekçeler açıkken içerik görüş alanını
                        aşıyordu, katlıyken sığıyor.
                      -->
                      <Grid x:Name="PlanReasonsHead"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="{StaticResource SpaceMd}"
                            IsVisible="False">
                        <SarilanMetin Grid.Column="0"
                                   x:Name="TxtPlanReasonsHead"
                                   TextWrapping="Wrap"
                                   Theme="{StaticResource H3}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="BtnPlanReasons"
                                Theme="{StaticResource GhostButton}"
                                VerticalAlignment="Center"
                                auto:AutomationProperties.Name="{loc:Text main.plan.reasons}"
                                Click="OnTogglePlanReasons">
                                  <Path x:Name="GlyphPlanReasons" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                                </Button>
                      </Grid>
                      <StackPanel x:Name="PlanReasons" Classes="disclose" Spacing="{StaticResource SpaceSm}" IsVisible="False"/>
                    </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>

              </Grid>

              <StackPanel Grid.Column="2" Spacing="{StaticResource SpaceLg}">

                <Border x:Name="OutputPanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <SarilanMetin Text="{loc:Text main.output.title}" Theme="{StaticResource H2}"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                      <ProgressBar x:Name="Progress" Maximum="1" VerticalAlignment="Center"/>
                      <SarilanMetin x:Name="TxtProgressPercent" Grid.Column="1" VerticalAlignment="Center" Theme="{StaticResource MonoValue}" IsVisible="False"/>
                    </Grid>
                    <StackPanel Spacing="{StaticResource SpaceMd}">
                    <izi:SutunIzgara x:Name="OutputFacts" MaxColumns="2" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceMd}">

                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <Grid MinHeight="{StaticResource TargetMinSize}"><SarilanMetin Text="{loc:Text main.output.stage}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
                        <SarilanMetin x:Name="TxtStage" Text="{loc:Text main.output.idle}" Theme="{StaticResource OutFactValue}" TextWrapping="Wrap">
                          <SarilanMetin.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </SarilanMetin.Transitions>
                        </SarilanMetin>
                      </StackPanel>

                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <Grid MinHeight="{StaticResource TargetMinSize}"><SarilanMetin Text="{loc:Text main.output.current-size}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
                        <SarilanMetin x:Name="TxtOutSize" Text="-" Theme="{StaticResource OutFactValue}"/>
                      </StackPanel>

                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <Grid MinHeight="{StaticResource TargetMinSize}"><SarilanMetin Text="{loc:Text main.output.remaining}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
                        <SarilanMetin x:Name="TxtRemaining" Text="-" Theme="{StaticResource OutFactValue}"/>
                      </StackPanel>

                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <Grid ColumnDefinitions="*,Auto">
                          <SarilanMetin Grid.Column="0" x:Name="LblDuration" Text="{loc:Text main.output.estimated-time}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Theme="{StaticResource InfoButton}" VerticalAlignment="Center" auto:AutomationProperties.Name="{loc:Text main.output.estimated-time}">
                            <ToolTip.Tip>
                              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.output.estimated-time.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                        </Grid>
                        <SarilanMetin x:Name="TxtDurationValue" Text="-" Theme="{StaticResource OutFactValue}">
                          <SarilanMetin.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </SarilanMetin.Transitions>
                        </SarilanMetin>
                      </StackPanel>
                    </izi:SutunIzgara>
                    <SarilanMetin x:Name="TxtDurationRange" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <Grid ColumnDefinitions="*,Auto">
                          <SarilanMetin Grid.Column="0" x:Name="LblEstimate" Text="{loc:Text main.output.estimated-output}" Theme="{StaticResource OutFactLabel}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          <Button Grid.Column="1" Theme="{StaticResource InfoButton}" VerticalAlignment="Center" auto:AutomationProperties.Name="{loc:Text main.output.estimated-output}">
                            <ToolTip.Tip>
                              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.output.estimated-output.tip}"/>
                            </ToolTip.Tip>
                          </Button>
                        </Grid>
                        <SarilanMetin x:Name="TxtEstimateValue" Text="-" Theme="{StaticResource OutFactValue}">
                          <SarilanMetin.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                            </Transitions>
                          </SarilanMetin.Transitions>
                        </SarilanMetin>
                        <SarilanMetin x:Name="TxtEstimateRange" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </StackPanel>
                    </StackPanel>
                    <SarilanMetin x:Name="TxtEstimateNote" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceXs}" IsVisible="{Binding #TxtResult.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <Path x:Name="ResultWarningGlyph"
                            IsVisible="False"
                            Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                            Stretch="Uniform" VerticalAlignment="Top"
                            Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
                      <SarilanMetin x:Name="TxtResult" Grid.ColumnSpan="2" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    </Grid>
                    <Border x:Name="RetryAskPanel"
                            IsVisible="False"
                            Background="{StaticResource NeonPinkFill}"
                            BorderBrush="{StaticResource NeonPink}"
                            BorderThickness="{StaticResource BorderThin}"
                            CornerRadius="{StaticResource RadiusCell}"
                            Padding="{StaticResource PanelPadding}">
                      <Border.Styles>
                        <Style Selector=":is(Button) /template/ ContentPresenter#PART_ContentPresenter">
                          <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                      </Border.Styles>
                      <StackPanel Spacing="{StaticResource SpaceSm}">
                        <SarilanMetin Text="{loc:Text main.retry.title}" Theme="{StaticResource H3}" TextWrapping="Wrap"/>
                        <SarilanMetin x:Name="TxtRetryOutcome" Theme="{StaticResource PlanFactValue}"/>
                        <WrapPanel>
                          <Button x:Name="BtnRetryAgain" Content="{loc:Text main.retry.again}" Theme="{StaticResource PrimaryButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryAgain"/>
                          <Button x:Name="BtnRetryTrim" auto:AutomationProperties.Name="{loc:Text main.retry.trim.name}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryTrim"/>
                          <Button x:Name="BtnRetryAccept" auto:AutomationProperties.Name="{loc:Text main.retry.accept.name}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryAccept"/>
                          <Button x:Name="BtnRetryStop" Content="{loc:Text main.retry.stop}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnRetryStop"/>
                        </WrapPanel>
                        <StackPanel x:Name="RetryTrimPanel" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceSm}">
                          <WrapPanel ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceXs}">
                            <RadioButton x:Name="RbTrimEnd" GroupName="OvershootTrim" IsChecked="True" Content="{loc:Text main.retry.trim.end}"/>
                            <RadioButton x:Name="RbTrimStart" GroupName="OvershootTrim" Content="{loc:Text main.retry.trim.start}"/>
                            <RadioButton x:Name="RbTrimBoth" GroupName="OvershootTrim" Content="{loc:Text main.retry.trim.both}"/>
                          </WrapPanel>
                          <SarilanMetin x:Name="TxtTrimRange" Theme="{StaticResource PlanFactValue}" TextWrapping="Wrap"/>
                          <Button x:Name="BtnTrimConfirm" Content="{loc:Text main.retry.trim.confirm}" Theme="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="OnTrimConfirm"/>
                        </StackPanel>
                        <SarilanMetin x:Name="TxtRetryMeaning" Theme="{StaticResource PlanReasonText}"/>
                      </StackPanel>
                    </Border>
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                      <WrapPanel>
                        <Button x:Name="BtnReveal" Classes="reveal" Content="{loc:Text main.action.show-in-folder}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnReveal"/>
                        <Button x:Name="BtnShare" Classes="reveal" Content="{loc:Text main.action.share}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnShare"/>
                        <Button x:Name="BtnShareCancel" Content="{loc:Text main.action.cancel-upload}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnShareCancel"/>
                        <Button x:Name="BtnShareRetry" auto:AutomationProperties.Name="{loc:Text settings.share.retry}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False"/>
                      </WrapPanel>
                      <ProgressBar x:Name="ShareProgress" Maximum="1" IsVisible="False"/>
                      <Grid x:Name="ShareLinkRow"
                            IsVisible="False"
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="{StaticResource SpaceMd}"
                            RowSpacing="{StaticResource SpaceMd}">
                        <TextBox Grid.Column="0"
                                 x:Name="TxtShareLink"
                                 auto:AutomationProperties.Name="{loc:Text main.share.link}"
                                 IsReadOnly="True"
                                 FontFamily="{StaticResource FontMono}"
                                 VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                x:Name="BtnShareCopy"
                                Content="{loc:Text main.action.copy}"
                                Theme="{StaticResource GhostButton}"
                                VerticalAlignment="Center"
                                Click="OnCopyShareLink"/>
                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="{StaticResource SpaceSm}"
                              IsVisible="{Binding #QrShare.IsVisible}">
                          <share:ShareQrCode HorizontalAlignment="Left"
                                             x:Name="QrShare"
                                             Link="{Binding #TxtShareLink.Text}"
                                             ModuleSize="{StaticResource ShareQrModuleSize}"
                                             auto:AutomationProperties.Name="{loc:Text main.share.qr}"
                                             auto:AutomationProperties.HelpText="{loc:Text main.share.qr-hint}"/>
                          <SarilanMetin Grid.Row="1"
                                     Theme="{StaticResource Hint}"
                                     Text="{loc:Text main.share.qr-hint}"
                                     TextWrapping="Wrap"/>
                        </Grid>
                      </Grid>
                      <SarilanMetin x:Name="TxtShareStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>


                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnPauseRun" Content="{loc:Text main.action.pause-run}" Theme="{StaticResource GhostButton}" IsEnabled="False" IsVisible="False" Click="OnPauseRun"/>
                  <Button x:Name="BtnCancel" Content="{loc:Text main.action.cancel}" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.cancel.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                  <Button x:Name="BtnStart" Content="{loc:Text main.action.shrink}" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnStart">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.shrink.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                </StackPanel>

                <Border x:Name="OutcomePanel" Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceMd}">
                      <SarilanMetin Grid.Column="0" Text="{loc:Text main.section.outcome}" Theme="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                      <SarilanMetin Grid.Column="1" x:Name="TxtOutcomeSummary" Theme="{StaticResource MonoValue}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel x:Name="SecQuality">
                      <Button x:Name="BtnQualityToggle"
                              Click="OnToggleQuality"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.section.quality}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphQuality" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Column="1" Text="{loc:Text main.section.quality}" Theme="{StaticResource Label}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Row="1" Grid.Column="1" x:Name="TxtQualitySummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="QualitySectionBody" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}" Margin="{StaticResource RowMargin}">
                        <!-- Kullanıcı 09-04: WhatsApp uyumu işaretlenirse eski kodek (H.264) kullanılır, kodek seçimi kilitlenir. -->
                        <CheckBox x:Name="ChkWhatsAppCompatible" Theme="{StaticResource CheckStyle}" IsChecked="False" HorizontalAlignment="Left" Content="{loc:Text main.whatsapp-compatible}"/>
                        <Grid x:Name="CodecChoiceRow" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <ToolTip.Tip>
                            <StackPanel Spacing="{StaticResource SpaceSm}">
                              <SarilanMetin x:Name="TxtCodecTip" Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.codec.tip}"/>
                            </StackPanel>
                          </ToolTip.Tip>
                          <SarilanMetin Text="{loc:Text main.codec.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <RadioButton x:Name="RbCodecAuto" GroupName="ShrinkCodec" IsChecked="True" Content="{loc:Text main.codec.automatic}"/>
                            <RadioButton x:Name="RbCodecCompatible" GroupName="ShrinkCodec" Content="{loc:Text main.codec.compatible}"/>
                            <RadioButton x:Name="RbCodecSmallest" GroupName="ShrinkCodec" Content="{loc:Text main.codec.smallest}"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.fill.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <RadioButton x:Name="RbFillTarget" GroupName="ShrinkFill" IsChecked="True" Content="{loc:Text main.fill.target}"/>
                            <RadioButton x:Name="RbFillCeiling" GroupName="ShrinkFill" Content="{loc:Text main.fill.ceiling}"/>
                          </WrapPanel>
                        </Grid>
                        <CheckBox x:Name="ChkFastGpu" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" HorizontalAlignment="Left" Content="{loc:Text main.fast-gpu}">
                          <ToolTip.Tip>
                            <SarilanMetin x:Name="TipFastGpu" Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.fast-gpu.tip}"/>
                          </ToolTip.Tip>
                        </CheckBox>
                        <StackPanel x:Name="HdrPolicyPanel" Classes="disclose" IsVisible="False">
                          <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                            <SarilanMetin Text="{loc:Text main.hdr.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                            <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                              <RadioButton x:Name="RbHdrPreserve" GroupName="ShrinkHdr" IsChecked="True" Content="{loc:Text main.hdr.preserve}"/>
                              <RadioButton x:Name="RbHdrSdr" GroupName="ShrinkHdr" Content="{loc:Text main.hdr.sdr}"/>
                            </WrapPanel>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SecAudio">
                      <Button x:Name="BtnAudioToggle"
                              Click="OnToggleAudio"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.section.audio}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphAudio" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Column="1" Text="{loc:Text main.section.audio}" Theme="{StaticResource Label}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Row="1" Grid.Column="1" x:Name="TxtAudioSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="AudioBody" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}" Margin="{StaticResource RowMargin}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.audio-kbps.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvAudioKbps" auto:AutomationProperties.Name="{loc:Text main.advanced.audio-kbps.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvAudioKbpsNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.audio-channels.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvAudioChannels" auto:AutomationProperties.Name="{loc:Text main.advanced.audio-channels.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvAudioChannelsNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.audio-codec.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvAudioCodec" SelectedIndex="0" VerticalAlignment="Center"
                                      AutomationProperties.Name="{loc:Text main.advanced.audio-codec.label}"/>
                            <SarilanMetin x:Name="TxtAdvAudioCodecNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.audio.level.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <CheckBox x:Name="ChkAudioLoudnorm" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Bottom"
                                      MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                      Content="{loc:Text main.audio.loudnorm}"/>
                            <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                              <SarilanMetin Text="{loc:Text main.audio.gain}" Theme="{StaticResource Hint}"/>
                              <ComboBox x:Name="CmbAudioGain"
                                        auto:AutomationProperties.Name="{loc:Text main.audio.gain}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAudioDenoise" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Bottom"
                                      MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                      Content="{loc:Text main.audio.denoise}"/>
                            <Button x:Name="BtnMeasureLoudness" Theme="{StaticResource GhostButton}" Click="OnMeasureLoudness" VerticalAlignment="Bottom"
                                    MinHeight="{StaticResource FieldMinHeight}" IsEnabled="False"
                                    Padding="{StaticResource ButtonPaddingSm}" Content="{loc:Text main.audio.loudness.measure}"
                                    auto:AutomationProperties.Name="{loc:Text main.audio.loudness.measure}"/>
                          </WrapPanel>
                          <SarilanMetin x:Name="TxtLoudness" Grid.Row="2" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.audio.external.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <Button x:Name="BtnAddAudioFile" Theme="{StaticResource GhostButton}" Click="OnAddAudioFile" VerticalAlignment="Bottom"
                                    MinHeight="{StaticResource FieldMinHeight}"
                                    Padding="{StaticResource ButtonPaddingSm}" Content="{loc:Text main.audio.external.add}"/>
                            <CheckBox x:Name="ChkAudioReplace" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Bottom"
                                      MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                      Content="{loc:Text main.audio.external.replace}"/>
                          </WrapPanel>
                          <StackPanel x:Name="AudioFileList" Grid.Row="2" Spacing="{StaticResource SpaceXs}" IsVisible="False"/>
                        </Grid>
                        <CheckBox x:Name="ChkAdvKeepTracks" Theme="{StaticResource CheckStyle}" IsChecked="False" Content="{loc:Text main.advanced.keep-tracks.label}"/>
                        <CheckBox x:Name="ChkAdvDropMetadata" Theme="{StaticResource CheckStyle}" IsChecked="False" HorizontalAlignment="Left" Content="{loc:Text main.advanced.drop-metadata.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.advanced.drop-metadata.tip}"/>
                          </ToolTip.Tip>
                        </CheckBox>
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.subtitles.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <Button x:Name="BtnAddSubtitle" Theme="{StaticResource GhostButton}" Click="OnAddSubtitle" VerticalAlignment="Bottom"
                                    MinHeight="{StaticResource FieldMinHeight}"
                                    Padding="{StaticResource ButtonPaddingSm}" Content="{loc:Text main.subtitles.add}"/>
                            <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                              <SarilanMetin Text="{loc:Text main.subtitles.burn}" Theme="{StaticResource Hint}"/>
                              <ComboBox x:Name="CmbBurnSubtitle"
                                        auto:AutomationProperties.Name="{loc:Text main.subtitles.burn}">
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="x:String">
                                    <SarilanMetin Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                            </StackPanel>
                            <Button x:Name="BtnScanSubtitle" Theme="{StaticResource GhostButton}" Click="OnScanSubtitle" VerticalAlignment="Bottom"
                                    MinHeight="{StaticResource FieldMinHeight}" IsEnabled="False"
                                    Padding="{StaticResource ButtonPaddingSm}" Content="{loc:Text main.subtitles.scan}"
                                    auto:AutomationProperties.Name="{loc:Text main.subtitles.scan}">
                              <Button.Styles>
                                <Style Selector="Button:disabled">
                                  <Setter Property="ToolTip.Tip" Value="{loc:Text main.subtitles.scan.no-subtitles}"/>
                                </Style>
                              </Button.Styles>
                            </Button>
                          </WrapPanel>
                          <StackPanel Grid.Row="2" Spacing="{StaticResource SpaceXs}">
                            <WrapPanel x:Name="BurnStylePanel" IsVisible="False" HorizontalAlignment="Left"
                                       ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                              <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                                <SarilanMetin Text="{loc:Text main.subtitles.style.font}" Theme="{StaticResource Hint}"/>
                                <ComboBox x:Name="CmbBurnFont"
                                          auto:AutomationProperties.Name="{loc:Text main.subtitles.style.font}"/>
                              </StackPanel>
                              <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                                <SarilanMetin Text="{loc:Text main.subtitles.style.size}" Theme="{StaticResource Hint}"/>
                                <ComboBox x:Name="CmbBurnSize"
                                          auto:AutomationProperties.Name="{loc:Text main.subtitles.style.size}"/>
                              </StackPanel>
                              <CheckBox x:Name="ChkBurnBox" Theme="{StaticResource CheckStyle}" VerticalAlignment="Bottom"
                                        MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                        Content="{loc:Text main.subtitles.style.box}"/>
                            </WrapPanel>
                            <SarilanMetin x:Name="TxtSubtitleScan" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"
                                       auto:AutomationProperties.LiveSetting="Polite"/>
                            <StackPanel x:Name="SubtitleList" Spacing="{StaticResource SpaceXs}" IsVisible="False"/>
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SecFrame">
                      <Button x:Name="BtnFrameToggle"
                              Click="OnToggleFrame"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.section.frame}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphFrame" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Column="1" Text="{loc:Text main.section.frame}" Theme="{StaticResource Label}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Row="1" Grid.Column="1" x:Name="TxtFrameSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="FrameBody" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}" Margin="{StaticResource RowMargin}">
                        <WrapPanel ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                          <CheckBox x:Name="ChkResolution" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="{loc:Text main.allow.resolution}"/>
                          <CheckBox x:Name="ChkFps" Theme="{StaticResource CheckStyle}" IsChecked="True" Content="{loc:Text main.allow.fps}"/>
                        </WrapPanel>
                        <!-- Kullanıcı 09-04: dinamik çözünürlük varsayılan; kutu kalkınca kullanıcı sabit boyu seçer. -->
                        <Grid x:Name="FixedResolutionRow" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}" IsVisible="False">
                          <SarilanMetin Text="{loc:Text main.fixed-resolution.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <RadioButton x:Name="RbFixedSource" GroupName="ShrinkFixedResolution" IsChecked="True" Content="{loc:Text main.fixed-resolution.source}"/>
                            <RadioButton x:Name="RbFixed1080" GroupName="ShrinkFixedResolution"/>
                            <RadioButton x:Name="RbFixed720" GroupName="ShrinkFixedResolution"/>
                            <RadioButton x:Name="RbFixed480" GroupName="ShrinkFixedResolution"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.min-resolution.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvMinResolution" auto:AutomationProperties.Name="{loc:Text main.advanced.min-resolution.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvMinResolutionNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.min-fps.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvMinFps" auto:AutomationProperties.Name="{loc:Text main.advanced.min-fps.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvMinFpsNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                      </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SecAdvanced">
                      <Button x:Name="BtnAdvancedToggle"
                              Click="OnToggleAdvanced"
                              Theme="{StaticResource GhostButton}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="{StaticResource ButtonPaddingSm}"
                              auto:AutomationProperties.Name="{loc:Text main.advanced.title}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="GlyphAdvanced" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Column="1" Text="{loc:Text main.advanced.title}" Theme="{StaticResource Label}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Row="1" Grid.Column="1" x:Name="TxtAdvancedSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                        </Grid>
                      </Button>
                      <StackPanel x:Name="AdvancedBody" Classes="disclose" Spacing="{StaticResource SpaceMd}" IsVisible="False" Margin="{StaticResource RowMargin}">
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.mode.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <RadioButton x:Name="RbAdvModeAuto" GroupName="AdvMode" IsChecked="True" Content="{loc:Text main.plan.automatic}"/>
                            <RadioButton x:Name="RbAdvModeCrf" GroupName="AdvMode" Content="{loc:Text main.advanced.mode.crf}"/>
                            <RadioButton x:Name="RbAdvModeTwoPass" GroupName="AdvMode" Content="{loc:Text main.advanced.mode.two-pass}"/>
                            <SarilanMetin x:Name="TxtAdvModeNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.crf.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvCrf" auto:AutomationProperties.Name="{loc:Text main.advanced.crf.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvCrfNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.preset.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvPreset" auto:AutomationProperties.Name="{loc:Text main.advanced.preset.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvPresetNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.tune.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvTune" auto:AutomationProperties.Name="{loc:Text main.advanced.tune.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvTuneNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.modulus.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvModulus" auto:AutomationProperties.Name="{loc:Text main.advanced.modulus.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin Text="{loc:Text main.advanced.modulus.hint}" Theme="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.encoder-path.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                            <RadioButton x:Name="RbAdvPathAuto" GroupName="AdvEncoderPath" IsChecked="True" Content="{loc:Text main.plan.automatic}"/>
                            <RadioButton x:Name="RbAdvPathSoftware" GroupName="AdvEncoderPath" Content="{loc:Text main.advanced.encoder-path.software}"/>
                            <RadioButton x:Name="RbAdvPathHardware" GroupName="AdvEncoderPath" Content="{loc:Text main.advanced.encoder-path.hardware}"/>
                            <SarilanMetin x:Name="TxtAdvEncoderPathNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.codec-lock.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <WrapPanel Grid.Row="1" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                            <ComboBox x:Name="CmbAdvCodecLock" auto:AutomationProperties.Name="{loc:Text main.advanced.codec-lock.label}" SelectedIndex="0" VerticalAlignment="Center"/>
                            <SarilanMetin x:Name="TxtAdvCodecLockNow" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                          </WrapPanel>
                        </Grid>
                        <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceSm}">
                          <SarilanMetin Text="{loc:Text main.advanced.filters.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                          <StackPanel Grid.Row="1" Spacing="{StaticResource SpaceSm}">
                            <WrapPanel x:Name="FilterPanel" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
                              <StackPanel Spacing="{StaticResource SpaceXs}">
                                <SarilanMetin Text="{loc:Text main.advanced.filters.deinterlace}" Theme="{StaticResource Hint}"/>
                                <WrapPanel x:Name="FltDeinterlaceGroup" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceXs}">
                                  <RadioButton x:Name="RbFltDeintAuto" GroupName="FltDeinterlace" IsChecked="True"/>
                                  <RadioButton x:Name="RbFltDeintOff" GroupName="FltDeinterlace"/>
                                  <RadioButton x:Name="RbFltDeintOn" GroupName="FltDeinterlace"/>
                                </WrapPanel>
                              </StackPanel>
                              <StackPanel Spacing="{StaticResource SpaceXs}">
                                <SarilanMetin Text="{loc:Text main.advanced.filters.denoise}" Theme="{StaticResource Hint}"/>
                                <WrapPanel x:Name="FltDenoiseGroup" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceXs}">
                                  <RadioButton x:Name="RbFltDenoiseOff" GroupName="FltDenoise" IsChecked="True"/>
                                  <RadioButton x:Name="RbFltDenoiseNlm" GroupName="FltDenoise"/>
                                  <RadioButton x:Name="RbFltDenoiseHq" GroupName="FltDenoise"/>
                                </WrapPanel>
                              </StackPanel>
                              <StackPanel Spacing="{StaticResource SpaceXs}">
                                <SarilanMetin Text="{loc:Text main.advanced.filters.strength}" Theme="{StaticResource Hint}"/>
                                <WrapPanel x:Name="FltStrengthGroup" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceXs}">
                                  <RadioButton x:Name="RbFltStrLight" GroupName="FltStrength"/>
                                  <RadioButton x:Name="RbFltStrMedium" GroupName="FltStrength" IsChecked="True"/>
                                  <RadioButton x:Name="RbFltStrStrong" GroupName="FltStrength"/>
                                </WrapPanel>
                              </StackPanel>
                              <StackPanel Spacing="{StaticResource SpaceXs}">
                                <SarilanMetin Text="{loc:Text main.advanced.filters.sharpen}" Theme="{StaticResource Hint}"/>
                                <ComboBox x:Name="CmbFltSharpen" SelectedIndex="0" auto:AutomationProperties.Name="{loc:Text main.advanced.filters.sharpen}"/>
                              </StackPanel>
                              <StackPanel Spacing="{StaticResource SpaceXs}">
                                <SarilanMetin Text="{loc:Text main.advanced.filters.rotate}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                                <ComboBox x:Name="CmbFltRotate" SelectedIndex="0" auto:AutomationProperties.Name="{loc:Text main.advanced.filters.rotate}"/>
                              </StackPanel>
                              <StackPanel Spacing="{StaticResource SpaceXs}">
                                <SarilanMetin Text="{loc:Text main.advanced.filters.color}" Theme="{StaticResource Hint}"/>
                                <WrapPanel x:Name="FltColorGroup" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceXs}">
                                  <RadioButton x:Name="RbFltColorKeep" GroupName="FltColor" IsChecked="True"/>
                                  <RadioButton x:Name="RbFltColor709" GroupName="FltColor"/>
                                  <RadioButton x:Name="RbFltColor601" GroupName="FltColor"/>
                                </WrapPanel>
                              </StackPanel>
                            </WrapPanel>
                            <izi:SutunIzgara x:Name="FltSwitches" MaxColumns="2" ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceSm}">
                              <CheckBox x:Name="ChkFltDetelecine" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.filters.detelecine}"/>
                              <CheckBox x:Name="ChkFltDeblock" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.filters.deblock}"/>
                              <CheckBox x:Name="ChkFltDeband" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.filters.deband}"/>
                              <CheckBox x:Name="ChkFltGray" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.filters.gray}"/>
                              <CheckBox x:Name="ChkFltAutoCrop" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.filters.autocrop}"/>
                              <CheckBox x:Name="ChkFltManualCrop" Theme="{StaticResource CheckStyle}" Content="{loc:Text main.advanced.filters.manualcrop}">
                                <ToolTip.Tip>
                                  <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.advanced.filters.manualcrop.tip}"/>
                                </ToolTip.Tip>
                              </CheckBox>
                            </izi:SutunIzgara>
                            <StackPanel Spacing="{StaticResource SpaceXs}">
                              <SarilanMetin Text="{loc:Text main.advanced.filters.spec}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                              <TextBox x:Name="TxtAdvFilters" VerticalAlignment="Center"
                                       auto:AutomationProperties.Name="{loc:Text main.advanced.filters.label}"/>
                              <SarilanMetin x:Name="TxtAdvFiltersNow" Theme="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding $self.Text}"/>
                            </StackPanel>
                            <SarilanMetin Text="{loc:Text main.advanced.filters.hint}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Grid>
                        <CheckBox x:Name="ChkAdvMeasureQuality" Theme="{StaticResource CheckStyle}" IsChecked="False" HorizontalAlignment="Left" Content="{loc:Text main.advanced.quality-check.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.advanced.quality-check.tip}"/>
                          </ToolTip.Tip>
                        </CheckBox>
                        <CheckBox x:Name="ChkAdvSearchByMeasure" Theme="{StaticResource CheckStyle}" IsChecked="False" HorizontalAlignment="Left" Content="{loc:Text main.advanced.search-by-measure.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.advanced.search-by-measure.tip}"/>
                          </ToolTip.Tip>
                        </CheckBox>
                        <SarilanMetin x:Name="TxtAdvancedError" Classes="reveal" Theme="{StaticResource Hint}" Foreground="{StaticResource EmberBlaze}" TextWrapping="Wrap" IsVisible="False"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>
            </izi:KucultSutunlari>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="TabConvert" Header="{loc:Text main.tab.convert}" izi:AcilisIsareti.Ad="xaml-donusturme" Tag="{StaticResource IconConvert}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageConvert" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <Grid Margin="{StaticResource PageMargin}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceXl}">

              <Border Grid.Column="0" Theme="{StaticResource Panel}" VerticalAlignment="Top">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <SarilanMetin Text="{loc:Text main.convert.title}" Theme="{StaticResource H2}"/>
                  <SarilanMetin x:Name="TxtConvertSource" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                  <Button x:Name="BtnBrowseConvert" Content="{loc:Text main.convert.browse}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBrowseConvert"/>
                  <Button x:Name="BtnBrowseSequence" Content="{loc:Text main.convert.sequence.browse}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnBrowseSequence"/>
                  <StackPanel Spacing="{StaticResource SpaceXs}">
                    <SarilanMetin Text="{loc:Text main.convert.preset.label}" Theme="{StaticResource Label}"/>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                      <ComboBox x:Name="CmbConvertPreset" HorizontalAlignment="Stretch"
                                PlaceholderText="{loc:Text main.convert.preset.placeholder}"
                                AutomationProperties.Name="{loc:Text main.convert.preset.label}"
                                SelectionChanged="OnConvertPresetChanged"/>
                      <Button x:Name="BtnConvertRepairPreset" Grid.Column="1" Content="{loc:Text main.convert.repair.preset}" Theme="{StaticResource ChipButton}"
                              Click="OnConvertRepairPreset">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.repair.preset.tip}"/>
                        </ToolTip.Tip>
                      </Button>
                      <Button x:Name="BtnConvertPresetAdd" Grid.Column="2" Content="+" Theme="{StaticResource ChipButton}" Classes="eylem"
                              AutomationProperties.Name="{loc:Text main.preset.add.name}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.preset.add.tip}"/>
                        </ToolTip.Tip>
                        <Button.Flyout>
                          <Flyout>
                            <StackPanel Spacing="{StaticResource SpaceSm}" MinWidth="220">
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.preset.name.label}"/>
                              <TextBox x:Name="TxtConvertPresetName" auto:AutomationProperties.Name="{loc:Text main.preset.name.label}" MaxLength="60"/>
                              <SarilanMetin x:Name="TxtConvertPresetNotice" Theme="{StaticResource Hint}"
                                         TextWrapping="Wrap" IsVisible="False"/>
                              <Button x:Name="BtnConvertPresetSave" Content="{loc:Text main.preset.save}" Click="OnConvertPresetSave"/>
                              <Border Theme="{StaticResource PanelRule}"/>
                              <WrapPanel>
                                <Button x:Name="BtnConvertPresetImport" Content="{loc:Text main.preset.import}" Theme="{StaticResource GhostButton}"
                                        Margin="{StaticResource WrapItemMargin}" Click="OnConvertPresetImport"/>
                                <Button x:Name="BtnConvertPresetExport" Content="{loc:Text main.preset.export}" Theme="{StaticResource GhostButton}"
                                        Margin="{StaticResource WrapItemMargin}" Click="OnConvertPresetExport"/>
                              </WrapPanel>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </Grid>
                  </StackPanel>
                  <Grid x:Name="ConvertForm" Grid.IsSharedSizeScope="True" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceLg}"
                        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <Grid.Styles>
                      <Style Selector="Grid#ConvertForm > Grid">
                        <Setter Property="VerticalAlignment" Value="Top"/>
                      </Style>
                    </Grid.Styles>

                    <Grid Grid.Row="0" Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel0"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.container}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.container}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.container.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox Grid.Row="1" x:Name="CmbContainer" auto:AutomationProperties.Name="{loc:Text main.convert.container}" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="MP4" Tag="mp4"/>
                        <ComboBoxItem Content="MKV" Tag="mkv"/>
                        <ComboBoxItem Content="WebM" Tag="webm"/>
                        <ComboBoxItem Content="MOV" Tag="mov"/>
                        <ComboBoxItem Content="AVI" Tag="avi"/>
                        <ComboBoxItem Content="GIF" Tag="gif"/>
                        <ComboBoxItem Content="MP3" Tag="mp3"/>
                        <ComboBoxItem Content="M4A" Tag="m4a"/>
                        <ComboBoxItem Content="WAV" Tag="wav"/>
                        <ComboBoxItem Content="FLAC" Tag="flac"/>
                        <ComboBoxItem Content="WebP" Tag="webp"/>
                        <ComboBoxItem Content="AVIF" Tag="avif"/>
                        <ComboBoxItem Content="MXF" Tag="mxf"/>
                        <ComboBoxItem Content="{loc:Text main.convert.container.png-sequence}" Tag="png"/>
                        <ComboBoxItem Content="{loc:Text main.convert.container.jpg-sequence}" Tag="jpg"/>
                        <ComboBoxItem Content="Opus" Tag="opus"/>
                        <ComboBoxItem Content="OGG" Tag="ogg"/>
                        <ComboBoxItem Content="AIFF" Tag="aiff"/>
                        <ComboBoxItem Content="AC3" Tag="ac3"/>
                        <ComboBoxItem Content="APNG" Tag="apng"/>
                      </ComboBox>
                    </Grid>

                    <Grid Grid.Row="0" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel0"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.video-codec}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.video-codec}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.video-codec.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox Grid.Row="1" x:Name="CmbConvertCodec" auto:AutomationProperties.Name="{loc:Text main.convert.video-codec}" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="H.264" Tag="libx264"/>
                        <ComboBoxItem Content="H.265" Tag="libx265"/>
                        <ComboBoxItem Content="VP9" Tag="libvpx-vp9"/>
                        <ComboBoxItem Content="AV1" Tag="libsvtav1"/>
                        <ComboBoxItem Content="H.264 Nvidia" Tag="h264_nvenc" IsVisible="False"/>
                        <ComboBoxItem Content="H.265 Nvidia" Tag="hevc_nvenc" IsVisible="False"/>
                        <ComboBoxItem Content="AV1 Nvidia" Tag="av1_nvenc" IsVisible="False"/>
                        <ComboBoxItem Content="H.264 Intel" Tag="h264_qsv" IsVisible="False"/>
                        <ComboBoxItem Content="H.265 Intel" Tag="hevc_qsv" IsVisible="False"/>
                        <ComboBoxItem Content="AV1 Intel" Tag="av1_qsv" IsVisible="False"/>
                        <ComboBoxItem Content="H.264 AMD" Tag="h264_amf" IsVisible="False"/>
                        <ComboBoxItem Content="H.265 AMD" Tag="hevc_amf" IsVisible="False"/>
                        <ComboBoxItem Content="AV1 AMD" Tag="av1_amf" IsVisible="False"/>
                        <ComboBoxItem Content="{loc:Text main.convert.copy}" Tag="copy"/>
                        <ComboBoxItem Content="ProRes 422 Proxy" Tag="prores_ks:proxy"/>
                        <ComboBoxItem Content="ProRes 422 LT" Tag="prores_ks:lt"/>
                        <ComboBoxItem Content="ProRes 422" Tag="prores_ks:standard"/>
                        <ComboBoxItem Content="ProRes 422 HQ" Tag="prores_ks:hq"/>
                        <ComboBoxItem Content="ProRes 4444" Tag="prores_ks:4444"/>
                        <ComboBoxItem Content="DNxHR LB" Tag="dnxhd:dnxhr_lb"/>
                        <ComboBoxItem Content="DNxHR SQ" Tag="dnxhd:dnxhr_sq"/>
                        <ComboBoxItem Content="DNxHR HQ" Tag="dnxhd:dnxhr_hq"/>
                        <ComboBoxItem Content="DNxHR HQX" Tag="dnxhd:dnxhr_hqx"/>
                        <ComboBoxItem Content="DNxHR 444" Tag="dnxhd:dnxhr_444"/>
                        <ComboBoxItem Content="FFV1" Tag="ffv1:archive"/>
                        <ComboBoxItem Content="CineForm" Tag="cfhd:film3+"/>
                      </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel1"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.quality-mode}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.quality-mode}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.quality-mode.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox Grid.Row="1" x:Name="CmbQualityMode" auto:AutomationProperties.Name="{loc:Text main.convert.quality-mode}" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{loc:Text main.advanced.mode.crf}"/>
                        <ComboBoxItem Content="{loc:Text main.convert.fixed-bitrate}"/>
                      </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel1"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.crf-label}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.crf-label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.crf-label.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <izi:KaydiriciSatiri Grid.Row="1" x:Name="CrfSliderRow" ColumnDefinitions="*,Auto" EnDarKaydirici="{StaticResource SliderMinWidth}"
                                           ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}">
                        <Slider x:Name="SliderQuality" auto:AutomationProperties.Name="{loc:Text main.convert.crf-label}" Minimum="10" Maximum="45" Value="23" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtQuality" auto:AutomationProperties.Name="{loc:Text main.convert.crf-label}" Text="23" Width="{StaticResource NumberBoxWidth}" TextAlignment="Center" FontWeight="Bold" Foreground="{StaticResource NeonBlue}"/>
                      </izi:KaydiriciSatiri>
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel2"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.resolution}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.resolution}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.resolution.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox Grid.Row="1" x:Name="CmbResolution" auto:AutomationProperties.Name="{loc:Text main.convert.resolution}" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{loc:Text main.convert.source-option}"/>
                        <ComboBoxItem Content="2160" Tag="2160"/>
                        <ComboBoxItem Content="1440" Tag="1440"/>
                        <ComboBoxItem Content="1080" Tag="1080"/>
                        <ComboBoxItem Content="720" Tag="720"/>
                        <ComboBoxItem Content="480" Tag="480"/>
                        <ComboBoxItem Content="{loc:Text main.convert.custom}" Tag="custom"/>
                      </ComboBox>
                    </Grid>

                    <Grid Grid.Row="2" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel2"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.custom-resolution}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.custom-resolution}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.custom-resolution.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <TextBox Grid.Row="1" x:Name="TxtCustomResolution" auto:AutomationProperties.Name="{loc:Text main.convert.custom-resolution}" Text="1280x720"/>
                    </Grid>

                    <Grid Grid.Row="3" Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel3"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.frame-rate}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.frame-rate}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.frame-rate.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox Grid.Row="1" x:Name="CmbConvertFps" auto:AutomationProperties.Name="{loc:Text main.convert.frame-rate}" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="{loc:Text main.convert.source-option}"/>
                        <ComboBoxItem Content="60" Tag="60"/>
                        <ComboBoxItem Content="30" Tag="30"/>
                        <ComboBoxItem Content="24" Tag="24"/>
                        <ComboBoxItem Content="{loc:Text main.convert.custom}" Tag="custom"/>
                      </ComboBox>
                    </Grid>

                    <Grid Grid.Row="3" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel3"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.custom-fps}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.custom-fps}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.custom-fps.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <TextBox Grid.Row="1" x:Name="TxtCustomFps" auto:AutomationProperties.Name="{loc:Text main.convert.custom-fps}" Text="25"/>
                    </Grid>

                    <Grid Grid.Row="4" Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel4"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.audio}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.audio}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.audio.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox Grid.Row="1" x:Name="CmbConvertAudio" auto:AutomationProperties.Name="{loc:Text main.convert.audio}" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="AAC" Tag="aac"/>
                        <ComboBoxItem Content="Opus" Tag="libopus"/>
                        <ComboBoxItem Content="MP3" Tag="libmp3lame"/>
                        <ComboBoxItem Content="PCM" Tag="pcm_s16le"/>
                        <ComboBoxItem Content="FLAC" Tag="flac"/>
                        <ComboBoxItem Content="{loc:Text main.convert.copy}" Tag="copy"/>
                        <ComboBoxItem Content="{loc:Text main.convert.drop}"/>
                        <ComboBoxItem Content="AC3" Tag="ac3"/>
                        <ComboBoxItem Content="E-AC3" Tag="eac3"/>
                      </ComboBox>
                    </Grid>

                    <Grid Grid.Row="4" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel4"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.audio-bitrate}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.audio-bitrate}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.audio-bitrate.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <TextBox Grid.Row="1" x:Name="TxtAudioBitrate" auto:AutomationProperties.Name="{loc:Text main.convert.audio-bitrate}" Text="128"/>
                    </Grid>

                    <Grid Grid.Row="5" Grid.Column="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel5"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.trim-start}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.trim-start}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.trim-start.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <TextBox Grid.Row="1" x:Name="TxtTrimStart" auto:AutomationProperties.Name="{loc:Text main.convert.trim-start}"/>
                    </Grid>

                    <Grid Grid.Row="5" Grid.Column="1">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="ConvertLabel5"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.convert.trim-end}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text main.convert.trim-end}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.trim-end.tip}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <TextBox Grid.Row="1" x:Name="TxtTrimEnd" auto:AutomationProperties.Name="{loc:Text main.convert.trim-end}"/>
                    </Grid>

                    <WrapPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <CheckBox x:Name="ChkConvertDropMetadata" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Center" Content="{loc:Text main.advanced.drop-metadata.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.drop-metadata.tip}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                      <CheckBox x:Name="ChkConvertRepair" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Center" Content="{loc:Text main.convert.repair}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.repair.tip}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                      <Button x:Name="BtnConvertTags" Content="{loc:Text main.convert.tags}" Theme="{StaticResource ChipButton}" VerticalAlignment="Center">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.tags.tip}"/>
                        </ToolTip.Tip>
                        <Button.Flyout>
                          <Flyout>
                            <StackPanel Spacing="{StaticResource SpaceSm}" MinWidth="{StaticResource FieldWidth}">
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.convert.tags.title}"/>
                              <TextBox x:Name="TxtConvertTagTitle" auto:AutomationProperties.Name="{loc:Text main.convert.tags.title}"/>
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.convert.tags.artist}"/>
                              <TextBox x:Name="TxtConvertTagArtist" auto:AutomationProperties.Name="{loc:Text main.convert.tags.artist}"/>
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.convert.tags.year}"/>
                              <TextBox x:Name="TxtConvertTagYear" MaxLength="10" auto:AutomationProperties.Name="{loc:Text main.convert.tags.year}"/>
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.convert.tags.comment}"/>
                              <TextBox x:Name="TxtConvertTagComment" auto:AutomationProperties.Name="{loc:Text main.convert.tags.comment}"/>
                              <SarilanMetin Theme="{StaticResource Label}" Margin="0" Text="{loc:Text main.convert.tags.cover}"/>
                              <SarilanMetin x:Name="TxtConvertCoverName" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text main.convert.tags.cover.none}"/>
                              <WrapPanel>
                                <Button x:Name="BtnConvertCoverPick" Content="{loc:Text main.convert.tags.cover.pick}" Theme="{StaticResource GhostButton}"
                                        Margin="{StaticResource WrapItemMargin}" Click="OnConvertCoverPick">
                                  <ToolTip.Tip>
                                    <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.tags.cover.tip}"/>
                                  </ToolTip.Tip>
                                </Button>
                                <Button x:Name="BtnConvertCoverClear" Content="{loc:Text main.convert.tags.cover.clear}" Theme="{StaticResource GhostButton}"
                                        Margin="{StaticResource WrapItemMargin}" Click="OnConvertCoverClear"/>
                              </WrapPanel>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <Button x:Name="BtnConvertChapters" Content="{loc:Text main.convert.chapters}" Theme="{StaticResource ChipButton}" VerticalAlignment="Center"
                              auto:AutomationProperties.Name="{loc:Text main.convert.chapters}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.chapters.tip}"/>
                        </ToolTip.Tip>
                        <Button.Flyout>
                          <Flyout>
                            <StackPanel Spacing="{StaticResource SpaceSm}" MinWidth="{StaticResource FieldWidth}" MaxWidth="{StaticResource TipMaxWidth}">
                              <SarilanMetin Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text main.convert.chapters.hint}"/>
                              <SarilanMetin x:Name="TxtConvertChaptersEmpty" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text main.convert.chapters.empty}"/>
                              <StackPanel x:Name="ConvertChapterList" Spacing="{StaticResource SpaceXs}"/>
                              <Button x:Name="BtnConvertChapterAdd" Content="{loc:Text main.convert.chapters.add}" Theme="{StaticResource GhostButton}"
                                      HorizontalAlignment="Left" Click="OnConvertChapterAdd"/>
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                    </WrapPanel>

                    <CheckBox x:Name="ChkConvertSingleFrame" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Theme="{StaticResource CheckStyle}" IsChecked="False" IsVisible="False" HorizontalAlignment="Left" Content="{loc:Text main.convert.single-frame}">
                      <ToolTip.Tip>
                        <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.single-frame.tip}"/>
                      </ToolTip.Tip>
                    </CheckBox>

                    <StackPanel x:Name="ConvertAudioVisualPanel" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="False" HorizontalAlignment="Left" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                      <ToolTip.Tip>
                        <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.audio-visual.tip}"/>
                      </ToolTip.Tip>
                      <SarilanMetin Text="{loc:Text main.convert.audio-visual}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                      <ComboBox x:Name="CmbConvertAudioVisual" SelectedIndex="0"
                                auto:AutomationProperties.Name="{loc:Text main.convert.audio-visual}">
                        <ComboBoxItem Content="{loc:Text main.convert.audio-visual.none}" Tag="none"/>
                        <ComboBoxItem Content="{loc:Text main.convert.audio-visual.cover}" Tag="cover"/>
                        <ComboBoxItem Content="{loc:Text main.convert.audio-visual.waveform}" Tag="waveform"/>
                      </ComboBox>
                    </StackPanel>

                    <WrapPanel x:Name="ConvertGifPanel" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" IsVisible="False" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.gif-loop.tip}"/>
                        </ToolTip.Tip>
                        <SarilanMetin Text="{loc:Text main.convert.gif-loop}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertGifLoop" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.gif-loop}">
                          <ComboBoxItem Content="{loc:Text main.convert.gif-loop.infinite}" Tag=""/>
                          <ComboBoxItem Content="{loc:Text main.convert.gif-loop.once}" Tag="-1"/>
                          <ComboBoxItem Content="1" Tag="1"/>
                          <ComboBoxItem Content="2" Tag="2"/>
                          <ComboBoxItem Content="3" Tag="3"/>
                          <ComboBoxItem Content="5" Tag="5"/>
                          <ComboBoxItem Content="10" Tag="10"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.gif-colors.tip}"/>
                        </ToolTip.Tip>
                        <SarilanMetin Text="{loc:Text main.convert.gif-colors}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertGifColors" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.gif-colors}">
                          <ComboBoxItem Content="256" Tag=""/>
                          <ComboBoxItem Content="128" Tag="128"/>
                          <ComboBoxItem Content="64" Tag="64"/>
                          <ComboBoxItem Content="32" Tag="32"/>
                          <ComboBoxItem Content="16" Tag="16"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.gif-dither.tip}"/>
                        </ToolTip.Tip>
                        <SarilanMetin Text="{loc:Text main.convert.gif-dither}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertGifDither" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.gif-dither}">
                          <ComboBoxItem Content="Sierra-2-4A" Tag=""/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.off}" Tag="none"/>
                          <ComboBoxItem Content="Bayer" Tag="bayer"/>
                          <ComboBoxItem Content="Heckbert" Tag="heckbert"/>
                          <ComboBoxItem Content="Floyd-Steinberg" Tag="floyd_steinberg"/>
                          <ComboBoxItem Content="Sierra-2" Tag="sierra2"/>
                          <ComboBoxItem Content="Sierra-3" Tag="sierra3"/>
                          <ComboBoxItem Content="Burkes" Tag="burkes"/>
                          <ComboBoxItem Content="Atkinson" Tag="atkinson"/>
                        </ComboBox>
                      </StackPanel>
                    </WrapPanel>

                  </Grid>
                  <StackPanel x:Name="ConvertFilterPanel" Spacing="{StaticResource SpaceSm}">
                    <WrapPanel ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <Button x:Name="BtnConvertFiltersToggle"
                              Click="OnConvertFiltersToggle"
                              Theme="{StaticResource PanelHeaderToggle}"
                              auto:AutomationProperties.Name="{loc:Text main.advanced.filters.label}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="ConvertFiltersGlyph" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Column="1" Text="{loc:Text main.advanced.filters.label}" Theme="{StaticResource H2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                      </Button>
                      <Button x:Name="BtnConvertEncoderToggle"
                              Click="OnConvertEncoderToggle"
                              Theme="{StaticResource PanelHeaderToggle}"
                              auto:AutomationProperties.Name="{loc:Text main.convert.encoder.label}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                          <Path x:Name="ConvertEncoderGlyph" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                          <SarilanMetin Grid.Column="1" Text="{loc:Text main.convert.encoder.label}" Theme="{StaticResource H2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                      </Button>
                    </WrapPanel>
                    <WrapPanel x:Name="ConvertFilterBody" Classes="disclose" IsVisible="False" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.advanced.filters.deinterlace}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertDeinterlace" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.advanced.filters.deinterlace}">
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.off}" Tag="off"/>
                          <ComboBoxItem Content="{loc:Text main.plan.automatic}" Tag="auto"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.on}" Tag="on"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.advanced.filters.denoise}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertDenoise" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.advanced.filters.denoise}">
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.off}" Tag="off"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.light}" Tag="light"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.medium}" Tag="medium"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.strong}" Tag="strong"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.advanced.filters.rotate}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertRotate" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.advanced.filters.rotate}">
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.off}" Tag="none"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.rotate.clock}" Tag="clock"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.rotate.cclock}" Tag="cclock"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.rotate.180}" Tag="180"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.rotate.hflip}" Tag="hflip"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.rotate.vflip}" Tag="vflip"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.scaler}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertScaler" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.scaler}">
                          <ComboBoxItem Content="Lanczos" Tag="lanczos"/>
                          <ComboBoxItem Content="{loc:Text main.convert.scaler.bicubic}" Tag="bicubic"/>
                          <ComboBoxItem Content="{loc:Text main.convert.scaler.bilinear}" Tag="bilinear"/>
                          <ComboBoxItem Content="Spline" Tag="spline"/>
                          <ComboBoxItem Content="{loc:Text main.convert.scaler.neighbor}" Tag="neighbor"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.fps-mode}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertFpsMode" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.fps-mode}">
                          <ComboBoxItem Content="{loc:Text main.plan.automatic}" Tag="auto"/>
                          <ComboBoxItem Content="{loc:Text main.convert.fps-mode.constant}" Tag="constant"/>
                          <ComboBoxItem Content="{loc:Text main.convert.fps-mode.variable}" Tag="variable"/>
                        </ComboBox>
                      </StackPanel>
                      <CheckBox x:Name="ChkConvertInterpolate" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Center"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.convert.interpolate}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.interpolate.tip}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                      <CheckBox x:Name="ChkConvertAutoCrop" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Center"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.advanced.filters.autocrop}"/>
                      <CheckBox x:Name="ChkConvertLetterbox" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" VerticalAlignment="Center"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.convert.letterbox}"/>
                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <SarilanMetin Text="{loc:Text main.convert.extra-args}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                        <TextBox x:Name="TxtConvertExtraArgs" MinWidth="{StaticResource SliderMinWidth}" MaxWidth="{StaticResource FieldWidth}" FlowDirection="LeftToRight"
                                 auto:AutomationProperties.Name="{loc:Text main.convert.extra-args}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.extra-args.tip}"/>
                          </ToolTip.Tip>
                        </TextBox>
                      </StackPanel>
                    </WrapPanel>
                    <WrapPanel x:Name="ConvertEncoderBody" Classes="disclose" IsVisible="False" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <StackPanel x:Name="ConvertPresetRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.advanced.preset.label}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertSpeed" auto:AutomationProperties.Name="{loc:Text main.advanced.preset.label}"/>
                      </StackPanel>
                      <Grid x:Name="ConvertTuneRow" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.advanced.tune.label}" Theme="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbConvertTune" auto:AutomationProperties.Name="{loc:Text main.advanced.tune.label}"/>
                      </Grid>
                      <StackPanel x:Name="ConvertProfileRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.encoder.profile}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertCodecProfile" auto:AutomationProperties.Name="{loc:Text main.convert.encoder.profile}"/>
                      </StackPanel>
                      <StackPanel x:Name="ConvertLevelRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.encoder.level}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertLevel" auto:AutomationProperties.Name="{loc:Text main.convert.encoder.level}"/>
                      </StackPanel>
                      <CheckBox x:Name="ChkConvertTwoPass" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Center"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.convert.encoder.two-pass}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.convert.encoder.two-pass.tip}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                      <StackPanel x:Name="ConvertHdrRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center" IsVisible="False">
                        <SarilanMetin Text="{loc:Text main.hdr.label}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <RadioButton x:Name="RbConvertHdrPreserve" GroupName="ConvertHdr" IsChecked="True" Content="{loc:Text main.hdr.preserve}"/>
                        <RadioButton x:Name="RbConvertHdrSdr" GroupName="ConvertHdr" Content="{loc:Text main.hdr.sdr}"/>
                      </StackPanel>
                      <StackPanel x:Name="ConvertColorRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.advanced.filters.color}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertColorSpace" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.advanced.filters.color}">
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.color.keep}" Tag="keep"/>
                          <ComboBoxItem Content="BT.601" Tag="bt601"/>
                          <ComboBoxItem Content="BT.709" Tag="bt709"/>
                          <ComboBoxItem Content="BT.2020" Tag="bt2020"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel x:Name="ConvertRangeRow" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.color.range}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertColorRange" SelectedIndex="0"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.color.range}">
                          <ComboBoxItem Content="{loc:Text main.advanced.filters.color.keep}" Tag="keep"/>
                          <ComboBoxItem Content="{loc:Text main.convert.color.range.limited}" Tag="limited"/>
                          <ComboBoxItem Content="{loc:Text main.convert.color.range.full}" Tag="full"/>
                        </ComboBox>
                      </StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceLg}">
                <Border x:Name="ConvertAudioPanel" Theme="{StaticResource Panel}" IsVisible="False">
                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <SarilanMetin Text="{loc:Text main.convert.audio-tracks}" Theme="{StaticResource H2}"/>
                    <SarilanMetin x:Name="TxtConvertAudioHint" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
                    <StackPanel x:Name="ConvertAudioTracks" Spacing="{StaticResource SpaceXs}"/>
                    <SarilanMetin Text="{loc:Text main.audio.external.label}" Theme="{StaticResource Label}" Margin="0"/>
                    <WrapPanel HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <Button x:Name="BtnConvertAudioFile" Theme="{StaticResource GhostButton}" Click="OnConvertAddAudioFile" VerticalAlignment="Bottom"
                              MinHeight="{StaticResource FieldMinHeight}"
                              Padding="{StaticResource ButtonPaddingSm}" Content="{loc:Text main.audio.external.add}"/>
                      <CheckBox x:Name="ChkConvertAudioReplace" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" VerticalAlignment="Bottom"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.audio.external.replace}"/>
                      <CheckBox x:Name="ChkConvertAudioShortest" Theme="{StaticResource CheckStyle}" IsChecked="False" IsEnabled="False" VerticalAlignment="Bottom"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.convert.audio-external.shortest}"/>
                    </WrapPanel>
                    <StackPanel x:Name="ConvertAudioFileList" Spacing="{StaticResource SpaceXs}" IsVisible="False"/>
                    <WrapPanel x:Name="ConvertAudioProcessPanel" HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.audio-channels}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertChannels" SelectedIndex="0" MinWidth="{StaticResource FieldWidthSm}"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.audio-channels}">
                          <ComboBoxItem Content="{loc:Text main.convert.source-option}"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.audio-channels.stereo}" Tag="2"/>
                          <ComboBoxItem Content="{loc:Text main.advanced.audio-channels.mono}" Tag="1"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                        <SarilanMetin Text="{loc:Text main.convert.audio-sample-rate}" Theme="{StaticResource Hint}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbConvertSampleRate" SelectedIndex="0" MinWidth="{StaticResource FieldWidthSm}"
                                  auto:AutomationProperties.Name="{loc:Text main.convert.audio-sample-rate}">
                          <ComboBoxItem Content="{loc:Text main.convert.source-option}"/>
                          <ComboBoxItem Content="44100 Hz" Tag="44100"/>
                          <ComboBoxItem Content="48000 Hz" Tag="48000"/>
                        </ComboBox>
                      </StackPanel>
                      <CheckBox x:Name="ChkConvertLoudnorm" Theme="{StaticResource CheckStyle}" IsChecked="False" VerticalAlignment="Center"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.convert.audio-loudnorm}"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="ConvertSubtitlePanel" Theme="{StaticResource Panel}" IsVisible="False">
                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <SarilanMetin Text="{loc:Text main.convert.subtitles}" Theme="{StaticResource H2}"/>
                    <SarilanMetin x:Name="TxtConvertSubtitleHint" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
                    <StackPanel x:Name="ConvertSubtitleTracks" Spacing="{StaticResource SpaceXs}"/>
                    <Button x:Name="BtnConvertAddSubtitle" Theme="{StaticResource GhostButton}" Click="OnConvertAddSubtitle" HorizontalAlignment="Left"
                            MinHeight="{StaticResource FieldMinHeight}"
                            Padding="{StaticResource ButtonPaddingSm}" Content="{loc:Text main.subtitles.add}"/>
                    <StackPanel x:Name="ConvertSubtitleList" Spacing="{StaticResource SpaceXs}" IsVisible="False"/>
                    <StackPanel Spacing="{StaticResource SpaceXs}" HorizontalAlignment="Left">
                      <SarilanMetin Text="{loc:Text main.subtitles.burn}" Theme="{StaticResource Hint}"/>
                      <ComboBox x:Name="CmbConvertBurn"
                                auto:AutomationProperties.Name="{loc:Text main.subtitles.burn}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <SarilanMetin Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <WrapPanel x:Name="ConvertBurnStylePanel" IsVisible="False" HorizontalAlignment="Left"
                               ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.subtitles.style.font}" Theme="{StaticResource Hint}"/>
                        <ComboBox x:Name="CmbConvertBurnFont"
                                  auto:AutomationProperties.Name="{loc:Text main.subtitles.style.font}"/>
                      </StackPanel>
                      <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.subtitles.style.size}" Theme="{StaticResource Hint}"/>
                        <ComboBox x:Name="CmbConvertBurnSize"
                                  auto:AutomationProperties.Name="{loc:Text main.subtitles.style.size}"/>
                      </StackPanel>
                      <StackPanel Spacing="{StaticResource SpaceXs}" VerticalAlignment="Bottom">
                        <SarilanMetin Text="{loc:Text main.subtitles.style.color}" Theme="{StaticResource Hint}"/>
                        <ComboBox x:Name="CmbConvertBurnColor"
                                  auto:AutomationProperties.Name="{loc:Text main.subtitles.style.color}"/>
                      </StackPanel>
                      <CheckBox x:Name="ChkConvertBurnBox" Theme="{StaticResource CheckStyle}" VerticalAlignment="Bottom"
                                MinHeight="{StaticResource FieldMinHeight}" VerticalContentAlignment="Center"
                                Content="{loc:Text main.subtitles.style.box}"/>
                    </WrapPanel>
                    <SarilanMetin x:Name="TxtConvertSubtitleResult" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"
                               auto:AutomationProperties.LiveSetting="Polite"/>
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <SarilanMetin Text="{loc:Text main.convert.command}" Theme="{StaticResource H2}"/>
                    <TextBox x:Name="TxtConvertCommand" auto:AutomationProperties.Name="{loc:Text main.convert.command}" FlowDirection="LeftToRight" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinLines="2"/>
                    <SarilanMetin x:Name="TxtConvertValidation" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <Border Theme="{StaticResource Panel}">
                  <StackPanel Spacing="{StaticResource SpaceMd}">
                    <SarilanMetin Text="{loc:Text main.convert.progress}" Theme="{StaticResource H2}"/>
                    <ProgressBar x:Name="ConvertProgress" Maximum="1"/>
                    <SarilanMetin x:Name="TxtConvertStage" Text="{loc:Text main.output.idle}" Theme="{StaticResource MonoValue}">
                      <SarilanMetin.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}" Easing="CubicEaseOut"/>
                        </Transitions>
                      </SarilanMetin.Transitions>
                    </SarilanMetin>
                    <SarilanMetin x:Name="TxtConvertResult" Theme="{StaticResource Body}" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <Button x:Name="BtnConvertReveal" Classes="reveal" Content="{loc:Text main.action.show-in-folder}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" IsVisible="False" Click="OnReveal"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" HorizontalAlignment="Right">
                  <Button x:Name="BtnConvertCancel" Content="{loc:Text main.action.cancel}" Theme="{StaticResource GhostButton}" IsEnabled="False" Click="OnCancel">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.cancel.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                  <Button x:Name="BtnConvert" Content="{loc:Text main.action.convert}" Theme="{StaticResource PrimaryButton}" IsEnabled="False" Click="OnConvert">
                    <Button.Styles>
                      <Style Selector="Button:disabled">
                        <Setter Property="ToolTip.Tip" Value="{loc:Text main.action.convert.disabled-tip}"/>
                      </Style>
                    </Button.Styles>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </TabItem>

          <TabItem Header="{loc:Text main.tab.recorder}" izi:AcilisIsareti.Ad="xaml-kaydedici" x:Name="TabRecorder" Tag="{StaticResource IconRecorder}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageRecorder" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
          </ScrollViewer>
        </TabItem>

          <TabItem x:Name="TabAdvanced" IsVisible="False" izi:AcilisIsareti.Ad="xaml-gelismis" Header="{loc:Text main.tab.advanced}" Tag="{StaticResource IconAdvanced}" Theme="{StaticResource NeonTabItem}">
          <ScrollViewer x:Name="PageAdvanced" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <StackPanel Margin="{StaticResource PageMargin}" Spacing="{StaticResource SpaceLg}">

              <Border x:Name="CommandPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <SarilanMetin Grid.Column="0" Text="{loc:Text main.command.title}" Theme="{StaticResource H2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Button Grid.Column="1"
                            x:Name="BtnHideAdvanced"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            Content="{loc:Text main.window.close}"
                            Click="OnHideAdvanced"/>
                  </Grid>
                  <TextBox x:Name="TxtCommand" auto:AutomationProperties.Name="{loc:Text main.command.title}" FlowDirection="LeftToRight" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinLines="1"/>
                </StackPanel>
              </Border>

              <Border x:Name="AiPanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}">
                    <SarilanMetin Grid.Column="0" Text="{loc:Text main.ai.title}" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <SarilanMetin Grid.Row="1"
                               Grid.ColumnSpan="2"
                               x:Name="TxtAiHint"
                               Text="{loc:Text main.ai.tip}"
                               Theme="{StaticResource Hint}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center">
                      <ToolTip.Tip>
                        <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text main.ai.tip}"/>
                      </ToolTip.Tip>
                    </SarilanMetin>
                    <Button Grid.Column="1"
                            x:Name="BtnAiDetails"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            auto:AutomationProperties.Name="{loc:Text main.ai.title}"
                            Click="OnToggleAiDetails">
                              <Path x:Name="GlyphAiDetails" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                  </Grid>
                  <StackPanel x:Name="AiDetails" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}">
                    <SarilanMetin Text="{loc:Text main.ai.tip}" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <WrapPanel>
                      <Button Content="{loc:Text main.ai.copy-prompt}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnCopyPrompt"/>
                      <Button Content="{loc:Text main.ai.apply-json}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" Click="OnApplyJson"/>
                      <Button x:Name="BtnRevert" Content="{loc:Text main.ai.revert}" Theme="{StaticResource GhostButton}" Margin="{StaticResource WrapItemMargin}" IsVisible="False" Click="OnRevertAuto"/>
                    </WrapPanel>
                    <TextBox x:Name="TxtAiJson" auto:AutomationProperties.Name="{loc:Text main.ai.title}" AcceptsReturn="True" TextWrapping="Wrap" MinLines="4" MaxLines="4"/>
                    <SarilanMetin x:Name="TxtAiStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="PerformancePanel" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
                    <SarilanMetin Grid.Column="0" Text="{loc:Text performance.title}" Theme="{StaticResource H2}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            x:Name="BtnPerformanceExpand"
                            Theme="{StaticResource GhostButton}"
                            VerticalAlignment="Center"
                            auto:AutomationProperties.Name="{loc:Text performance.title}"
                            Click="OnTogglePerformance">
                              <Path x:Name="GlyphPerformance" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                            </Button>
                  </Grid>
                  <StackPanel x:Name="PerformanceDetails" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}">
                    <WrapPanel>
                      <Button x:Name="BtnPerformanceRun"
                              Content="{loc:Text performance.run}"
                              Theme="{StaticResource GhostButton}"
                              Margin="{StaticResource WrapItemMargin}"
                              Click="OnRunPerformanceCheck"/>
                    </WrapPanel>
                    <SarilanMetin x:Name="TxtPerformanceStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                    <StackPanel x:Name="PerformanceFacts" Spacing="{StaticResource SpaceMd}"/>
                    <StackPanel x:Name="PerformanceLines" Spacing="{StaticResource SpaceMd}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="{loc:Text main.tab.settings}" izi:AcilisIsareti.Ad="xaml-ayarlar" x:Name="TabSettings" Tag="{StaticResource IconSettings}" Theme="{StaticResource NeonTabItem}">
          <DockPanel x:Name="SettingsPage">
          <SarilanMetin x:Name="TxtSettingsSearchEmpty" DockPanel.Dock="Top" Margin="{StaticResource SectionMargin}" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
          <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False">
            <!--
              Kart duvarı: sütun sayısı genişlikten. Tek sütunlu yığında ayarlar 1080p ekranda beş
              ekran boyundaydı. Dört sütunda her kart kendi sütununda (Sutun), sütunlar ölçülen boylarla
              dengeli; açılan kart yalnız kendi sütununu uzatır. Daha dar pencerede kartlar sırayla en
              kısa sütuna.
            -->
            <izi:KartDuvari x:Name="SettingsCards"
                            Margin="{StaticResource PageMargin}"
                            MinColumnWidth="{StaticResource TipMaxWidth}"
                            ColumnSpacing="{StaticResource SpaceLg}"
                            RowSpacing="{StaticResource SpaceLg}">

              <Border x:Name="GeneralSettingsPanel" izi:KartDuvari.Sutun="0" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <SarilanMetin Text="{loc:Text settings-tab.general.title}" Theme="{StaticResource H2}"/>

                  <!--
                    Kullanıcı 09-07: ayarlar derli toplu olsun, iki seçenekli açılır liste olmasın.
                    Dil ve tema yan yana; çıktı klasörü ve ffmpeg yolu iki seçenekli radyo şeridi.
                  -->
                  <Grid x:Name="LanguageThemeRow" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceLg}">
                    <StackPanel Grid.Column="0" Spacing="{StaticResource SpaceSm}">
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                        <SarilanMetin Text="{loc:Text settings-tab.language.label}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.language.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.language.hint}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox x:Name="CmbLanguage" auto:AutomationProperties.Name="{loc:Text settings-tab.language.label}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <SarilanMetin Text="{Binding}" TextWrapping="Wrap"/>
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <CheckBox x:Name="ChkReduceMotion" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.reduce-motion.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.reduce-motion.hint}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                        <SarilanMetin Text="{loc:Text settings-tab.theme.label}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.theme.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.theme.hint}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox x:Name="CmbTheme" auto:AutomationProperties.Name="{loc:Text settings-tab.theme.label}" HorizontalAlignment="Stretch"/>
                      <Grid x:Name="SystemThemePairRow" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}" RowSpacing="{StaticResource SpaceSm}" IsVisible="False">
                        <SarilanMetin Text="{loc:Text settings-tab.theme.light}" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbThemeLight" auto:AutomationProperties.Name="{loc:Text settings-tab.theme.light}" HorizontalAlignment="Stretch"/>
                        <SarilanMetin Grid.Row="1" Text="{loc:Text settings-tab.theme.dark}" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbThemeDark" auto:AutomationProperties.Name="{loc:Text settings-tab.theme.dark}" HorizontalAlignment="Stretch"/>
                      </Grid>
                      <CheckBox x:Name="ChkFollowSystemTheme" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.follow-system-theme.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.follow-system-theme.hint}"/>
                        </ToolTip.Tip>
                      </CheckBox>
                    </StackPanel>
                  </Grid>

                  <WrapPanel x:Name="TargetTextSizeRow" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                    <StackPanel Spacing="{StaticResource SpaceSm}">
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                        <SarilanMetin Text="{loc:Text settings-tab.default-target.label}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.default-target.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.default-target.hint}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                        <TextBox x:Name="TxtDefaultTargetMb" auto:AutomationProperties.Name="{loc:Text settings-tab.default-target.label}" Width="{StaticResource FieldWidthSm}" TextAlignment="Center"/>
                        <SarilanMetin Text="{loc:Text main.unit.mb}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </StackPanel>
                    <StackPanel MinWidth="{StaticResource FieldWidthSm}" Spacing="{StaticResource SpaceSm}">
                      <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                        <SarilanMetin Text="{loc:Text settings-tab.text-size.label}" Theme="{StaticResource Label}"/>
                        <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.text-size.label}">
                          <ToolTip.Tip>
                            <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.text-size.hint}"/>
                          </ToolTip.Tip>
                        </Button>
                      </Grid>
                      <ComboBox x:Name="CmbTextSize" auto:AutomationProperties.Name="{loc:Text settings-tab.text-size.label}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                  </WrapPanel>

                  <CheckBox x:Name="ChkAdvancedDefaultOpen" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.advanced-default-open.label}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.advanced-default-open.hint}"/>
                    </ToolTip.Tip>
                  </CheckBox>

                  <CheckBox x:Name="ChkFollowRecording" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.follow-recording.label}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.follow-recording.hint}"/>
                    </ToolTip.Tip>
                  </CheckBox>

                  <CheckBox x:Name="ChkNotifyWhenDone" Theme="{StaticResource CheckStyle}" IsChecked="True" HorizontalAlignment="Left" Content="{loc:Text settings-tab.notify-done.label}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.notify-done.hint}"/>
                    </ToolTip.Tip>
                  </CheckBox>

                  <CheckBox x:Name="ChkFinishSound" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.finish-sound.label}">
                    <ToolTip.Tip>
                      <StackPanel Spacing="{StaticResource SpaceSm}">
                        <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.finish-sound.hint}"/>
                        <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.finish-sound-file.hint}"/>
                      </StackPanel>
                    </ToolTip.Tip>
                    <CheckBox.ContextFlyout>
                      <MenuFlyout>
                        <MenuItem x:Name="BtnFinishSoundFile" Click="OnChooseFinishSound"/>
                        <MenuItem x:Name="BtnFinishSoundReset" IsVisible="False" Header="{loc:Text settings-tab.finish-sound-file.reset}" Click="OnResetFinishSound"/>
                      </MenuFlyout>
                    </CheckBox.ContextFlyout>
                  </CheckBox>

                  <CheckBox x:Name="ChkPreventSleep" Theme="{StaticResource CheckStyle}" IsChecked="True" HorizontalAlignment="Left" Content="{loc:Text settings-tab.prevent-sleep.label}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.prevent-sleep.hint}"/>
                    </ToolTip.Tip>
                  </CheckBox>

                  <CheckBox x:Name="ChkMinimizeToTray" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.minimize-to-tray.label}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.minimize-to-tray.hint}"/>
                    </ToolTip.Tip>
                  </CheckBox>

                  <CheckBox x:Name="ChkKeepDates" Theme="{StaticResource CheckStyle}" HorizontalAlignment="Left" Content="{loc:Text settings-tab.keep-dates.label}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.keep-dates.hint}"/>
                    </ToolTip.Tip>
                  </CheckBox>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                      <SarilanMetin Text="{loc:Text settings-tab.ffmpeg-path.label}" Theme="{StaticResource Label}"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.ffmpeg-path.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.ffmpeg-path.hint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <WrapPanel HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <RadioButton x:Name="RbFfmpegAuto" GroupName="FfmpegPathMode" IsChecked="True" Content="{loc:Text settings-tab.ffmpeg-path.auto}"/>
                      <RadioButton x:Name="RbFfmpegManual" GroupName="FfmpegPathMode" Content="{loc:Text settings-tab.ffmpeg-path.manual}"/>
                    </WrapPanel>
                    <Grid x:Name="FfmpegPathPickerRow" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}" IsVisible="False">
                      <TextBox x:Name="TxtFfmpegPath" auto:AutomationProperties.Name="{loc:Text settings-tab.ffmpeg-path.label}"/>
                      <Button Grid.Column="1" x:Name="BtnBrowseFfmpegPath" Content="{loc:Text settings-tab.ffmpeg-path.browse}" Theme="{StaticResource GhostButton}" Click="OnBrowseFfmpegPath"/>
                    </Grid>
                    <SarilanMetin x:Name="TxtFfmpegPathError" Classes="reveal" Theme="{StaticResource Hint}" Foreground="{StaticResource EmberBlaze}" TextWrapping="Wrap" IsVisible="False"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="DiagnosticLogPanel" izi:KartDuvari.Sutun="1" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceSm}">
                  <SarilanMetin Text="{loc:Text settings.log.title}" Theme="{StaticResource H2}"/>
                  <SarilanMetin Text="{loc:Text settings.log.hint}" Theme="{StaticResource Caption}" TextWrapping="Wrap"/>
                  <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
                    <Button x:Name="BtnOpenLog"
                            Content="{loc:Text settings.log.open}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnOpenLog"/>
                    <Button x:Name="BtnReportBug"
                            Content="{loc:Text settings.log.report}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnReportBug"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border x:Name="OutputSettingsPanel" izi:KartDuvari.Sutun="1" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <SarilanMetin Text="{loc:Text main.output.title}" Theme="{StaticResource H2}"/>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <SarilanMetin Text="{loc:Text settings-tab.output-folder.label}" Theme="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Left" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
                      <RadioButton x:Name="RbOutputBesideSource" GroupName="OutputFolderMode" IsChecked="True" Content="{loc:Text settings-tab.output-folder.beside-source}"/>
                      <RadioButton x:Name="RbOutputFixed" GroupName="OutputFolderMode" Content="{loc:Text settings-tab.output-folder.fixed}"/>
                    </WrapPanel>
                    <Grid x:Name="OutputFolderPickerRow" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}" IsVisible="False">
                      <TextBox x:Name="TxtOutputFolder" auto:AutomationProperties.Name="{loc:Text settings-tab.output-folder.label}" IsReadOnly="True"/>
                      <Button Grid.Column="1" x:Name="BtnBrowseOutputFolder" Content="{loc:Text settings-tab.output-folder.browse}" Theme="{StaticResource GhostButton}" Click="OnBrowseOutputFolder"/>
                    </Grid>
                    <SarilanMetin Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.output-folder.hint}"/>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                      <SarilanMetin Text="{loc:Text settings-tab.output-name.label}" Theme="{StaticResource Label}"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.output-name.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.output-name.hint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                      <TextBox x:Name="TxtOutputName" auto:AutomationProperties.Name="{loc:Text settings-tab.output-name.label}" FlowDirection="LeftToRight"/>
                      <Button Grid.Column="1" x:Name="BtnResetOutputName" Content="{loc:Text settings-tab.output-name.reset}" Theme="{StaticResource GhostButton}" Click="OnResetOutputName"/>
                    </Grid>
                    <SarilanMetin x:Name="LblOutputNamePreview" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <SarilanMetin Text="{loc:Text settings-tab.parallel-jobs.label}" Theme="{StaticResource Label}" TextWrapping="Wrap"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.parallel-jobs.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.parallel-jobs.hint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbParallelJobs" auto:AutomationProperties.Name="{loc:Text settings-tab.parallel-jobs.label}" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="{StaticResource FieldWidthSm}"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <SarilanMetin Text="{loc:Text settings-tab.encode-priority.label}" Theme="{StaticResource Label}" TextWrapping="Wrap"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.encode-priority.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.encode-priority.hint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbEncodePriority" auto:AutomationProperties.Name="{loc:Text settings-tab.encode-priority.label}" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="{StaticResource FieldWidthSm}"/>
                    <Grid Grid.Row="2" x:Name="EncoderThreadsRow" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <SarilanMetin Text="{loc:Text settings-tab.encoder-threads.label}" Theme="{StaticResource Label}" TextWrapping="Wrap"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.encoder-threads.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.encoder-threads.hint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbEncoderThreads" auto:AutomationProperties.Name="{loc:Text settings-tab.encoder-threads.label}" IsVisible="{Binding #EncoderThreadsRow.IsVisible}" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="{StaticResource FieldWidthSm}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border x:Name="ShellMenuPanel" izi:KartDuvari.Sutun="2" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <SarilanMetin Text="{loc:Text settings-tab.shell-menu.title}" Theme="{StaticResource H2}"/>
                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <SarilanMetin Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.shell-menu.label}"/>
                    <CheckBox x:Name="ChkShellMenuOpen" Theme="{StaticResource CheckStyle}" Content="{loc:Text shell.menu.open}"/>
                    <CheckBox x:Name="ChkShellMenuShrink" Theme="{StaticResource CheckStyle}" Content="{loc:Text shell.menu.shrink}"/>
                    <SarilanMetin Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.shell-menu.hint}"/>
                    <SarilanMetin x:Name="TxtShellMenuStatus" Classes="reveal" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
                  </StackPanel>
                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Button x:Name="BtnMakeDefaultApp" Content="{loc:Text settings-tab.default-app.button}" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnMakeDefaultApp"/>
                    <SarilanMetin Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.default-app.hint}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="SubtitleSettingsPanel" izi:KartDuvari.Sutun="3" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <SarilanMetin Text="{loc:Text main.subtitles.label}" Theme="{StaticResource H2}"/>
                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                      <SarilanMetin Text="{loc:Text settings-tab.opensubtitles.label}" Theme="{StaticResource Label}"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.label}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.opensubtitles.hint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                      <TextBox x:Name="TxtOpenSubtitlesKey" auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.label}" PasswordChar="*"/>
                      <Button Grid.Column="1" x:Name="BtnOpenSubtitlesKey" Content="{loc:Text settings-tab.opensubtitles.get}" Theme="{StaticResource GhostButton}" Click="OnOpenSubtitlesKeyPage"/>
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                      <SarilanMetin Text="{loc:Text settings-tab.opensubtitles.account}" Theme="{StaticResource Label}"/>
                      <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.account}">
                        <ToolTip.Tip>
                          <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings-tab.opensubtitles.accounthint}"/>
                        </ToolTip.Tip>
                      </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceSm}">
                      <StackPanel Spacing="{StaticResource SpaceXs}">
                        <SarilanMetin Text="{loc:Text settings-tab.opensubtitles.user}" Theme="{StaticResource Label}" Margin="0"/>
                        <TextBox x:Name="TxtOpenSubtitlesUser"
                                 auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.user}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="{StaticResource SpaceXs}">
                        <SarilanMetin Text="{loc:Text settings-tab.opensubtitles.password}" Theme="{StaticResource Label}" Margin="0"/>
                        <TextBox x:Name="TxtOpenSubtitlesPassword" PasswordChar="*"
                                 auto:AutomationProperties.Name="{loc:Text settings-tab.opensubtitles.password}"/>
                      </StackPanel>
                    </Grid>
                    <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
                      <Button x:Name="BtnOpenSubtitlesSignIn" Content="{loc:Text settings-tab.opensubtitles.signin}" Theme="{StaticResource GhostButton}" Click="OnOpenSubtitlesSignIn"/>
                      <Button x:Name="BtnOpenSubtitlesSignOut" Content="{loc:Text settings-tab.opensubtitles.signout}" Theme="{StaticResource GhostButton}" Click="OnOpenSubtitlesSignOut"/>
                    </WrapPanel>
                    <SarilanMetin x:Name="LblOpenSubtitlesStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text settings-tab.opensubtitles.signedout}"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="UpdatePanel" izi:KartDuvari.Sutun="0" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <SarilanMetin Text="{loc:Text settings.update.title}" Theme="{StaticResource H2}"/>
                  <StackPanel x:Name="AutoUpdateRow" Orientation="Horizontal">
                    <CheckBox x:Name="ChkAutoUpdate" Theme="{StaticResource CheckStyle}" Content="{loc:Text settings.update.auto}"/>
                  </StackPanel>
                  <SarilanMetin x:Name="TxtAutoUpdateEffect"
                             Theme="{StaticResource Hint}"
                             TextWrapping="Wrap"
                             Text="{loc:Text settings.update.auto-effect}"/>
                </StackPanel>
              </Border>

              <playback:PlayerAdvancedPanel x:Name="PlayerAdvancedPanel" izi:KartDuvari.Sutun="2"/>

              <editing:EditorShortcutsPanel x:Name="EditorShortcutsPanel" izi:KartDuvari.Sutun="2" IsOpen="False"/>

              <playback:PlayerShortcutsPanel x:Name="PlayerShortcutsPanel" izi:KartDuvari.Sutun="3" IsOpen="False"/>

              <playback:ShellShortcutsPanel x:Name="ShellShortcutsPanel" izi:KartDuvari.Sutun="1" IsOpen="False"/>

              <Border x:Name="AboutPanel" izi:KartDuvari.Sutun="3" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <Button x:Name="BtnAboutToggle"
                          Click="OnAboutToggle"
                          Theme="{StaticResource PanelHeaderToggle}"
                          auto:AutomationProperties.Name="{loc:Text main.about.title}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceSm}">
                      <Path x:Name="AboutGlyph" Classes="chevron" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                      <SarilanMetin Grid.Column="1" Text="{loc:Text main.about.title}" Theme="{StaticResource H2}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                  </Button>
                  <StackPanel x:Name="AboutBody" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceMd}">
                    <WrapPanel x:Name="AboutLinks" ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceXs}">
                      <Button x:Name="BtnUserGuide" Theme="{StaticResource LinkButton}" Content="{loc:Text main.about.guide}" Click="OnOpenUserGuide"/>
                      <Button x:Name="BtnReleaseNotes" Theme="{StaticResource LinkButton}" Content="{loc:Text main.about.notes}" Click="OnOpenReleaseNotes"/>
                      <Button x:Name="BtnLicenses" Theme="{StaticResource LinkButton}" Content="{loc:Text main.about.licenses}" Click="OnOpenLicenses"/>
                      <Button x:Name="BtnPrivacy" Theme="{StaticResource LinkButton}" Content="{loc:Text main.about.privacy}" Click="OnOpenPrivacy"/>
                    </WrapPanel>
                    <SarilanMetin Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.intro}"/>
                    <SarilanMetin Text="{loc:Text main.about.engine.title}" Theme="{StaticResource H3}"/>
                    <SarilanMetin Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.engine.body}"/>
                    <SarilanMetin Text="{loc:Text main.about.measured.title}" Theme="{StaticResource H3}"/>
                    <izi:CiftIzgara x:Name="AboutMeasured" ColumnSpacing="{StaticResource SpaceMd}" RowSpacing="{StaticResource SpaceSm}" loc:Tablo.Text="{loc:Text main.about.measured.table}"/>
                    <SarilanMetin Text="{loc:Text main.about.loss.title}" Theme="{StaticResource H3}"/>
                    <SarilanMetin Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.loss.body}"/>
                    <SarilanMetin Text="{loc:Text main.about.scenario.title}" Theme="{StaticResource H3}"/>
                    <SarilanMetin Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.scenario.body}"/>
                    <SarilanMetin Text="{loc:Text main.about.ai.title}" Theme="{StaticResource H3}"/>
                    <SarilanMetin Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.ai.body}"/>
                    <SarilanMetin Text="{loc:Text main.about.codecs.title}" Theme="{StaticResource H3}"/>
                    <SarilanMetin Theme="{StaticResource BulletText}" loc:Bullets.Text="{loc:Text main.about.codecs.body}"/>
                  </StackPanel>
                  <StackPanel x:Name="AboutStatus" Spacing="{StaticResource SpaceSm}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                      <SarilanMetin Text="{loc:Text main.about.status.title}" Theme="{StaticResource H3}" TextWrapping="Wrap"/>
                      <SarilanMetin Grid.Row="1" x:Name="TxtLastCheck" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      <Button Grid.Column="1" Grid.RowSpan="2" x:Name="BtnCheckNow" Theme="{StaticResource LinkButton}" Content="{loc:Text main.about.check.now}" Click="OnCheckNow" VerticalAlignment="Bottom"/>
                    </Grid>
                    <SarilanMetin x:Name="TxtSystemStatus" Theme="{StaticResource MonoValue}" FontWeight="Normal" TextWrapping="Wrap"
                               Cursor="Hand" PointerPressed="OnSystemStatusTapped"/>
                    <SarilanMetin Text="{loc:Text main.about.platforms.title}" Theme="{StaticResource H3}"/>
                    <SarilanMetin x:Name="TxtPlatforms" Theme="{StaticResource MonoValue}" FontWeight="Normal" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border x:Name="SharePanel" izi:KartDuvari.Sutun="2" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <StackPanel Orientation="Horizontal">
                    <SarilanMetin Text="{loc:Text settings.share.title}" Theme="{StaticResource H2}"/>
                    <Button Theme="{StaticResource InfoButton}" auto:AutomationProperties.Name="{loc:Text settings.share.title}">
                      <ToolTip.Tip>
                        <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text settings.share.tip}"/>
                      </ToolTip.Tip>
                    </Button>
                  </StackPanel>

                  <WrapPanel x:Name="ShareTargetStrip" Orientation="Horizontal" ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}"/>

                  <Grid ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="{StaticResource SpaceMd}"
                        RowSpacing="{StaticResource SpaceSm}">
                    <SarilanMetin Grid.Row="0" Grid.Column="0" Text="{loc:Text settings.share.ceiling}" Theme="{StaticResource PlanFactLabel}"/>
                    <SarilanMetin Grid.Row="0" Grid.Column="1" x:Name="TxtShareCeiling" Theme="{StaticResource PlanFactValue}"/>

                    <SarilanMetin Grid.Row="1" Grid.Column="0" Text="{loc:Text settings.share.lifetime}" Theme="{StaticResource PlanFactLabel}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpaceSm}">
                      <ComboBox x:Name="CmbShareRetention" auto:AutomationProperties.Name="{loc:Text settings.share.lifetime}" HorizontalAlignment="Left"/>
                      <SarilanMetin x:Name="TxtShareRetentionFixed" Theme="{StaticResource PlanFactValue}" IsVisible="False"/>
                    </StackPanel>

                    <SarilanMetin Grid.Row="2" Grid.Column="0" Text="{loc:Text settings.share.deletion}" Theme="{StaticResource PlanFactLabel}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnShareDelete" Grid.Row="2" Grid.Column="1"
                            Content="{loc:Text settings.share.delete}"
                            Theme="{StaticResource GhostButton}"
                            HorizontalAlignment="Left"
                            IsEnabled="False"
                            Click="OnShareDelete">
                      <Button.Styles>
                        <Style Selector="Button:disabled">
                          <Setter Property="ToolTip.Tip" Value="{loc:Text settings.share.delete.disabled-tip}"/>
                        </Style>
                      </Button.Styles>
                    </Button>
                    <SarilanMetin Grid.Row="3" Grid.Column="1" x:Name="TxtShareDeleteNote" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                  </Grid>
                </StackPanel>
              </Border>

              <Border x:Name="ResetSettingsPanel" izi:KartDuvari.Sutun="1" Theme="{StaticResource Panel}">
                <StackPanel Spacing="{StaticResource SpaceMd}">
                  <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
                    <Button x:Name="BtnExportSettings"
                            Content="{loc:Text settings.backup.export}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnExportSettings"/>
                    <Button x:Name="BtnImportSettings"
                            Content="{loc:Text settings.backup.import}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnImportSettings"/>
                    <Button x:Name="BtnResetSettings"
                            Content="{loc:Text settings.reset-all}"
                            Theme="{StaticResource GhostButton}"
                            Click="OnResetSettings"/>
                  </WrapPanel>
                  <SarilanMetin x:Name="TxtSettingsBackup" Theme="{StaticResource Body}" TextWrapping="Wrap"
                             IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                  <StackPanel x:Name="ResetSettingsConfirm" Classes="disclose" IsVisible="False" Spacing="{StaticResource SpaceSm}">
                    <SarilanMetin x:Name="TxtResetSettingsConfirm" Text="{loc:Text settings.reset-confirm}" Theme="{StaticResource Body}" TextWrapping="Wrap"/>
                    <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
                      <Button x:Name="BtnConfirmResetSettings" Content="{loc:Text settings.reset-confirm-button}" Theme="{StaticResource GhostButton}" Click="OnConfirmResetSettings"/>
                      <Button x:Name="BtnCancelResetSettings" Content="{loc:Text settings.reset-cancel}" Theme="{StaticResource GhostButton}" Click="OnCancelResetSettings"/>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>

            </izi:KartDuvari>
          </ScrollViewer>
          </DockPanel>
        </TabItem>



        <izi:UstPanel.Icerik>
          <Border x:Name="TitleBarLayer" izi:AcilisIsareti.Ad="xaml-sekmeler-bitti"
                  VerticalAlignment="Top"
                  Height="{StaticResource TitleBarHeight}">
            <!--
              Sağda boşluk yok: kapatma düğmesi pencerenin sağ kenarına dayanır. Ekranın köşesi
              işaretçiyle vurulması en kolay hedeftir ve fare orada durur; araya konan her piksel
              o kazancı siler. Soldaki 16 px başlık için duruyor.
            -->
            <Grid x:Name="TitleBarContent" Margin="{StaticResource TitleBarContentMargin}" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceXl}">
              <StackPanel Grid.Column="0" x:Name="TitleBrand" Orientation="Horizontal" Spacing="{StaticResource SpaceSm}" VerticalAlignment="Center">
                <Image x:Name="AppLogo" IsHitTestVisible="False" Width="24" Height="24" Stretch="Uniform" IsVisible="False"/>
                <SarilanMetin x:Name="TxtAppName" IsHitTestVisible="False" Theme="{StaticResource AppTitle}" VerticalAlignment="Center">
                  <Run Text="Vid"/><Run Text="Shrink" Foreground="{StaticResource PinkText}"/><Run Text=" Player"/>
                </SarilanMetin>
                <Button x:Name="BtnVersion" Theme="{StaticResource TitleBarVersionButton}"
                        auto:AutomationProperties.Name="{loc:Etiket update.check}"
                        ToolTip.Tip="{loc:Etiket update.check}" Click="OnVersionClicked"/>
              </StackPanel>
              <StackPanel Grid.Column="2" x:Name="TitleBarRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <TextBox x:Name="TxtSettingsSearch"
                         IsVisible="False"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         MinHeight="0"
                         FontSize="{StaticResource TitleBarSearchFontSize}"
                         Padding="{StaticResource HeaderButtonPadding}"
                         Width="{StaticResource TitleBarSearchWidth}"
                         Margin="{StaticResource WindowButtonMargin}"
                         PlaceholderText="{loc:Text settings.search.placeholder}"
                         auto:AutomationProperties.Name="{loc:Text settings.search.placeholder}"/>
                <Button x:Name="BtnUpdateBadge" Theme="{StaticResource TitleBarLinkButton}" IsVisible="False"
                        auto:AutomationProperties.Name="{loc:Text main.update.badge}"
                        ToolTip.Tip="{loc:Text main.update.checking}" Click="OnUpdateBadgeClicked">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <Ellipse x:Name="UpdateBadgeDot" Width="{StaticResource BadgeDotSize}" Height="{StaticResource BadgeDotSize}"
                             VerticalAlignment="Center" Fill="{StaticResource TextDisabled}"/>
                    <SarilanMetin x:Name="TxtUpdateBadge" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource WindowButtonMargin}">
                  <StackPanel x:Name="LangSwitch" Orientation="Horizontal"/>
                </StackPanel>
                <Button x:Name="BtnSponsor" Theme="{StaticResource TitleBarSupportButton}" auto:AutomationProperties.Name="{loc:Etiket sig.support}" ToolTip.Tip="{loc:Etiket sig.supportTitle}" Click="OnOpenSponsor">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
                    <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform" VerticalAlignment="Center"
                          Data="{StaticResource IconCoffee}" Fill="{Binding $parent[Button].Foreground}"/>
                    <SarilanMetin x:Name="TxtSponsor" Text="{loc:Etiket sig.support}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnGitHub" Theme="{StaticResource TitleBarLinkButton}" auto:AutomationProperties.Name="{loc:Etiket sig.brand}" ToolTip.Tip="{loc:Etiket sig.brandTitle}" Click="OnOpenGitHub">
                  <SarilanMetin x:Name="TxtGitHub" Text="{loc:Etiket sig.brand}" VerticalAlignment="Center"/>
                </Button>
                <!--
                  Üç düğme Windows'taki gibi bitişik dikdörtgen: aralarında boşluk yok, başlık
                  çubuğu boyunca tam yükseklikte. Soldaki tek boşluk imza bloğundan ayırmak için.
                -->
                <StackPanel x:Name="WindowButtons" Orientation="Horizontal" VerticalAlignment="Stretch"
                            Margin="{StaticResource WindowButtonMargin}">
                  <Button x:Name="BtnMinimize" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="{loc:Text main.window.minimize}" auto:AutomationProperties.Name="{loc:Text main.window.minimize}" Click="OnMinimize">
                    <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform"
                          Data="{StaticResource IconMinimize}" Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                  <Button x:Name="BtnMaximize" Theme="{StaticResource WindowControlButton}" ToolTip.Tip="{loc:Text main.window.maximize}" auto:AutomationProperties.Name="{loc:Text main.window.maximize}" Click="OnMaximizeRestore">
                    <Path x:Name="MaximizeGlyph" Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform"
                          Data="{StaticResource IconMaximize}" Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                  <Button x:Name="BtnClose" Theme="{StaticResource CloseWindowButton}" ToolTip.Tip="{loc:Text main.window.close}" auto:AutomationProperties.Name="{loc:Text main.window.close}" Click="OnClose">
                    <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}" Stretch="Uniform"
                          Data="{StaticResource IconClose}" Fill="{Binding $parent[Button].Foreground}"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </izi:UstPanel.Icerik>
      </TabControl>

      <Border x:Name="VersionToast" Theme="{StaticResource Panel}"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="{StaticResource VersionToastMargin}" MaxWidth="{StaticResource ToastMaxWidth}"
              IsVisible="False" IsHitTestVisible="False"
              auto:AutomationProperties.LiveSetting="Polite">
        <SarilanMetin x:Name="TxtVersionToast" Theme="{StaticResource Body}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
      </Border>
    </Grid>
  </Border>
</Window>
