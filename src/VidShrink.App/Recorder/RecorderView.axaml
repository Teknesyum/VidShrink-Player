<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:izi="using:VidShrink.App"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             xmlns:share="using:VidShrink.App.Share"
             x:Class="VidShrink.App.Recorder.RecorderView"
             auto:AutomationProperties.Name="{loc:Text recorder.pane.title}">

  <!--
    Sayfa başlığı yok: sekmenin adı zaten "Kaydedici". Kartlar üç sütunda; Basit kipte
    hedef, ses ve kamera yan yana, Gelişmiş kipte ilk sütun o üçü alt alta taşır, öteki
    iki sütuna seçenekler ve gelişmiş ayarlar gelir. Kart taban boyu yok: içeriği kadar.
  -->
  <StackPanel Spacing="{StaticResource SpaceMd}">

    <StackPanel x:Name="RowLevel" Orientation="Horizontal" Spacing="{StaticResource SpaceLg}">
      <StackPanel.Styles>
        <Style Selector="Button#BtnHotkeys:pointerover, Button#BtnHistory:pointerover, Button#BtnPrompter:pointerover">
          <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
        </Style>
      </StackPanel.Styles>
      <RadioButton x:Name="RadSimple"
                   GroupName="RecorderLevel"
                   Content="{loc:Text recorder.level.simple}"
                   ToolTip.Tip="{loc:Text recorder.level.simple-hint}"
                   auto:AutomationProperties.Name="{loc:Text recorder.level.simple}"/>
      <RadioButton x:Name="RadAdvanced"
                   GroupName="RecorderLevel"
                   Content="{loc:Text recorder.level.advanced}"
                   ToolTip.Tip="{loc:Text recorder.level.advanced-hint}"
                   auto:AutomationProperties.Name="{loc:Text recorder.level.advanced}"/>
      <Button x:Name="BtnHotkeys"
              VerticalAlignment="Center"
              Theme="{StaticResource GhostButton}"
              Padding="{StaticResource HeaderButtonPadding}"
              IsVisible="{Binding #RadAdvanced.IsChecked}"
              Content="{loc:Text recorder.hotkeys.title}"
              auto:AutomationProperties.Name="{loc:Text recorder.hotkeys.title}"/>
      <Button x:Name="BtnHistory"
              VerticalAlignment="Center"
              Theme="{StaticResource GhostButton}"
              Padding="{StaticResource HeaderButtonPadding}"
              Content="{loc:Text recorder.history.title}"
              auto:AutomationProperties.Name="{loc:Text recorder.history.title}"/>
      <Button x:Name="BtnPrompter"
              VerticalAlignment="Center"
              Theme="{StaticResource GhostButton}"
              Padding="{StaticResource HeaderButtonPadding}"
              Content="{loc:Text recorder.prompter.title}"
              ToolTip.Tip="{loc:Text recorder.prompter.open}"
              auto:AutomationProperties.Name="{loc:Text recorder.prompter.open}"/>
    </StackPanel>

    <!--
      Denetim şeridi. Şeridin okuduğu iki sayı geçen süre ve kare sayısıdır; yazılan
      boyut kayıt sürerken akmıyor (gdigrab yakalamasında total_size son bloğa kadar
      sıfır kalıyor), o yüzden boyut ancak kayıt bitince sonuçtan geliyor. Sebebi
      okumanın ipucunda yazılı.

      Düğmeler duruma göre IsEnabled değil IsVisible ile sürülüyor: devre dışı düğme
      kendi başına bir açıklama borcu doğuruyor, görünmeyen düğme doğurmuyor.
    -->
    <Border x:Name="Strip"
            Theme="{StaticResource Panel}"
            Padding="{StaticResource RecorderStripPadding}"
            auto:AutomationProperties.Name="{loc:Text recorder.strip.title}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto"
            ColumnSpacing="{StaticResource RecorderStripGap}">

        <Ellipse Grid.Column="0"
                 x:Name="LiveDot"
                 Width="{StaticResource RecorderDotSize}"
                 Height="{StaticResource RecorderDotSize}"
                 Fill="{StaticResource NeonEmber}"
                 IsVisible="False"
                 VerticalAlignment="Center"/>

        <SarilanMetin Grid.Column="1"
                   x:Name="TxtState"
                   Theme="{StaticResource MonoValue}"
                   VerticalAlignment="Center"/>

        <izi:SutunIzgara Grid.Column="2"
              x:Name="StripStats"
              Margin="{StaticResource RecorderStatsInset}"
              MaxColumns="3"
              Fill="False"
              HorizontalAlignment="Left"
              ColumnSpacing="{StaticResource SpaceXl}"
              RowSpacing="{StaticResource SpaceSm}"
              VerticalAlignment="Center"
              ToolTip.Tip="{loc:Text recorder.strip.size-hint}">

          <StackPanel>
            <SarilanMetin Text="{loc:Text recorder.strip.elapsed}" Theme="{StaticResource PlanFactLabel}" MinWidth="0" TextWrapping="Wrap"/>
            <SarilanMetin x:Name="TxtElapsed" Theme="{StaticResource PlanFactValue}"/>
          </StackPanel>

          <StackPanel x:Name="StatFrames">
            <SarilanMetin Text="{loc:Text recorder.strip.frames}" Theme="{StaticResource PlanFactLabel}" MinWidth="0" TextWrapping="Wrap"/>
            <SarilanMetin x:Name="TxtFrames" Theme="{StaticResource PlanFactValue}"/>
          </StackPanel>

          <StackPanel x:Name="StatDropped">
            <SarilanMetin Text="{loc:Text recorder.strip.dropped}" Theme="{StaticResource PlanFactLabel}" MinWidth="0" TextWrapping="Wrap"/>
            <SarilanMetin x:Name="TxtDropped" Theme="{StaticResource PlanFactValue}"/>
          </StackPanel>
        </izi:SutunIzgara>

        <Button Grid.Column="3"
                x:Name="BtnStart"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource PrimaryButton}"
                Content="{loc:Text recorder.strip.start}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.start}"
                Click="OnStart"/>

        <Button Grid.Column="3"
                x:Name="BtnCountdownCancel"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.countdown.cancel}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.countdown.cancel}"
                Click="OnCountdownCancel"/>

        <Button Grid.Column="4"
                x:Name="BtnAutoWizard"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.wizard.open}"
                ToolTip.Tip="{loc:Text recorder.wizard.open-hint}"
                auto:AutomationProperties.Name="{loc:Text recorder.wizard.open}"
                Click="OnWizardOpen"/>

        <Button Grid.Column="4"
                x:Name="BtnPause"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.strip.pause}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.pause}"
                Click="OnPause"/>

        <Button Grid.Column="5"
                x:Name="BtnResume"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.strip.resume}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.resume}"
                Click="OnResume"/>

        <Button Grid.Column="6"
                x:Name="BtnSnapshot"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.strip.snapshot}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.snapshot}"
                Click="OnSnapshot"/>

        <Button Grid.Column="7"
                x:Name="BtnStop"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource PrimaryButton}"
                Content="{loc:Text recorder.strip.stop}"
                IsVisible="False"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.stop}"
                Click="OnStop"/>

        <!-- Geçiş ayar kutusunda değil şeritte: bulunamayan bir kip hiç kullanılmıyor. -->
        <Button Grid.Column="8"
                x:Name="BtnMini"
                MinHeight="{StaticResource RecorderButtonSize}"
                VerticalAlignment="Center"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource AccentButton}"
                auto:AutomationProperties.Name="{loc:Text recorder.mini.offer}"
                ToolTip.Tip="{loc:Text recorder.mini.shrink}">
          <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceSm}">
            <Path Width="{StaticResource IconSizeLg}"
                  Height="{StaticResource IconSizeLg}"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Data="{StaticResource IconRestore}"
                  Fill="{StaticResource NeonBlue}"/>
            <SarilanMetin Text="{loc:Text recorder.mini.offer}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Image x:Name="ImgPreview"
           Width="{StaticResource RecorderPreviewWidth}"
           Stretch="Uniform"
           HorizontalAlignment="Left"
           IsVisible="False"
           auto:AutomationProperties.Name="{loc:Text recorder.strip.preview}"/>

    <!-- Kayıt bittiğinde teslim edilen dosya. Yol her zaman görünür; yarım dosya da
         gizlenmiyor, kendi satırıyla bildiriliyor. -->
    <Border x:Name="ResultPanel" Classes="reveal-panel" Theme="{StaticResource Panel}" IsVisible="False">
      <StackPanel Spacing="{StaticResource SpaceMd}">
        <SarilanMetin x:Name="TxtResult" Theme="{StaticResource StatusSuccess}" TextWrapping="Wrap"/>
        <TextBox x:Name="TxtResultPath"
                 IsReadOnly="True"
                 FontFamily="{StaticResource FontMono}"
                 auto:AutomationProperties.Name="{loc:Text recorder.output.title}"/>
        <Grid x:Name="WarningRow" Classes="reveal" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceXs}" IsVisible="False">
          <Path x:Name="WarningGlyph"
                Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
                Stretch="Uniform" VerticalAlignment="Top"
                Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
          <SarilanMetin x:Name="TxtWarning" Grid.Column="1"
                     Theme="{StaticResource StatusWarning}"
                     TextWrapping="Wrap"/>
        </Grid>
        <WrapPanel>
          <Button x:Name="BtnToShrink"
                  Theme="{StaticResource PrimaryButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.to-shrink}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-shrink}"
                  Click="OnToShrink"/>
          <Button x:Name="BtnReveal"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.reveal}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.reveal}"
                  Click="OnReveal"/>
          <Button x:Name="BtnCopyFile"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.copy-file}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.copy-file}"
                  Click="OnCopyFile"/>
          <Button x:Name="BtnToPlayer"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text recorder.output.to-player}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-player}"
                  Click="OnToPlayer"/>
          <Button x:Name="BtnToEditor"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsEnabled="{Binding #BtnToPlayer.IsEnabled}"
                  Content="{loc:Text recorder.output.to-editor}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.to-editor}"
                  Click="OnToEditor"/>
          <Button x:Name="BtnResultMore"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text recorder.output.more}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.more}">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem x:Name="BtnToMp4"
                          IsVisible="False"
                          Header="{loc:Text recorder.output.to-mp4}"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.to-mp4}"
                          Click="OnToMp4"/>
                <MenuItem x:Name="BtnToGif"
                          IsVisible="False"
                          Header="{loc:Text recorder.output.to-gif}"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.to-gif}"
                          Click="OnToGif"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="BtnTrimIdle"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text recorder.output.trim-idle}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.trim-idle}"
                  Click="OnTrimIdle"/>
          <Button x:Name="BtnQuickTrim"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text recorder.output.quick-trim}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.quick-trim}">
            <ToolTip.Tip>
              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text recorder.output.quick-trim.tip}"/>
            </ToolTip.Tip>
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="{StaticResource SpaceSm}" Width="{StaticResource RecorderQuickTrimWidth}">
                  <UniformGrid x:Name="QuickTrimStrip" Rows="1" Height="{StaticResource RecorderQuickTrimThumbHeight}"/>
                  <SarilanMetin Text="{loc:Text recorder.output.quick-trim-start}" Theme="{StaticResource Label}"/>
                  <Slider x:Name="SldTrimStart" Minimum="0" Maximum="1" IsSnapToTickEnabled="True"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.quick-trim-start}"/>
                  <SarilanMetin Text="{loc:Text recorder.output.quick-trim-end}" Theme="{StaticResource Label}"/>
                  <Slider x:Name="SldTrimEnd" Minimum="0" Maximum="1" Value="1"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.quick-trim-end}"/>
                  <SarilanMetin x:Name="TxtTrimRange" TextWrapping="Wrap"/>
                  <Button x:Name="BtnTrimCut"
                          Theme="{StaticResource PrimaryButton}"
                          IsEnabled="False"
                          Content="{loc:Text recorder.output.quick-trim-cut}"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.quick-trim-cut}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="BtnAutoZoom"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text recorder.output.zoom}"
                  auto:AutomationProperties.Name="{loc:Text recorder.output.zoom}">
            <Button.Flyout>
              <Flyout>
                <StackPanel Spacing="{StaticResource SpaceSm}" Width="{StaticResource RecorderQuickTrimWidth}">
                  <SarilanMetin Text="{loc:Text recorder.output.zoom-level}" Theme="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbZoomLevel"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.output.zoom-level}"/>
                  <SarilanMetin Text="{loc:Text recorder.output.zoom-regions}" Theme="{StaticResource Label}"/>
                  <ScrollViewer MaxHeight="{StaticResource DropDownMaxHeight}">
                    <StackPanel x:Name="ZoomRegionList" Spacing="{StaticResource SpaceXs}"/>
                  </ScrollViewer>
                  <SarilanMetin x:Name="TxtZoomEmpty"
                                IsVisible="False"
                                TextWrapping="Wrap"
                                Theme="{StaticResource Hint}"
                                Text="{loc:Text recorder.output.zoom-none}"/>
                  <Button x:Name="BtnZoomApply"
                          Theme="{StaticResource PrimaryButton}"
                          IsEnabled="False"
                          Content="{loc:Text recorder.output.zoom-apply}"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.zoom-apply}"/>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
          <ComboBox x:Name="CmbRecShareTarget"
                    Margin="{StaticResource WrapItemMargin}"
                    VerticalAlignment="Center"
                    auto:AutomationProperties.Name="{loc:Text settings.share.title}"/>
          <ComboBox x:Name="CmbRecShareRetention"
                    Margin="{StaticResource WrapItemMargin}"
                    VerticalAlignment="Center"
                    auto:AutomationProperties.Name="{loc:Text settings.share.lifetime}"/>
          <SarilanMetin x:Name="TxtRecShareRetentionFixed"
                        Margin="{StaticResource WrapItemMargin}"
                        VerticalAlignment="Center"
                        Theme="{StaticResource Hint}"
                        IsVisible="False"/>
          <Button x:Name="BtnRecShare"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  Content="{loc:Text main.action.share}"
                  auto:AutomationProperties.Name="{loc:Text main.action.share}"
                  Click="OnShare"/>
          <Button x:Name="BtnRecShareCancel"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"
                  Content="{loc:Text main.action.cancel-upload}"
                  auto:AutomationProperties.Name="{loc:Text main.action.cancel-upload}"
                  Click="OnShareCancel"/>
          <Button x:Name="BtnRecShareRetry"
                  auto:AutomationProperties.Name="{loc:Text settings.share.retry}"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsVisible="False"/>
          <Button x:Name="BtnRecShareDelete"
                  Theme="{StaticResource GhostButton}"
                  Margin="{StaticResource WrapItemMargin}"
                  IsEnabled="False"
                  Content="{loc:Text settings.share.delete}"
                  auto:AutomationProperties.Name="{loc:Text settings.share.delete}"
                  Click="OnShareDelete">
            <Button.Styles>
              <Style Selector="Button:disabled">
                <Setter Property="ToolTip.Tip" Value="{loc:Text settings.share.delete.disabled-tip}"/>
              </Style>
            </Button.Styles>
          </Button>
        </WrapPanel>

        <ProgressBar x:Name="RecShareProgress" Maximum="1" IsVisible="False"/>

        <Grid x:Name="RecShareLinkRow"
              IsVisible="False"
              ColumnDefinitions="*,Auto"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="{StaticResource SpaceMd}"
              RowSpacing="{StaticResource SpaceMd}">
          <TextBox Grid.Column="0"
                   x:Name="TxtRecShareLink"
                   auto:AutomationProperties.Name="{loc:Text main.share.link}"
                   IsReadOnly="True"
                   FontFamily="{StaticResource FontMono}"
                   VerticalAlignment="Center"/>
          <Button Grid.Column="1"
                  x:Name="BtnRecShareCopy"
                  Theme="{StaticResource GhostButton}"
                  VerticalAlignment="Center"
                  Content="{loc:Text main.action.copy}"
                  auto:AutomationProperties.Name="{loc:Text main.action.copy}"
                  Click="OnCopyShareLink"/>
          <Grid Grid.Row="1"
                Grid.ColumnSpan="2"
                RowDefinitions="Auto,Auto"
                RowSpacing="{StaticResource SpaceSm}"
                IsVisible="{Binding #QrRecShare.IsVisible}">
            <share:ShareQrCode HorizontalAlignment="Left"
                               x:Name="QrRecShare"
                               Link="{Binding #TxtRecShareLink.Text}"
                               ModuleSize="{StaticResource ShareQrModuleSize}"
                               auto:AutomationProperties.Name="{loc:Text main.share.qr}"
                               auto:AutomationProperties.HelpText="{loc:Text main.share.qr-hint}"/>
            <SarilanMetin Grid.Row="1"
                       Theme="{StaticResource Hint}"
                       Text="{loc:Text main.share.qr-hint}"
                       TextWrapping="Wrap"/>
          </Grid>
        </Grid>

        <SarilanMetin x:Name="TxtRecShareStatus" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>

        <SarilanMetin x:Name="TxtFinishStatus"
                   Theme="{StaticResource StatusSuccess}"
                   TextWrapping="Wrap"
                   IsVisible="False"/>
      </StackPanel>
    </Border>

    <SarilanMetin x:Name="TxtError" Classes="reveal"
               Theme="{StaticResource StatusError}"
               TextWrapping="Wrap"
               IsVisible="False"/>

    <SarilanMetin x:Name="TxtNotice" Classes="reveal"
               Theme="{StaticResource StatusSuccess}"
               TextWrapping="Wrap"
               IsVisible="False"/>

    <Grid x:Name="DiskRow" Classes="reveal" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceXs}" IsVisible="False">
      <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
            Stretch="Uniform" VerticalAlignment="Top"
            Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
      <SarilanMetin x:Name="TxtDisk" Grid.Column="1"
                 Theme="{StaticResource StatusWarning}"
                 TextWrapping="Wrap"/>
    </Grid>

    <Border x:Name="RecoverPanel" Classes="reveal-panel" Theme="{StaticResource Panel}" IsVisible="False">
      <Grid x:Name="RecoverRow" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpaceXs}">
        <Path Width="{StaticResource IconSizeSm}" Height="{StaticResource IconSizeSm}"
              Stretch="Uniform" VerticalAlignment="Center"
              Data="{StaticResource IconWarning}" Fill="{StaticResource TextBody}"/>
        <SarilanMetin x:Name="TxtRecover" Grid.Column="1"
                   Theme="{StaticResource StatusWarning}"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button x:Name="BtnRecover" Grid.Column="2"
                Theme="{StaticResource GhostButton}"
                Content="{loc:Text recorder.recover.action}"
                auto:AutomationProperties.Name="{loc:Text recorder.recover.action}"
                Click="OnRecover"/>
      </Grid>
    </Border>

    <SarilanMetin x:Name="TxtWizardSummary"
               Theme="{StaticResource Hint}"
               TextWrapping="Wrap"
               IsVisible="False"/>

    <Border x:Name="PanelWizard"
            Theme="{StaticResource Panel}"
            HorizontalAlignment="Left"
            IsVisible="False"
            auto:AutomationProperties.Name="{loc:Text recorder.wizard.open}">
      <StackPanel Spacing="{StaticResource SpaceMd}">
        <SarilanMetin x:Name="TxtWizardStep" Theme="{StaticResource Hint}"/>
        <SarilanMetin x:Name="TxtWizardQuestion" Theme="{StaticResource H2}" TextWrapping="Wrap"/>

        <WrapPanel x:Name="RowWizardOptions"
                   ItemSpacing="{StaticResource SpaceMd}"
                   LineSpacing="{StaticResource SpaceMd}">
          <Button x:Name="BtnWizardOpt0"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="0"
                  Click="OnWizardOption"
                  auto:AutomationProperties.Name="{Binding #TxtWizardOpt0.Text}">
            <SarilanMetin x:Name="TxtWizardOpt0" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button x:Name="BtnWizardOpt1"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="1"
                  Click="OnWizardOption"
                  auto:AutomationProperties.Name="{Binding #TxtWizardOpt1.Text}">
            <SarilanMetin x:Name="TxtWizardOpt1" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button x:Name="BtnWizardOpt2"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="2"
                  Click="OnWizardOption"
                  auto:AutomationProperties.Name="{Binding #TxtWizardOpt2.Text}">
            <SarilanMetin x:Name="TxtWizardOpt2" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
          <Button x:Name="BtnWizardOpt3"
                  Theme="{StaticResource GhostButton}"
                  Width="{StaticResource RecorderWizardOptionSize}"
                  Height="{StaticResource RecorderWizardOptionSize}"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Tag="3"
                  Click="OnWizardOption"
                  auto:AutomationProperties.Name="{Binding #TxtWizardOpt3.Text}">
            <SarilanMetin x:Name="TxtWizardOpt3" TextWrapping="Wrap" TextAlignment="Center"/>
          </Button>
        </WrapPanel>

        <WrapPanel ItemSpacing="{StaticResource SpaceSm}" LineSpacing="{StaticResource SpaceSm}">
          <Button x:Name="BtnWizardSame"
                  Theme="{StaticResource PrimaryButton}"
                  IsVisible="False"
                  Click="OnWizardSame"
                  auto:AutomationProperties.Name="{loc:Text recorder.wizard.same}"/>
          <Button x:Name="BtnWizardCancel"
                  Theme="{StaticResource GhostButton}"
                  Content="{loc:Text recorder.wizard.cancel}"
                  auto:AutomationProperties.Name="{loc:Text recorder.wizard.cancel}"
                  Click="OnWizardCancel"/>
        </WrapPanel>
      </StackPanel>
    </Border>


    <izi:KartDuvari x:Name="RecorderCards"
                    MinColumnWidth="{StaticResource FieldWidth}"
                    ColumnSpacing="{StaticResource SpaceMd}"
                    RowSpacing="{StaticResource SpaceMd}">

      <StackPanel x:Name="CardsLeft" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelTarget" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <SarilanMetin Text="{loc:Text recorder.target.title}" Theme="{StaticResource H2}"/>

            <Grid x:Name="RowTargetQuick" ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpaceSm}">
              <Button x:Name="BtnQuickScreen"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.target.screen}"
                      auto:AutomationProperties.Name="{loc:Text recorder.target.screen}"/>
              <Button x:Name="BtnQuickWindow" Grid.Column="1"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.target.window}"
                      auto:AutomationProperties.Name="{loc:Text recorder.target.window}"/>
              <Button x:Name="BtnQuickRegion" Grid.Column="2"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.target.region}"
                      auto:AutomationProperties.Name="{loc:Text recorder.target.region}"/>
            </Grid>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel x:Name="RowTargetKind">
                <SarilanMetin Text="{loc:Text recorder.target.what}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbTarget"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.what}"/>
              </StackPanel>

              <StackPanel x:Name="RowScreen" IsVisible="False">
                <SarilanMetin Text="{loc:Text recorder.target.screen-pick}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbScreen"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.screen-pick}"/>
              </StackPanel>

              <StackPanel x:Name="RowDevice" IsVisible="False">
                <SarilanMetin Text="{loc:Text recorder.target.device-pick}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbDevice"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.device-pick}"/>
              </StackPanel>

              <StackPanel x:Name="RowDeviceMode" IsVisible="False">
                <SarilanMetin Text="{loc:Text recorder.target.device-mode}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbDeviceMode"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.device-mode}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <StackPanel x:Name="RowWindow" IsVisible="False" Spacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.target.window-pick}" Theme="{StaticResource Label}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                  <ComboBox x:Name="CmbWindow"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.target.window-pick}"/>
                  <Button x:Name="BtnWindowRefresh"
                          Grid.Column="1"
                          Theme="{StaticResource GhostButton}"
                          Content="{loc:Text recorder.target.window-refresh}"
                          auto:AutomationProperties.Name="{loc:Text recorder.target.window-refresh}"/>
                </Grid>
              </StackPanel>
              <StackPanel x:Name="RowWindowTitle">
                <SarilanMetin Text="{loc:Text recorder.target.window-title}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtWindowTitle"
                         ToolTip.Tip="{loc:Text recorder.target.window-title-hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.target.window-title}"/>
              </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RowRegionTools" IsVisible="False" Spacing="{StaticResource SpaceMd}">
              <Button x:Name="BtnDrawRegion"
                      Theme="{StaticResource PrimaryButton}"
                      Content="{loc:Text recorder.target.region-draw}"
                      ToolTip.Tip="{loc:Text recorder.target.region-draw-hint}"
                      auto:AutomationProperties.Name="{loc:Text recorder.target.region-draw}"/>
              <izi:SutunIzgara x:Name="RowRegionShape"
                               MaxColumns="2" Uniform="True"
                               ColumnSpacing="{StaticResource SpaceMd}"
                               RowSpacing="{StaticResource SpaceMd}">
                <StackPanel>
                  <SarilanMetin Text="{loc:Text recorder.target.aspect}" Theme="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbAspect"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.target.aspect}"/>
                </StackPanel>
                <StackPanel>
                  <SarilanMetin Text="{loc:Text recorder.target.size}" Theme="{StaticResource Label}"/>
                  <ComboBox x:Name="CmbRegionSize"
                            HorizontalAlignment="Stretch"
                            auto:AutomationProperties.Name="{loc:Text recorder.target.size}"/>
                </StackPanel>
              </izi:SutunIzgara>
            </StackPanel>

            <izi:SutunIzgara x:Name="RowRegion"
                             IsVisible="False"
                             MaxColumns="4"
                             Uniform="True"
                             ColumnSpacing="{StaticResource SpaceSm}"
                             RowSpacing="{StaticResource SpaceSm}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.target.region-x}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionX" auto:AutomationProperties.Name="{loc:Text recorder.target.region-x}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.target.region-y}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionY" auto:AutomationProperties.Name="{loc:Text recorder.target.region-y}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.target.region-width}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionWidth" auto:AutomationProperties.Name="{loc:Text recorder.target.region-width}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.target.region-height}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtRegionHeight" auto:AutomationProperties.Name="{loc:Text recorder.target.region-height}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <SarilanMetin Text="{loc:Text recorder.target.region-hint}"
                       Theme="{StaticResource Hint}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding #RowRegion.IsVisible}"/>

            <WrapPanel x:Name="RowMask" ItemSpacing="{StaticResource SpaceMd}" LineSpacing="{StaticResource SpaceSm}">
              <SarilanMetin Text="{loc:Text recorder.mask.title}" Theme="{StaticResource Label}" VerticalAlignment="Center"/>
              <Button x:Name="BtnDrawMask"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.mask.draw}"
                      ToolTip.Tip="{loc:Text recorder.mask.draw-hint}"
                      auto:AutomationProperties.Name="{loc:Text recorder.mask.draw}"/>
              <Button x:Name="BtnClearMasks"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.mask.clear}"
                      auto:AutomationProperties.Name="{loc:Text recorder.mask.clear}"/>
              <SarilanMetin x:Name="TxtMaskCount"
                         Theme="{StaticResource Hint}"
                         VerticalAlignment="Center"/>
            </WrapPanel>

            <izi:SutunIzgara x:Name="RowTiming"
                             MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                  <SarilanMetin Text="{loc:Text recorder.countdown.title}" Theme="{StaticResource Label}"/>
                  <Button x:Name="BtnSchedule" Grid.Column="1" Theme="{StaticResource GhostButton}"
                          Width="{StaticResource InfoBadgeSize}" Height="{StaticResource InfoBadgeSize}"
                          MinHeight="0" Padding="0" Margin="{StaticResource InfoBadgeLabelMargin}"
                          CornerRadius="{StaticResource RadiusChip}" VerticalAlignment="Center"
                          auto:AutomationProperties.Name="{loc:Text recorder.schedule.open}">
                    <ToolTip.Tip>
                      <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text recorder.schedule.hint}"/>
                    </ToolTip.Tip>
                    <Path Width="{StaticResource InfoBadgeGlyphSize}" Height="{StaticResource InfoBadgeGlyphSize}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                    <Button.Flyout>
                      <Flyout>
                        <StackPanel Spacing="{StaticResource SpaceSm}" Width="{StaticResource FieldWidth}">
                          <SarilanMetin Text="{loc:Text recorder.schedule.open}" Theme="{StaticResource Label}"/>
                          <SarilanMetin Text="{loc:Text recorder.schedule.repeat}" Theme="{StaticResource Hint}"/>
                          <ComboBox x:Name="CmbScheduleRepeat" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.schedule.repeat}"/>
                          <SarilanMetin Text="{loc:Text recorder.schedule.time}" Theme="{StaticResource Hint}"/>
                          <TextBox x:Name="TxtScheduleTime" FontFamily="{StaticResource FontMono}" auto:AutomationProperties.Name="{loc:Text recorder.schedule.time}"/>
                          <StackPanel x:Name="PanelScheduleDay" Spacing="{StaticResource SpaceSm}" IsVisible="False">
                            <SarilanMetin Text="{loc:Text recorder.schedule.day}" Theme="{StaticResource Hint}"/>
                            <ComboBox x:Name="CmbScheduleDay" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.schedule.day}"/>
                          </StackPanel>
                          <SarilanMetin x:Name="TxtScheduleError" Theme="{StaticResource StatusError}" TextWrapping="Wrap" IsVisible="False"/>
                          <SarilanMetin x:Name="TxtScheduleNext" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
                        </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
                <ComboBox x:Name="CmbCountdown"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="{loc:Text recorder.countdown.hint}"
                          auto:AutomationProperties.Name="{loc:Text recorder.countdown.title}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.finish.title}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbFinishAction"
                          HorizontalAlignment="Stretch"
                          ToolTip.Tip="{loc:Text recorder.finish.hint}"
                          auto:AutomationProperties.Name="{loc:Text recorder.finish.title}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <CheckBox x:Name="ChkOpenFolder"
                      Theme="{StaticResource CheckStyle}"
                      Content="{loc:Text recorder.output.open-when-done}"
                      auto:AutomationProperties.Name="{loc:Text recorder.output.open-when-done}"/>
            <CheckBox x:Name="ChkResultCard"
                      Theme="{StaticResource CheckStyle}"
                      Content="{loc:Text recorder.card.show}"
                      auto:AutomationProperties.Name="{loc:Text recorder.card.show}"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CardsMiddle" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelOptions" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <SarilanMetin Text="{loc:Text recorder.option.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara x:Name="RecorderEncodingChoice" MaxColumns="2"
                             ColumnSpacing="{StaticResource SpaceLg}" RowSpacing="{StaticResource SpaceSm}">
              <RadioButton x:Name="RadAuto"
                           GroupName="RecorderEncoding"
                           Content="{loc:Text recorder.auto.automatic}"
                           ToolTip.Tip="{loc:Text recorder.auto.automatic-hint}"
                           auto:AutomationProperties.Name="{loc:Text recorder.auto.automatic}"/>
              <RadioButton x:Name="RadManual"
                           GroupName="RecorderEncoding"
                           Content="{loc:Text recorder.auto.manual}"
                           ToolTip.Tip="{loc:Text recorder.auto.manual-hint}"
                           auto:AutomationProperties.Name="{loc:Text recorder.auto.manual}"/>
            </izi:SutunIzgara>

            <StackPanel x:Name="PanelAutoResult" Spacing="{StaticResource SpaceSm}">
              <SarilanMetin x:Name="TxtAutoSummary" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>
              <Button x:Name="BtnAutoMeasure"
                      HorizontalAlignment="Left"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.auto.measure}"
                      auto:AutomationProperties.Name="{loc:Text recorder.auto.measure}"
                      Click="OnAutoMeasure"/>
            </StackPanel>

            <izi:SutunIzgara x:Name="PanelManualOptions"
                             MaxColumns="2"
                             Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.option.fps}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtFps" auto:AutomationProperties.Name="{loc:Text recorder.option.fps}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.option.quality}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtQuality"
                         ToolTip.Tip="{loc:Text recorder.option.quality-hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.option.quality}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.option.codec}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbCodec"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.codec}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.option.preset}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbPreset"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.preset}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.budget.seconds}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtTargetSeconds"
                         PlaceholderText="{loc:Text recorder.budget.optional}"
                         ToolTip.Tip="{loc:Text recorder.budget.hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.budget.seconds}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.budget.megabytes}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtTargetMegabytes"
                         PlaceholderText="{loc:Text recorder.budget.optional}"
                         ToolTip.Tip="{loc:Text recorder.budget.hint}"
                         auto:AutomationProperties.Name="{loc:Text recorder.budget.megabytes}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <SarilanMetin x:Name="TxtBudgetNote" Theme="{StaticResource Hint}" TextWrapping="Wrap" IsVisible="False"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceXs}">
              <CheckBox x:Name="ChkCursor"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.cursor}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.cursor}"/>
              <CheckBox x:Name="ChkShowClicks"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.show-clicks}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.show-clicks}"/>
              <CheckBox x:Name="ChkCursorHighlight"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.cursor-highlight}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.cursor-highlight}"/>
              <CheckBox x:Name="ChkSpotlight"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.spotlight}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.spotlight}"/>
              <CheckBox x:Name="ChkClickSound"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.click-sound}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.click-sound}"/>
              <CheckBox x:Name="ChkShowKeys"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.show-keys}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.show-keys}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceXs}">
                <CheckBox x:Name="ChkMagnifier"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.option.magnifier}"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.magnifier}"/>
                <Button x:Name="BtnZoomTrack" Grid.Column="1" Theme="{StaticResource GhostButton}"
                        Width="{StaticResource InfoBadgeSize}" Height="{StaticResource InfoBadgeSize}"
                        MinHeight="0" Padding="0"
                        CornerRadius="{StaticResource RadiusChip}" VerticalAlignment="Center"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.zoom-track}">
                  <ToolTip.Tip>
                    <SarilanMetin Theme="{StaticResource TipText}" Text="{loc:Text recorder.option.zoom-track}"/>
                  </ToolTip.Tip>
                  <Path Width="{StaticResource InfoBadgeGlyphSize}" Height="{StaticResource InfoBadgeGlyphSize}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel Spacing="{StaticResource SpaceSm}" Width="{StaticResource FieldWidth}">
                        <CheckBox x:Name="ChkZoomTrack"
                                  Theme="{StaticResource CheckStyle}"
                                  Content="{loc:Text recorder.option.zoom-track}"
                                  auto:AutomationProperties.Name="{loc:Text recorder.option.zoom-track}"/>
                        <SarilanMetin Theme="{StaticResource Hint}" TextWrapping="Wrap" Text="{loc:Text recorder.option.zoom-track-hint}"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <CheckBox x:Name="ChkLivePreview"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.live-preview}"
                        ToolTip.Tip="{loc:Text recorder.option.live-preview-hint}"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.live-preview}"/>
              <CheckBox x:Name="ChkHideIcons"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.option.hide-desktop-icons}"
                        ToolTip.Tip="{loc:Text recorder.option.hide-desktop-icons-hint}"
                        ToolTip.ShowOnDisabled="True"
                        auto:AutomationProperties.Name="{loc:Text recorder.option.hide-desktop-icons}"/>
            </izi:SutunIzgara>

            <SarilanMetin Text="{loc:Text recorder.pointer.title}"
                       Theme="{StaticResource Label}"
                       IsVisible="{Binding #PointerChoices.IsVisible}"/>
            <izi:SutunIzgara x:Name="PointerChoices" MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceSm}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.pointer.size}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbPointerSize"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.pointer.size}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.pointer.highlight-color}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbHighlightColor"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.pointer.highlight-color}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.pointer.left-color}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbLeftClickColor"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.pointer.left-color}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.pointer.right-color}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbRightClickColor"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.pointer.right-color}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <SarilanMetin Text="{loc:Text recorder.keys.title}"
                       Theme="{StaticResource Label}"
                       IsVisible="{Binding #KeyChoices.IsVisible}"/>
            <izi:SutunIzgara x:Name="KeyChoices" MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceSm}">
              <CheckBox x:Name="ChkKeysShortcutsOnly"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.keys.shortcuts-only}"
                        ToolTip.Tip="{loc:Text recorder.keys.shortcuts-only-hint}"
                        auto:AutomationProperties.Name="{loc:Text recorder.keys.shortcuts-only}"/>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.keys.place}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbKeyCaptionPlace"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.keys.place}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.keys.size}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbKeyCaptionSize"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.keys.size}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.keys.hold}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbKeyCaptionHold"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.keys.hold}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <StackPanel>
              <Grid ColumnDefinitions="Auto,Auto" HorizontalAlignment="Left">
                <SarilanMetin Text="{loc:Text recorder.output.title}" Theme="{StaticResource Label}"/>
                <Button x:Name="BtnNamePattern" Grid.Column="1" Theme="{StaticResource GhostButton}"
                        Width="{StaticResource InfoBadgeSize}" Height="{StaticResource InfoBadgeSize}"
                        MinHeight="0" Padding="0" Margin="{StaticResource InfoBadgeLabelMargin}"
                        CornerRadius="{StaticResource RadiusChip}" VerticalAlignment="Center"
                        auto:AutomationProperties.Name="{loc:Text recorder.name.title}">
                  <ToolTip.Tip>
                    <SarilanMetin Theme="{StaticResource TipText}" Text="{loc:Text recorder.name.title}"/>
                  </ToolTip.Tip>
                  <Path Width="{StaticResource InfoBadgeGlyphSize}" Height="{StaticResource InfoBadgeGlyphSize}" Stretch="Uniform" Data="{StaticResource IconChevronDown}" Fill="{Binding $parent[Button].Foreground}"/>
                  <Button.Flyout>
                    <Flyout>
                      <StackPanel Spacing="{StaticResource SpaceSm}" Width="{StaticResource FieldWidth}">
                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                          <SarilanMetin Text="{loc:Text recorder.name.title}" Theme="{StaticResource Label}"/>
                          <Button Grid.Column="1" Theme="{StaticResource InfoButtonBesideLabel}" auto:AutomationProperties.Name="{loc:Text recorder.name.title}">
                            <ToolTip.Tip>
                              <SarilanMetin Theme="{StaticResource TipText}" loc:Bullets.Text="{loc:Text recorder.name.hint}"/>
                            </ToolTip.Tip>
                          </Button>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                          <TextBox x:Name="TxtNamePattern"
                                   FlowDirection="LeftToRight"
                                   auto:AutomationProperties.Name="{loc:Text recorder.name.title}"/>
                          <Button Grid.Column="1"
                                  x:Name="BtnResetNamePattern"
                                  Theme="{StaticResource GhostButton}"
                                  Content="{loc:Text settings-tab.output-name.reset}"
                                  auto:AutomationProperties.Name="{loc:Text settings-tab.output-name.reset}"
                                  Click="OnResetNamePattern"/>
                        </Grid>
                        <SarilanMetin x:Name="TxtNamePreview" Theme="{StaticResource Hint}" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
              </Grid>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceSm}">
                <TextBox Grid.Column="0"
                         x:Name="TxtOutputFolder"
                         ToolTip.Tip="{Binding $self.Text}"
                         auto:AutomationProperties.Name="{loc:Text recorder.output.title}"/>
                <Button Grid.Column="1"
                        x:Name="BtnBrowse"
                        Theme="{StaticResource GhostButton}"
                        Content="{loc:Text recorder.output.browse}"
                        auto:AutomationProperties.Name="{loc:Text recorder.output.browse}"
                        Click="OnBrowse"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Ses girdisi. Liste ffmpeg'in kendisinden geliyor; cihazsız makinede kutular
             yalnız "sessiz" öğesiyle açılıyor ve kayıt sessiz sürüyor. -->
        <Border x:Name="PanelAudio" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceMd}">
              <SarilanMetin Text="{loc:Text recorder.audio.title}" Theme="{StaticResource H2}"/>
              <CheckBox x:Name="ChkPushToTalk" Grid.Column="1"
                        Theme="{StaticResource CheckStyle}"
                        VerticalAlignment="Center"
                        Content="{loc:Text recorder.audio.push-to-talk}"
                        auto:AutomationProperties.Name="{loc:Text recorder.audio.push-to-talk}"/>
            </Grid>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <SarilanMetin Text="{loc:Text recorder.audio.microphone}" Theme="{StaticResource Label}"/>
                  <ProgressBar x:Name="BarMicrophoneLevel" Grid.Column="1"
                               IsVisible="False"
                               Minimum="0" Maximum="1"
                               VerticalAlignment="Center"
                               Margin="{StaticResource RecorderAudioLevelGap}"
                               ToolTip.Tip="{loc:Text recorder.audio.level.hint}"
                               auto:AutomationProperties.Name="{loc:Text recorder.audio.level.microphone}"/>
                </Grid>
                <ComboBox x:Name="CmbMicrophone"
                          ToolTip.Tip="{loc:Text recorder.audio.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.audio.microphone}"/>
              </StackPanel>

              <StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <SarilanMetin Text="{loc:Text recorder.audio.system}" Theme="{StaticResource Label}"/>
                  <ProgressBar x:Name="BarSystemAudioLevel" Grid.Column="1"
                               IsVisible="False"
                               Minimum="0" Maximum="1"
                               VerticalAlignment="Center"
                               Margin="{StaticResource RecorderAudioLevelGap}"
                               ToolTip.Tip="{loc:Text recorder.audio.level.hint}"
                               auto:AutomationProperties.Name="{loc:Text recorder.audio.level.system}"/>
                </Grid>
                <ComboBox x:Name="CmbSystemAudio"
                          ToolTip.Tip="{loc:Text recorder.audio.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.audio.system}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <Button x:Name="BtnAudioRefresh"
                    Theme="{StaticResource GhostButton}"
                    Content="{loc:Text recorder.audio.refresh}"
                    auto:AutomationProperties.Name="{loc:Text recorder.audio.refresh}"
                    Click="OnAudioRefresh"/>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CardsRight" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelAdvanced" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <SarilanMetin Text="{loc:Text recorder.advanced.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara MaxColumns="3" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.container}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbContainer" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.container}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.audio-layout}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbAudioLayout" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.audio-layout}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.audio-codec}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbAudioCodec" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.audio-codec}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.max-duration}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtMaxDuration" PlaceholderText="{loc:Text recorder.budget.optional}" ToolTip.Tip="{loc:Text recorder.advanced.optional}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.max-duration}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.split-seconds}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtSplitSeconds" PlaceholderText="{loc:Text recorder.budget.optional}" ToolTip.Tip="{loc:Text recorder.advanced.optional}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.split-seconds}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.split-megabytes}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtSplitMegabytes" PlaceholderText="{loc:Text recorder.budget.optional}" ToolTip.Tip="{loc:Text recorder.advanced.optional}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.split-megabytes}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.audio-gain}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtAudioGain" PlaceholderText="{loc:Text recorder.budget.optional}" ToolTip.Tip="{loc:Text recorder.advanced.optional}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.audio-gain}"/>
              </StackPanel>
            </izi:SutunIzgara>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceSm}">
              <CheckBox x:Name="ChkNoiseGate"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.advanced.noise-gate}"
                        auto:AutomationProperties.Name="{loc:Text recorder.advanced.noise-gate}"/>
              <CheckBox x:Name="ChkNoiseSuppression"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.advanced.noise-suppression}"
                        auto:AutomationProperties.Name="{loc:Text recorder.advanced.noise-suppression}"/>
              <CheckBox x:Name="ChkCompressor"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.advanced.compressor}"
                        auto:AutomationProperties.Name="{loc:Text recorder.advanced.compressor}"/>
              <CheckBox x:Name="ChkLimiter"
                        Theme="{StaticResource CheckStyle}"
                        Content="{loc:Text recorder.advanced.limiter}"
                        auto:AutomationProperties.Name="{loc:Text recorder.advanced.limiter}"/>
            </izi:SutunIzgara>
          </StackPanel>
        </Border>

        <Border x:Name="PanelReplay" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <SarilanMetin Text="{loc:Text recorder.replay.label}" Theme="{StaticResource H2}"/>

            <StackPanel>
              <SarilanMetin Text="{loc:Text recorder.replay.seconds}" Theme="{StaticResource Label}" TextWrapping="Wrap"/>
              <ComboBox x:Name="CmbReplaySeconds"
                        HorizontalAlignment="Stretch"
                        auto:AutomationProperties.Name="{loc:Text recorder.replay.seconds}"/>
            </StackPanel>

            <WrapPanel ItemSpacing="{StaticResource SpaceLg}" LineSpacing="{StaticResource SpaceSm}">
              <Button x:Name="BtnReplay"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Theme="{StaticResource GhostButton}"
                      Content="{loc:Text recorder.replay.start}"
                      auto:AutomationProperties.Name="{loc:Text recorder.replay.start}"
                      Click="OnReplayToggle"/>

              <Button x:Name="BtnReplaySave"
                      MinHeight="{StaticResource RecorderButtonSize}"
                      Theme="{StaticResource GhostButton}"
                      IsVisible="False"
                      auto:AutomationProperties.Name="{loc:Text recorder.replay.save}"
                      Click="OnReplaySave"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="CardsExtra" Spacing="{StaticResource SpaceMd}">
        <Border x:Name="PanelWebcam" Theme="{StaticResource Panel}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <SarilanMetin Text="{loc:Text recorder.webcam.title}" Theme="{StaticResource H2}"/>

            <izi:SutunIzgara MaxColumns="2" Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.webcam.device}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcam"
                          ToolTip.Tip="{loc:Text recorder.webcam.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.device}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.webcam.shape}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcamShape"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.shape}"/>
              </StackPanel>

              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.webcam.background.label}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbWebcamBackground"
                          ToolTip.Tip="{loc:Text recorder.webcam.background.hint}"
                          HorizontalAlignment="Stretch"
                          auto:AutomationProperties.Name="{loc:Text recorder.webcam.background.label}"/>
              </StackPanel>

              <CheckBox x:Name="ChkWebcamMirror"
                        Theme="{StaticResource CheckStyle}"
                        VerticalAlignment="Bottom"
                        Content="{loc:Text recorder.webcam.mirror}"
                        auto:AutomationProperties.Name="{loc:Text recorder.webcam.mirror}"/>
            </izi:SutunIzgara>
          </StackPanel>
        </Border>

        <Border x:Name="PanelEncoding" Theme="{StaticResource Panel}" IsVisible="{Binding #PanelAdvancedEncoding.IsVisible}">
          <StackPanel Spacing="{StaticResource SpaceMd}">
            <SarilanMetin Text="{loc:Text recorder.advanced.encoder-title}" Theme="{StaticResource H2}"/>
            <izi:SutunIzgara x:Name="PanelAdvancedEncoding"
                             MaxColumns="3"
                             Uniform="True"
                             ColumnSpacing="{StaticResource SpaceMd}"
                             RowSpacing="{StaticResource SpaceMd}">
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.scale-width}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtScaleWidth" ToolTip.Tip="{loc:Text recorder.advanced.scale-hint}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.scale-width}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.scale-height}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtScaleHeight" ToolTip.Tip="{loc:Text recorder.advanced.scale-hint}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.scale-height}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.keyframe}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtKeyframe" auto:AutomationProperties.Name="{loc:Text recorder.advanced.keyframe}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.pixel-format}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbPixelFormat" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.pixel-format}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.profile}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbProfile" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.profile}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.tune}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbTune" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.tune}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.color-space}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbColorSpace" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.color-space}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.color-range}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbColorRange" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.color-range}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.rate}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbRateControl" HorizontalAlignment="Stretch" auto:AutomationProperties.Name="{loc:Text recorder.advanced.rate}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.frame-rate-mode}" Theme="{StaticResource Label}"/>
                <ComboBox x:Name="CmbFrameRateMode" HorizontalAlignment="Stretch" ToolTip.Tip="{loc:Text recorder.advanced.frame-rate-mode-hint}" auto:AutomationProperties.Name="{loc:Text recorder.advanced.frame-rate-mode}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.bitrate}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtBitrate" auto:AutomationProperties.Name="{loc:Text recorder.advanced.bitrate}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.max-bitrate}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtMaxBitrate" auto:AutomationProperties.Name="{loc:Text recorder.advanced.max-bitrate}"/>
              </StackPanel>
              <StackPanel>
                <SarilanMetin Text="{loc:Text recorder.advanced.buffer}" Theme="{StaticResource Label}"/>
                <TextBox x:Name="TxtBuffer" auto:AutomationProperties.Name="{loc:Text recorder.advanced.buffer}"/>
              </StackPanel>
            </izi:SutunIzgara>
            <CheckBox x:Name="ChkHdrToSdr"
                      Theme="{StaticResource CheckStyle}"
                      Content="{loc:Text recorder.advanced.hdr-to-sdr}"
                      ToolTip.Tip="{loc:Text recorder.advanced.hdr-to-sdr-hint}"
                      auto:AutomationProperties.Name="{loc:Text recorder.advanced.hdr-to-sdr}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </izi:KartDuvari>
  </StackPanel>
</UserControl>
