<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:VidShrink.Core"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        x:Class="VidShrink.App.Recorder.RecorderRegionPicker"
        Title="{x:Static core:AppIdentity.Name}" FontSize="{StaticResource FontSizeMd}" FontFamily="{StaticResource FontSans}"
        WindowDecorations="None"
        CanResize="False" CanMaximize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Canvas x:Name="Surface" Background="Transparent">
    <Border x:Name="Scrim"
            Background="{StaticResource PlaybackScrim}"
            Opacity="{StaticResource RecorderPickerScrimOpacity}"
            IsHitTestVisible="False"/>
    <Border x:Name="Selection"
            BorderBrush="{StaticResource NeonEmber}"
            BorderThickness="{StaticResource RecorderFrameBorder}"
            IsVisible="False"
            IsHitTestVisible="False"/>
    <Border x:Name="SnapX" Classes="snap" IsVisible="False" IsHitTestVisible="False"/>
    <Border x:Name="SnapY" Classes="snap" IsVisible="False" IsHitTestVisible="False"/>
    <Border x:Name="SizeTag"
            Theme="{StaticResource Panel}"
            Padding="{StaticResource RecorderStripPadding}"
            IsVisible="False"
            IsHitTestVisible="False">
      <SarilanMetin x:Name="TxtSize" Theme="{StaticResource MonoValue}"/>
    </Border>
    <Border x:Name="ModeBar"
            Theme="{StaticResource Panel}"
            Background="{StaticResource Surface}"
            Padding="{StaticResource RecorderStripPadding}"
            Cursor="Arrow"
            IsVisible="False">
      <StackPanel Spacing="{StaticResource RecorderStripGap}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource RecorderStripGap}" HorizontalAlignment="Center">
          <Button x:Name="BtnModeRegion"
                  Theme="{StaticResource PrimaryButton}"
                  Content="{loc:Text recorder.target.region}"
                  auto:AutomationProperties.Name="{loc:Text recorder.target.region}"/>
          <Button x:Name="BtnModeScreen"
                  Theme="{StaticResource GhostButton}"
                  Content="{loc:Text recorder.target.screen}"
                  auto:AutomationProperties.Name="{loc:Text recorder.target.screen}"/>
          <Button x:Name="BtnModeWindow"
                  Theme="{StaticResource GhostButton}"
                  Content="{loc:Text recorder.target.window}"
                  auto:AutomationProperties.Name="{loc:Text recorder.target.window}"/>
        </StackPanel>
        <SarilanMetin x:Name="TxtModeHint" Theme="{StaticResource Hint}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Canvas>
  <Window.Styles>
    <Style Selector="Border.snap">
      <Setter Property="Background" Value="{DynamicResource NeonBlue}"/>
    </Style>
  </Window.Styles>
</Window>
