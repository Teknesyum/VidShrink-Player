<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:auto="using:Avalonia.Automation"
        xmlns:loc="using:VidShrink.App.Localization"
        xmlns:core="using:VidShrink.Core"
        x:Class="VidShrink.App.Recorder.RecorderMini"
        Title="{x:Static core:AppIdentity.Name}" FontSize="{StaticResource FontSizeMd}" FontFamily="{StaticResource FontSans}"
        WindowDecorations="None"
        CanResize="False" CanMaximize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        SizeToContent="WidthAndHeight"
        auto:AutomationProperties.Name="{loc:Text recorder.mini.title}">

  <!--
    Mini kip. Saha taramasında ölçülen 22 kompakt yüzeyin yükseklik kümesi 30-64 px;
    bu şerit 56. Genişlik belirteçten geliyor, sayaç genişliği MiniKipOlcusuTests'te
    ölçüldü.

    Şeritte yalnız kayıt sürerken anlamı olan şeyler var. Kare ve düşen kare okumaları,
    hedef seçimi, kodek, ön ayar, ses aygıtı ve sonuç paneli büyük pencerede kalıyor:
    hepsi kayıt öncesi kararlar ve kayıt başladıktan sonra zaten değişemiyorlar.  -->
  <Border x:Name="MiniStrip"
          Theme="{StaticResource Panel}"
          Background="{StaticResource Surface}"
          Padding="{StaticResource RecorderMiniPadding}"
          MinWidth="{StaticResource RecorderMiniMinWidth}"
          Height="{StaticResource RecorderMiniHeight}"
          PointerPressed="OnDrag">
    <Border.Styles>
      <Style Selector="Button, SarilanMetin">
        <Setter Property="ToolTip.ShowDelay" Value="{StaticResource RecorderMiniTipDelay}"/>
      </Style>
    </Border.Styles>
    <Grid ColumnDefinitions="Auto,Auto,*"
          ColumnSpacing="{StaticResource RecorderMiniGroupGap}">

      <StackPanel Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="{StaticResource RecorderStripGap}"
                  VerticalAlignment="Center">
        <Button x:Name="BtnToggle"
                Width="{StaticResource RecorderButtonSize}"
                Height="{StaticResource RecorderButtonSize}"
                Padding="0"
                Theme="{StaticResource PrimaryButton}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.start}"
                ToolTip.Tip="{loc:Text recorder.strip.start}"
                Click="OnToggle">
          <Path x:Name="ToggleGlyph"
                Width="{StaticResource IconSizeLg}"
                Height="{StaticResource IconSizeLg}"
                Stretch="Uniform"
                Data="{StaticResource IconPause}"
                Fill="{StaticResource OnNeon}"/>
        </Button>

        <Button x:Name="BtnStop"
                Width="{StaticResource RecorderButtonSize}"
                Height="{StaticResource RecorderButtonSize}"
                Padding="0"
                Theme="{StaticResource AccentButton}"
                auto:AutomationProperties.Name="{loc:Text recorder.strip.stop}"
                ToolTip.Tip="{loc:Text recorder.strip.stop}"
                Click="OnStop">
          <Path Width="{StaticResource IconSizeLg}"
                Height="{StaticResource IconSizeLg}"
                Stretch="Uniform"
                Data="{StaticResource IconStop}"
                Fill="{StaticResource NeonBlue}"/>
        </Button>

        <Button x:Name="BtnRegion"
                Height="{StaticResource RecorderButtonSize}"
                Padding="{StaticResource ButtonPaddingSm}"
                Theme="{StaticResource AccentButton}"
                Content="{loc:Text recorder.mini.region}"
                auto:AutomationProperties.Name="{loc:Text recorder.mini.region}"
                ToolTip.Tip="{loc:Text recorder.mini.pick-hint}"
                Click="OnRegion"/>
      </StackPanel>

      <!-- Şeridin düğme dışındaki her yeri tutamak; sayaç taşıma imlecini gösteriyor. -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="{StaticResource RecorderStripGap}"
                  VerticalAlignment="Center">
        <Ellipse x:Name="LiveDot"
                 Width="{StaticResource RecorderDotSize}"
                 Height="{StaticResource RecorderDotSize}"
                 Fill="{StaticResource NeonEmber}"
                 Opacity="0"
                 VerticalAlignment="Center"/>
        <SarilanMetin x:Name="TxtElapsed"
                   Theme="{StaticResource MonoValue}"
                   MinWidth="{StaticResource RecorderMiniReadoutWidth}"
                   Cursor="SizeAll"
                   VerticalAlignment="Center"
                   ToolTip.Tip="{loc:Text recorder.mini.drag-hint}"/>
        <!-- Bölüm işaretinin bildirimi; işaret konana kadar yer tutmaz. -->
        <SarilanMetin x:Name="TxtChapter"
                   Theme="{StaticResource Hint}"
                   IsVisible="False"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  Spacing="{StaticResource RecorderStripGap}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
        <Button x:Name="BtnOptions"
                Width="{StaticResource RecorderButtonSize}"
                Height="{StaticResource RecorderButtonSize}"
                Theme="{StaticResource GhostButton}"
                auto:AutomationProperties.Name="{loc:Text recorder.mini.options}"
                ToolTip.Tip="{loc:Text recorder.mini.options}">
          <Button.Flyout>
            <Flyout Placement="Top">
              <StackPanel x:Name="PanelOptions" Spacing="{StaticResource SpaceSm}">
                <CheckBox x:Name="ChkShowClicks"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.option.show-clicks}"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.show-clicks}"/>
                <CheckBox x:Name="ChkClickSound"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.option.click-sound}"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.click-sound}"/>
                <CheckBox x:Name="ChkShowKeys"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.option.show-keys}"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.show-keys}"/>
                <CheckBox x:Name="ChkMagnifier"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.option.magnifier}"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.magnifier}"/>
                <CheckBox x:Name="ChkOpenFolder"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.output.open-when-done}"
                          auto:AutomationProperties.Name="{loc:Text recorder.output.open-when-done}"/>
                <CheckBox x:Name="ChkCursor"
                          Theme="{StaticResource CheckStyle}"
                          Content="{loc:Text recorder.option.cursor}"
                          ToolTip.Tip="{loc:Text recorder.mini.options-locked}"
                          auto:AutomationProperties.Name="{loc:Text recorder.option.cursor}"/>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <Path Width="{StaticResource IconSizeLg}"
                Height="{StaticResource IconSizeLg}"
                Stretch="Uniform"
                Data="{StaticResource IconSettings}"
                Fill="{StaticResource TextBody}"/>
        </Button>

        <Button x:Name="BtnExpand"
                Width="{StaticResource RecorderButtonSize}"
                Height="{StaticResource RecorderButtonSize}"
                Theme="{StaticResource GhostButton}"
                auto:AutomationProperties.Name="{loc:Text recorder.mini.expand}"
                ToolTip.Tip="{loc:Text recorder.mini.expand}"
                Click="OnExpand">
          <Path Width="{StaticResource IconSizeLg}"
                Height="{StaticResource IconSizeLg}"
                Stretch="Uniform"
                Data="{StaticResource IconFullScreen}"
                Fill="{StaticResource TextBody}"/>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>
