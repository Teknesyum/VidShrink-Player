<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

  <!--
    K6: burada tanımlanan her belirteç Theme.axaml'daki bir belirtecin değerini alır.
    Yeni ölçü ya da yeni renk üretilmiyor; yalnız oynatıcıya ait ad veriliyor.

      PlaybackSeparatorWidth   <- FocusRingThickness (2)
      PlaybackHandleWidth      <- TargetMinSize (24)
      PlaybackHandleHeight     <- DropIconSize (48)
      PlaybackStageMinHeight   <- PanelMinHeight (256) x 2 = 512. T52: kullanıcının
                                  istediği taban boy panel tabanının iki katı. Sayı
                                  uydurulmadı; programdaki tek panel taban ölçüsünün katı.
      PlaybackBadgeMargin      <- SpaceMd (12)
      PlaybackScrimColor       <- AppBgColor (#050507), %80 örtücülük
      PlaybackScrimEdgeColor   <- aynı renk, sıfır örtücülük: paravanın sönen ucu.
      PlaybackTitleScrimColor  <- aynı renk, %90 örtücülük: medya adının zemini. Altında video
                                  karesi durur; %80 en kötü karede (beyaz/siyah) RosePineDawn'da
                                  5,88:1 veriyordu, %90 36 palette metni 7:1 üstünde tutar.
      PlaybackScrimEdge        <- PlaybackHoverZoneShare (SpaceXs / SpaceLg = 0,25).
                                  T79: paravan artık düz bir örtü değil — alt kenarından
                                  yukarı doğru son çeyreğinde sönüyor. Yeni bir oran
                                  uydurulmadı; panelin tek "band payı" oranı kullanıldı.
      PlaybackIdleVeilOpacity  <- PhoenixOpacity (0,08). Kaynak yüklenmemişken
                                  panonun zemini bu opaklıkta durur, yani arkadaki anka
                                  çizildiği güçle panelin içinden görünür. İki yerde iki
                                  ayrı sayı olmasın diye ankanın kendi belirtecinin değeri.
      PlaybackPromotedShell    <- AppBg (#050507). T82: panel taban boyunun üstündeki her
                                  kademede kabuğun zemini bu fırçadır — programın en koyu
                                  zemin belirteci, tam örtücü. Yeni bir ton üretilmedi.
      PlaybackButtonIconSize   <- SpaceMd (12), düğmenin (24) yarısı: simgenin kutusu.
      PlaybackMaximizeIcon     <- ölçü değil, biçim: kutunun kendisi. Maksimize simgesi
                                  panelin alacağı çerçevedir.
      PlaybackFullScreenIcon   <- ölçü değil, biçim: kutunun dört köşesi. Tam ekran
                                  simgesi kenarların dışarı açılmasıdır.
      PlaybackMaxPanelScale    <- ölçü değil, jest aralığı: panel boyunun tavanı, taban
                                  boyun katı olarak. ZoomGesture ile aynı sayı.

    T40 — denetim şeridi:

      PlaybackStripPadding     <- TooltipPadding (16,12)
      PlaybackStripMargin      <- SpaceMd (12), rozet kenar boşluğuyla aynı
      PlaybackStripGap         <- SpaceMd (12), şerit içindeki sütun arası
      PlaybackStripHideDelay   <- ölçü değil: fare çıkınca şerit beklemeden kaybolur (0).
      PlaybackStripShowDelay   <- ölçü değil: şerit beklemeden belirir (T70/K5).
      PlaybackHoverZoneShare   <- SpaceXs / SpaceLg (4/16 = 0,25); oran, piksel değil
      PlaybackTimelineHeight   <- TargetMinSize (24), dokunma hedefi
      PlaybackTrackHeight      <- ProgressBarHeight (8)
      PlaybackThumbSize        <- SliderThumbSize (20)
      PlaybackCursorWidth      <- DropOutlineThickness (2)

    4b dalga — küçük resim önizlemesi:

      PlaybackThumbnailWidth   <- PanelMinHeight (256) yarısı = 128. Sahne tabanı gibi,
                                  programın tek panel taban ölçüsünün katı; yeni sayı yok.
      PlaybackThumbnailHeight  <- ölçü değil biçim: genişliğin 16:9'u (128 x 9/16 = 72).
                                  Oran AspectRatios listesindeki ilk gerçek en-boy.

    T44 — orta kademe (T82: gecikmeli iniş de, fareyle büyüme de kalktı):

      PlaybackMidShare         <- WindowWorkAreaShare (0,9); orta kademenin tavanı, yani
                                  ölçekli boy pencerenin bu oranını geçemez. Aynı
                                  belirteç pencerenin çalışma alanına oturmasını da
                                  sürüyor: "kapla ama kenarı bırak" ölçüsü tektir.
      T79: panelin iki bekleme süresi (PlaybackPanelRiseDelay, PlaybackPanelFallDelay)
      buradan tamamen kalktı. T82: fareyle büyüme de kalktı, yani bir daha bekleyecek
      bir şey yok — boy iki tuşla değişiyor. Şeridin kendi iki süresi
      (PlaybackStripShowDelay/HideDelay) duruyor: onlar başka karar.

    T46 — boş panel ve tıkla yakınlaştırma:

      PlaybackIdleMinHeight    <- PanelMinHeight (256) x 2 = 512. Sahne tabanıyla aynı:
                                  panel önizleme olsun olmasın aynı boyda durur, ve o boy
                                  panel tabanının iki katıdır (T52/K3).
      PlaybackZoomButtonSize   <- TargetMinSize (24), dokunma hedefi. Şeritteki zaman
                                  çizgisiyle aynı ölçü.
      PlaybackZoomButtonGap    <- SpaceSm (8), iki düğme arası.
      PlaybackBadgeGap         <- SpaceSm (8), sağ üstte alt alta duran iki yonganın arası.
                                  Yakınlaştırma düğmelerinin arasıyla aynı sayı; ikisi de
                                  yan yana/alt alta duran küçük yongaların boşluğu.
      PlaybackHoverZoom        <- ölçü değil, kullanıcının söylediği kat: 2x. T52'den beri
                                  bu kat panelin boy ölçeği. Aynı sayı orta kademenin çıkış
                                  eşiğidir: iki kat panel bandına sığmayan ilk boydur, o
                                  yüzden panel orada kök katmana çıkar. Jest parametresi
                                  buradan türer, ters yönden değil; tavan
                                  (PlaybackMaxPanelScale) değişirse hesap kendiliğinden
                                  düzelir. T73: bu kat artık büyümenin tavanı değil tabanı —
                                  panelin maksimize edilince çıktığı boy pencereden
                                  hesaplanıyor, bu sayı da orta kademenin eşiği olarak
                                  altına inilemeyen sınır.

    T79: yuvarlak geri sayımın üç belirteci de (PlaybackCountdownSize/Radius/Stroke) ve
    perdesi kalktı. Bekleme olmayınca sayan bir gösterge de yok.

    7b: oynatıcının alt denetim şeridi. Karşılaştırma panelinin şeridi dar bir aralığa
    sıkışıyor, oynatıcı sekmesi sıkışmıyor — o yüzden şeridin ölçüleri ortak, yalnız bu üç
    sayı ayrı ve üçü de var olan belirteçten geliyor, yenisi uydurulmadı:

      PlaybackSeekBarHeight    <- TargetMin (24). İnce şerit isteğiyle geri indi. Zaman çubuğunun tıklanabilir
                                  yüksekliği. Eskiden PlaybackTimelineHeight (24), yani
                                  dokunma tabanının (TargetMinSize) kendisiydi: hedefin
                                  alt sınırı. Programın "rahat satır" ölçüsü alan
                                  yüksekliği olduğu için çubuk da oraya çekildi.
      PlaybackSeekTrackHeight  <- Space1 (4). İnce şerit isteği. Görünen yolun kalınlığı. Şeridin
                                  yolu ilerleme çubuğu ölçüsünde (ProgressBarHeight, 8)
                                  kalıyor; sürüklenen yol kaydırıcının ölçüsünde.
      PlaybackBarButtonSize    <- TargetMin + Space2 (32). İnce şerit isteği. Şerit düğmesinin dokunma hedefi,
                                  zaman çubuğuyla aynı sayı: alt şerit tek satır
                                  yüksekliğinde okunuyor.
  -->

  <x:Double x:Key="PlaybackSeparatorWidth">2</x:Double>
  <x:Double x:Key="PlaybackHandleWidth">24</x:Double>
  <x:Double x:Key="PlaybackHandleHeight">48</x:Double>
  <x:Double x:Key="PlaybackStageMinHeight">512</x:Double>
  <Thickness x:Key="PlaybackBadgeMargin">12</Thickness>
  <x:Double x:Key="PlaybackMaxPanelScale">4</x:Double>

  <Thickness x:Key="PlaybackStripPadding">12,4,12,8</Thickness>
  <Thickness x:Key="PlaybackStripMargin">0</Thickness>
  <Thickness x:Key="PlaybackStripGap">0,0,12,0</Thickness>
  <sys:TimeSpan x:Key="PlaybackStripHideDelay">00:00:00</sys:TimeSpan>
  <sys:TimeSpan x:Key="PlaybackStripShowDelay">00:00:00</sys:TimeSpan>
  <x:Double x:Key="PlaybackHoverZoneShare">0.25</x:Double>
  <x:Double x:Key="PlaybackHoverZoneHeight">96</x:Double>
  <x:Double x:Key="PlaybackTimelineHeight">24</x:Double>
  <x:Double x:Key="PlaybackTrackHeight">8</x:Double>
  <x:Double x:Key="PlaybackThumbSize">20</x:Double>
  <x:Double x:Key="PlaybackCursorWidth">2</x:Double>

  <x:Double x:Key="PlaybackSeekBarHeight">24</x:Double>
  <x:Double x:Key="PlaybackSeekHeadWidth">1</x:Double>
  <x:Double x:Key="PlaybackSeekShimmerWidth">48</x:Double>
  <LinearGradientBrush x:Key="PlaybackSeekSpan" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{StaticResource Renk2Color}" Offset="0"/>
    <GradientStop Color="{StaticResource Renk1Color}" Offset="0.2"/>
    <GradientStop Color="{StaticResource Renk1Color}" Offset="0.8"/>
    <GradientStop Color="{StaticResource Renk2Color}" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PlaybackSeekShimmer" StartPoint="0%,50%" EndPoint="100%,50%">
    <GradientStop Color="{StaticResource Renk1Color}" Offset="0"/>
    <GradientStop Color="{StaticResource Renk2Color}" Offset="0.33"/>
    <GradientStop Color="{StaticResource Renk1Color}" Offset="0.66"/>
    <GradientStop Color="{StaticResource Renk2Color}" Offset="1"/>
  </LinearGradientBrush>
  <x:Double x:Key="PlaybackSeekTrackHeight">4</x:Double>
  <x:Double x:Key="PlaybackBarButtonSize">32</x:Double>

  <!--
    Kesit B: oynat düğmesi şeridin ortasında ve diğerlerinden büyük. Üç sayı da var olan
    belirteçten geliyor, yenisi uydurulmadı:

      PlaybackPlayButtonSize   <- PlaybackBarButtonSize + Space1 (36). İnce şerit isteği.
      PlaybackPlayButtonWidth  <- PlaybackHandleHeight (48). İnce şerit isteği.
      PlaybackSliderWidth      <- PlaybackThumbnailWidth x 1.5 (192). Ses ve hız
                                  kaydırıcısı küçük resimden uzun: ses 5'in, hız 0.05'in
                                  katlarına oturuyor ve o basamakların hedefi büyüsün diye.
      PlaybackVolumeTick       <- ses kaydırıcısının basamağı (5).
      PlaybackSpeedTick        <- hız kaydırıcısının basamağı (0.05); 0.25 tabanından
                                  on beş basamak sonrası tam 1.00'e düşüyor.
  -->
  <x:Double x:Key="PlaybackPlayButtonSize">36</x:Double>
  <x:Double x:Key="PlaybackPlayButtonWidth">48</x:Double>
  <x:Double x:Key="PlaybackSliderWidth">192</x:Double>
  <x:Double x:Key="PlaybackVolumeTick">5</x:Double>
  <x:Double x:Key="PlaybackSpeedTick">0.05</x:Double>
  <StaticResource x:Key="PlaybackSliderTrackHeight" ResourceKey="ProgressBarHeight"/>
  <StaticResource x:Key="PlaybackSliderThumbSize" ResourceKey="SpaceLg"/>
  <CornerRadius x:Key="PlaybackSliderFilledTrackRadius">4,0,0,4</CornerRadius>
  <CornerRadius x:Key="PlaybackSliderEmptyTrackRadius">0,4,4,0</CornerRadius>
  <Thickness x:Key="PlaybackSliderFilledTrackOverlap">0,0,-8,0</Thickness>
  <Thickness x:Key="PlaybackSliderEmptyTrackOverlap">-8,0,0,0</Thickness>

  <x:Double x:Key="PlaybackThumbnailWidth">128</x:Double>
  <x:Double x:Key="PlaybackThumbnailHeight">72</x:Double>
  <x:Double x:Key="PlaybackThumbnailScale">5</x:Double>

  <x:Double x:Key="PlaybackMidShare">0.9</x:Double>

  <x:Double x:Key="PlaybackIdleMinHeight">512</x:Double>
  <x:Double x:Key="PlaybackZoomButtonSize">24</x:Double>
  <x:Double x:Key="PlaybackZoomButtonGap">8</x:Double>
  <x:Double x:Key="PlaybackBadgeGap">8</x:Double>
  <x:Double x:Key="PlaybackHoverZoom">2</x:Double>

  <x:Double x:Key="PlaybackIdleVeilOpacity">0.08</x:Double>

  <!--
    T79/K4: panonun iki zemini. Kare varken örtücü olanı (PlaybackStageFill), kaynak
    yüklenmemişken saydam olanı (PlaybackIdleVeil) duruyor. İkisi aynı renk; aralarındaki
    tek fark opaklık ve o da belirteçten geliyor.

    T82: panelin kendi yüzeyi artık buradan gelmiyor. Taban boydayken kabuk öteki
    panellerin belirtecini (PanelSurface) gösterir — saydamlığın ölçüsü eşitlik. Taban
    boyun üstünde ise kabuk da pano da örtücüdür: arkadaki anka görünmez.
  -->
  <SolidColorBrush x:Key="PlaybackStageFill" Color="{StaticResource AppBgColor}"/>
  <SolidColorBrush x:Key="PlaybackIdleVeil"
                   Color="{StaticResource AppBgColor}"
                   Opacity="{StaticResource PlaybackIdleVeilOpacity}"/>
  <SolidColorBrush x:Key="PlaybackPromotedShell" Color="{StaticResource AppBgColor}"/>

  <x:Double x:Key="PlaybackButtonIconSize">12</x:Double>
  <StreamGeometry x:Key="PlaybackMaximizeIcon">M0,0 H12 V12 H0 Z</StreamGeometry>
  <StreamGeometry x:Key="PlaybackFullScreenIcon">M0,4 V0 H4 M8,0 H12 V4 M12,8 V12 H8 M4,12 H0 V8</StreamGeometry>

  <x:Double x:Key="PlaybackScrimEdge">0.25</x:Double>
  <SolidColorBrush x:Key="PlaybackScrim" Color="{StaticResource PlaybackScrimColor}"/>
  <SolidColorBrush x:Key="PlaybackTitleScrim" Color="{StaticResource PlaybackTitleScrimColor}"/>

  <!--
    T79/K5: paravanın biçimi. Yonga ve düğme düz perdede kalıyor — oradaki kontrast oranı
    ölçülmüş bir sayı ve zemin sabit olmalı. Büyük yüzey, yani şeridin kendi örtüsü,
    artık üst kenarına doğru sönüyor: altından yukarı doğru son çeyreğinde (PlaybackScrimEdge)
    aynı rengin sıfır örtücülüklü haline geçiyor. Metin şeridin altında, yani perdenin
    tam örtücü yarısında duruyor; sönen çeyrek üstteki boş kenar.
  -->
  <LinearGradientBrush x:Key="PlaybackScrimVeil" StartPoint="50%,100%" EndPoint="50%,0%">
    <GradientStop Offset="0" Color="{StaticResource PlaybackScrimColor}"/>
    <GradientStop Offset="0.75" Color="{StaticResource PlaybackScrimColor}"/>
    <GradientStop Offset="1" Color="{StaticResource PlaybackScrimEdgeColor}"/>
  </LinearGradientBrush>

  <!--
    Ayırıcı. Çizginin kendisi hep görünür; tutamaç fare üstüne gelince ya da odak
    ayırıcıdayken belirginleşir. Sürükleme kare istemez — bu tema yalnız görünüştür.
  -->
  <ControlTheme x:Key="PlaybackSeparator" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
    <Setter Property="Width" Value="{StaticResource PlaybackSeparatorWidth}"/>
    <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
    <Style Selector="^.lit">
      <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackHandle" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource PlaybackHandleWidth}"/>
    <Setter Property="Height" Value="{StaticResource PlaybackHandleHeight}"/>
    <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    <Setter Property="Cursor" Value="SizeWestEast"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
        <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
    <Style Selector="^.lit">
      <Setter Property="Background" Value="{StaticResource NeonBlueHover}"/>
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
    </Style>
  </ControlTheme>

  <!-- Yan etiketi ve yakınlaştırma okumasını taşıyan yonga. Sayı mono, çerçevesi neon. -->
  <ControlTheme x:Key="PlaybackBadge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PlaybackScrim}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
    <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
  </ControlTheme>

  <Thickness x:Key="PlaybackMediaTitleMargin">24,44,24,0</Thickness>
  <x:Double x:Key="PlaybackMediaTitleMaxWidth">640</x:Double>

  <ControlTheme x:Key="PlaybackMediaTitle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PlaybackTitleScrim}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
    <Setter Property="Margin" Value="{StaticResource PlaybackMediaTitleMargin}"/>
    <Setter Property="MaxWidth" Value="{StaticResource PlaybackMediaTitleMaxWidth}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
        <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
    </Style>
    <Style Selector="^.menude">
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
      <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackMediaTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeLg}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="LetterSpacing" Value="{StaticResource TrackingMd}"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackThumbTime" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PlaybackScrim}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
  </ControlTheme>

  <!--
    T46/K3: tıkla yakınlaştırma düğmeleri. Gövdesi GhostButton'dan geliyor — yeni bir
    şablon yazılmadı; değişen yalnız oynatıcıya ait yüzey: perde zemin, mavi neon çerçeve
    ve kare bir dokunma hedefi. Uçlarda düğme devre dışıdır ve sönük durur.
  -->
  <ControlTheme x:Key="PlaybackZoomButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Width" Value="{StaticResource PlaybackZoomButtonSize}"/>
    <Setter Property="Height" Value="{StaticResource PlaybackZoomButtonSize}"/>
    <Setter Property="MinHeight" Value="{StaticResource PlaybackZoomButtonSize}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
    <Setter Property="Background" Value="{StaticResource PlaybackScrim}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Style Selector="^ /template/ Border#Root">
      <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    </Style>
    <Style Selector="^:pointerover /template/ Border#Root">
      <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    </Style>
    <Style Selector="^:disabled /template/ Border#Root">
      <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
    </Style>

    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{StaticResource TextDisabled}"/>
      <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackBadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
  </ControlTheme>

  <!-- Terfi ederken bandında kalan yer tutucu: aynı boyut, aynı yarıçap, boş yüzey. -->
  <ControlTheme x:Key="PlaybackPlaceholder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonPurpleBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}"/>
  </ControlTheme>

  <!--
    T40 — denetim şeridi. Normalde saydam (Opacity 0), fare panelin alt çeyreğine girince
    ya da klavye odağı içine düşünce belirir. Okunabilirliği arka planı değil kontrastı
    taşır: örtücü perde görüntünün üstünde durur ve metin beyaz mono kalır.
    T79/K5: perde artık düz değil — üst kenarına doğru sönen paravanı (PlaybackScrimVeil)
    kullanıyor, yani şeridin üst kenarı görüntüye keskin bir çizgiyle oturmuyor.
    İnce şerit isteği: kart, köşe, gölge ve üst kenar çizgisi kalktı; mavi yalnız zaman
    çubuğunda kalır, P24 şeridin üstünde çizgi olmadığını medya üstünde ölçer.
  -->
  <ControlTheme x:Key="PlaybackStrip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PlaybackScrimVeil}"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="{StaticResource PlaybackStripPadding}"/>
    <Setter Property="Margin" Value="{StaticResource PlaybackStripMargin}"/>
  </ControlTheme>

  <!-- Zaman çizgisi. Yol hep görünür; dolgu ve tutamaç süre bilinmiyorken gizlenir. -->
  <ControlTheme x:Key="PlaybackTrack" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource PlaybackTrackHeight}"/>
    <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <!--
      Odak zaman çizgisindeyken yol kalın ve parlak çerçeveye geçer. Odak rengi burada
      pembe değil mavi: pembe bu şeritte kodlama imlecinin rengi, ikisi karışmasın.
    -->
    <Style Selector="^.focused">
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
      <Setter Property="BorderThickness" Value="{StaticResource FocusRingThickness}"/>
    </Style>
    <!-- Süre bilinmiyorsa yol soluk çerçeveyle durur: sıfır değil, belirsiz. -->
    <Style Selector="^.unknown">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource TextDisabled}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackTrackFill" TargetType="Border">
    <Setter Property="Height" Value="{StaticResource PlaybackTrackHeight}"/>
    <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackThumb" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource PlaybackThumbSize}"/>
    <Setter Property="Height" Value="{StaticResource PlaybackThumbSize}"/>
    <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
    <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource BorderThin}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="BoxShadow" Value="{StaticResource GlowNone}"/>
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
    <Style Selector="^.lit">
      <Setter Property="BoxShadow" Value="{DynamicResource GlowBlue}"/>
    </Style>
  </ControlTheme>

  <!--
    K3: kodlama imleci. Oynatma tutamacı mavi ve yuvarlak, kodlama imleci pembe ve ince
    dikey çizgi — biçim de renk de ayrı, ikisi karışmaz.
  -->
  <ControlTheme x:Key="PlaybackEncodeCursor" TargetType="Border">
    <Setter Property="Width" Value="{StaticResource PlaybackCursorWidth}"/>
    <Setter Property="Background" Value="{StaticResource NeonPink}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GlowPink}"/>
  </ControlTheme>

  <!--
    Çipin zemini pembe dolgu değil perde. Şeridin kendi perdesinin üstüne ikinci bir perde
    binince görüntü ne olursa olsun zemin koyu kalıyor: beyaz karede pembe metnin kontrastı
    tek perdede 3,49:1 iken çift perdede 5,87:1'e çıkıyor (siyah karede 6,25:1).
  -->
  <ControlTheme x:Key="PlaybackEncodeChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource PlaybackScrim}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GlowPink}"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackEncodeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource PinkText}"/>
  </ControlTheme>

  <!--
    7b: oynatıcının kendi zaman çubuğu. Biçim şeridinkiyle aynı — renk, çerçeve, köşe ve
    odak kuralı oradan miras alınıyor, kopyalanmıyor. Değişen tek şey kalınlık, o da ayrı
    belirteçten geliyor.
  -->
  <ControlTheme x:Key="PlaybackSeekTrack" TargetType="Border" BasedOn="{StaticResource PlaybackTrack}">
    <Setter Property="Height" Value="{StaticResource PlaybackSeekTrackHeight}"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackSeekTrackFill" TargetType="Border" BasedOn="{StaticResource PlaybackTrackFill}">
    <Setter Property="Height" Value="{StaticResource PlaybackSeekTrackHeight}"/>
  </ControlTheme>

  <!--
    7b: alt şeridin düğmesi. Yüzü ChipButton'dan geliyor, yani şeritteki düğmelerle aynı
    görünüyor. Değişen tek şey dokunma hedefi: kare ve alan yüksekliğinde.
  -->
  <ControlTheme x:Key="PlaybackBarButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
    <Setter Property="MinWidth" Value="{StaticResource PlaybackBarButtonSize}"/>
    <Setter Property="MinHeight" Value="{StaticResource PlaybackBarButtonSize}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource ChipButton}">
    <Setter Property="MinWidth" Value="{StaticResource PlaybackBarButtonSize}"/>
    <Setter Property="MinHeight" Value="{StaticResource PlaybackBarButtonSize}"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Style Selector="^:checked">
      <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    </Style>
    <Style Selector="^:checked /template/ Border#Root">
      <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
      <Setter Property="BorderBrush" Value="{StaticResource NeonBlue}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackPlayButton" TargetType="Button" BasedOn="{StaticResource PlaybackBarButton}">
    <Setter Property="MinWidth" Value="{StaticResource PlaybackPlayButtonWidth}"/>
    <Setter Property="MinHeight" Value="{StaticResource PlaybackPlayButtonSize}"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackSliderFilledTrack" TargetType="RepeatButton" BasedOn="{StaticResource SliderFilledTrack}">
    <Setter Property="Template">
      <ControlTemplate TargetType="RepeatButton">
        <Panel Background="Transparent">
          <Border Name="FilledTrack"
                  Height="{StaticResource PlaybackSliderTrackHeight}"
                  Margin="{StaticResource PlaybackSliderFilledTrackOverlap}"
                  VerticalAlignment="Center"
                  Background="{StaticResource NeonBlue}"
                  BorderBrush="{StaticResource NeonBlue}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource PlaybackSliderFilledTrackRadius}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackSliderEmptyTrack" TargetType="RepeatButton" BasedOn="{StaticResource SliderEmptyTrack}">
    <Setter Property="Template">
      <ControlTemplate TargetType="RepeatButton">
        <Panel Background="Transparent">
          <Border Name="RemainingTrack"
                  Height="{StaticResource PlaybackSliderTrackHeight}"
                  Margin="{StaticResource PlaybackSliderEmptyTrackOverlap}"
                  VerticalAlignment="Center"
                  Background="{StaticResource NeonBlueFill}"
                  BorderBrush="{StaticResource NeonBlueBorderStrong}"
                  BorderThickness="{StaticResource BorderThin}"
                  CornerRadius="{StaticResource PlaybackSliderEmptyTrackRadius}"/>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackSliderThumb" TargetType="Thumb">
    <Setter Property="FocusAdorner" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="Thumb">
        <Panel Background="Transparent">
          <Ellipse Name="Knob"
                   Width="{StaticResource PlaybackSliderThumbSize}"
                   Height="{StaticResource PlaybackSliderThumbSize}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Fill="{StaticResource AppBg}"
                   Stroke="{StaticResource NeonBlue}"
                   StrokeThickness="{StaticResource SliderThumbStroke}"
                   RenderTransform="none">
            <Ellipse.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionInstant}" Easing="CubicEaseOut"/>
              </Transitions>
            </Ellipse.Transitions>
          </Ellipse>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#Knob">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="^.ustunde /template/ Ellipse#Knob">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="^.odak /template/ Ellipse#Knob">
      <Setter Property="RenderTransform" Value="scale(1.1)"/>
    </Style>
    <Style Selector="^:pressed /template/ Ellipse#Knob">
      <Setter Property="RenderTransform" Value="scale(1.2)"/>
      <Setter Property="Fill" Value="{StaticResource NeonBlue}"/>
    </Style>
    <Style Selector="^.basili /template/ Ellipse#Knob">
      <Setter Property="RenderTransform" Value="scale(1.2)"/>
      <Setter Property="Fill" Value="{StaticResource NeonBlue}"/>
    </Style>
    <Style Selector="^:disabled /template/ Ellipse#Knob">
      <Setter Property="RenderTransform" Value="none"/>
      <Setter Property="Stroke" Value="{StaticResource TextDisabled}"/>
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
    <Setter Property="MaxWidth" Value="{StaticResource PlaybackSliderWidth}"/>
    <Setter Property="Height" Value="{StaticResource PlaybackBarButtonSize}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <ControlTemplate TargetType="Slider">
        <Border Name="Root" Background="Transparent" Padding="{StaticResource SliderTrackPadding}">
          <Panel>
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value, Mode=TwoWay}"
                   Orientation="{TemplateBinding Orientation}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource PlaybackSliderFilledTrack}" Focusable="False"/>
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource PlaybackSliderEmptyTrack}" Focusable="False"/>
              </Track.IncreaseButton>
              <Track.Thumb>
                <Thumb Name="ThumbVisual"
                       Theme="{StaticResource PlaybackSliderThumb}"
                       Width="{StaticResource PlaybackSliderThumbSize}"/>
              </Track.Thumb>
            </Track>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackValueChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource NeonBlueFill}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
    <Setter Property="Padding" Value="{StaticResource ChipPadding}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackValueText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource NeonBlue}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </ControlTheme>


  <!-- Süre okuması. Sayı olduğu için mono; rengi beyaz, kontrastı perdeden alır. -->
  <ControlTheme x:Key="PlaybackValueTextBright" TargetType="TextBlock" BasedOn="{StaticResource PlaybackValueText}">
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
  </ControlTheme>

  <ControlTheme x:Key="PlaybackTimeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeSm}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
  </ControlTheme>

</ResourceDictionary>
