<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

  <!--
    K6: burada tanımlanan her belirteç Theme.axaml'daki bir belirtecin değerini alır.
    Yeni ölçü üretilmiyor; yalnız kaydediciye ait ad veriliyor.

    Renk hiç tanımlanmıyor. Kaydediyor göstergesinin rengi Theme.axaml'ın NeonEmber
    fırçasıdır ve görünümde doğrudan o çağrılıyor: ikinci bir ton üretmemek için burada
    fırça açılmadı, dolayısıyla palet değiştiğinde gösterge de paletle birlikte değişir.

      RecorderStripPadding    <- ButtonPaddingSm (16,8). Denetim şeridi tek sıra düğmeden
                                 oluşuyor; iç boşluğu da o düğmelerin kendi boşluğu.
      RecorderStripGap        <- SpaceSm (8). Şeritteki iki öğe arası.
      RecorderStatsInset      <- SpaceLg (16), soldan. Durum sözcüğü ("Boşta") ile sayaç
                                 grubunun ilk etiketi ("Geçen") 8 px'le bitişik okunuyordu;
                                 grup aralığı (8 + 16 = 24) sayaçların kendi aralığına (SpaceXl) eşit.
      RecorderButtonSize      <- FieldMinHeight (40). Şerit düğmesinin dokunma hedefi;
                                 alan yüksekliğiyle aynı sayı, şerit tek satır okunuyor.
      RecorderDotSize         <- SpaceMd (12). Kaydediyor göstergesinin çapı.
      RecorderAudioLevelGap   <- SpaceSm (8) soldan, LabelMargin'in alt payı (8) alttan. Ses
                                 seviyesi çubuğu cihaz etiketinin satırında, yazının sağında ve
                                 onunla ortalı durur; sayfaya yükseklik eklemez. Yüksekliği
                                 ProgressBar temasının ProgressBarHeight'ı, rengi temanın fırçaları.
      RecorderWizardOptionSize<- DropZoneMinHeight (144). Otomatik ayar sorusunun kare
                                 seçenek düğmesi; tek tıkla seçilen en büyük hedef.

    Mini kip belirteçleri. Yeni sayı yine üretilmiyor; üçü de yukarıdakilerden türüyor.

      RecorderMiniHeight      <- RecorderButtonSize + 2 × SpaceSm = 40 + 16 = 56. Yani
                                 bugünkü şeridin yüksekliği; saha taramasının 30-64
                                 aralığının ortasında, yeni bir ölçü gerekmiyor.
      RecorderMiniPadding     <- SpaceLg - BorderThin, SpaceSm - BorderThin = 15,7. Panel
                                 kenarlığı 56'nın içinden yiyor; 8'lik pay 40'lık düğmeyi
                                 38'lik iç alana sığdırmıyordu. 1 + 15 = 16 ile her kenar
                                 çift sayıya düşüyor, 1.5 ölçekte piksel ızgarasına oturuyor.
      RecorderMiniGroupGap    <- SpaceLg (16). Şeritteki üç grubun (oynat/durdur, sayaç,
                                 seçenek/büyüt) arası; grup içi RecorderStripGap (8).
      RecorderMiniReadoutWidth<- MonoValue temasıyla "00:00:00" metninin ölçülen
                                 genişliğinin SpaceMd katına yuvarlanmışı. Göz kararı
                                 değil: ölçüm MiniKipOlcusuTests'te koşuyor, kanıt
                                 .calisma/mini-olcu/sayac.txt. 136'lık okuma genişliği
                                 iki satırlık düzen için; mini kipte sayaç tek satır.
      RecorderMiniMinWidth    <- Şeridin kendi toplamı: 16 + 12 + 8 + 72 + 8 + 40 + 8 +
                                 40 + 8 + 40 + 16 = 268, SpaceMd katına yuvarlanınca
                                 276. Yani kenar payı, nokta, sayaç, üç düğme ve
                                 aralarındaki SpaceSm boşluklar.
      RecorderMiniTipDelay    <- Avalonia 12'nin ipucu varsayılanı olan 400 ms'ye 1000 ms eklenmiş hali,
                                 1400 ms: fare durduktan sonra ipucunun açılma beklemesi (ToolTip.ShowDelay).
                                 İpucu kendiliğinden kapanmaz, fare çıkana ya da basana kadar açık kalır;
                                 bu başsız testte sayaç ilerlerken de ölçüldü. Şeritte yalnız bu uzatıldı.
      RecorderPreviewWidth    <- RecorderArguments.PreviewWidth (320). Canlı önizleme
                                 karesi ffmpeg'in yazdığı boyutta, ölçeklenmeden çizilir.

    Bölge düzenleyicinin araç paneli. Kaydın üstünde duruyor, ekranda en az yer tutmalı.

      RecorderRegionButtonSize<- FieldMinHeight (40). Panelde yalnız simge düğmesi var;
                                 kare, alan yüksekliğinde, kayıt sırasında da isabetle basılır.
      RecorderRegionButtonRadius <- RadiusSquare. Düğmeler yuvarlak değil kare.
      RecorderRegionIconSize  <- IconSizeMd (22). Düğmenin içindeki vektör simge.
      RecorderRegionButtonGap <- SpaceXs (4). Kare düğmeler arasındaki boşluk.
      RecorderRegionSnap      <- SpaceLg (16). Kenar bu uzaklıkta pencereye ya da ekran
                                 kenarına oturur; Alt basılıyken oturmaz.
      RecorderRegionSnapLine  <- SpaceXs (4). Oturulan kenarı gösteren vurgu çizgisi.
      RecorderRegionDash      <- SpaceSm (8). Kurulumda kenar kesik çizgili: 8 DIP çizgi,
                                 8 DIP boşluk; kayıtta düz.
      RecorderRegionToolbarPadding <- FocusRingScalar (2). Kenarda yalnız klavye odak
                                 halkasının sığacağı pay.

    Kayıt bitince köşede açılan sonuç kartı.

      RecorderResultCardThumbWidth  <- PlaybackThumbnailWidth (128). Oynatıcının önizleme
                                 karesiyle aynı küçük resim; ikinci bir boyut üretilmiyor.
      RecorderResultCardThumbHeight <- PlaybackThumbnailHeight (72), genişliğin 16:9'u.
      RecorderResultCardGap   <- SpaceLg (16). Kartın çalışma alanının köşesinden uzaklığı.
      RecorderResultCardHold  <- 6 sn. Kart bu süre sonunda kendiliğinden kapanır; imleç
                                 üstündeyken kapanmaz, imleç çıkınca süre baştan sayılır.

    Son kayıtlar penceresi.

      RecorderHistoryWidth    <- TipMaxWidth (420). Kuyruk pencereleriyle aynı en; satırda sonuç
                                 kartının küçük resmi ve yanında ad ile ayrıntı.
      RecorderHistoryHeight   <- PlanPanelMaxHeight (576). Oynatıcının geçmiş penceresiyle aynı boy.

    Ekrana çizim.

      RecorderSketchStroke     <- RecorderClickRingThickness (4). Kalem, ok ve kutu, tıklama halkasıyla
                                  aynı kalınlıkta; kayıtta ikisi aynı dilden okunur.
      RecorderSketchArrowHead  <- SpaceXl (24). Ok başı kanadının boyu.
      RecorderSketchNumberSize <- RecorderPointerRingSmall (32). Numara dairesinin çapı, küçük imleç halkası kadar.
      RecorderSketchFont       <- FontSizeHero. Yazı aracının ve numaranın yazı boyu kayıtta okunacak büyüklükte.

    Prompter.

      RecorderPrompterWidth  <- TipMaxWidth (420). Kameranın yanına sığacak kadar dar; satır göz gezdirmeden okunur.
      RecorderPrompterHeight <- PlanPanelMaxHeight (576). Geçmiş penceresiyle aynı boy.
      RecorderPrompterFont   <- FontSizeHero. Okuma kipinde metin bir kol boyu uzaktan okunur; en büyük basamak.
      RecorderPrompterFontMd <- FontSize4 (24). Orta basamak; kamera yakınken.
      RecorderPrompterFontSm <- FontSizeLg (20). Küçük basamak; uzun metin tek bakışta.
      RecorderPrompterLine   <- FocusWidth (2). Okuma çizgisinin kalınlığı, odak halkasıyla aynı.

    Sonuç panelindeki hızlı kırpma açılırı.

      RecorderQuickTrimWidth       <- TipMaxWidth (420). Açılır bir ipucu balonu kadar geniş;
                                      şerit ve iki tutamak aynı eni paylaşır.
      RecorderQuickTrimThumbHeight <- PlaybackBarButtonSize (32). Düzenleyicinin küçük resim
                                      şeridiyle aynı yükseklik.
  -->

  <Thickness x:Key="RecorderStripPadding">16,8</Thickness>
  <x:Double x:Key="RecorderStripGap">8</x:Double>
  <Thickness x:Key="RecorderStatsInset">16,0,0,0</Thickness>
  <x:Double x:Key="RecorderButtonSize">40</x:Double>
  <x:Double x:Key="RecorderDotSize">12</x:Double>
  <Thickness x:Key="RecorderAudioLevelGap">8,0,0,8</Thickness>
  <x:Double x:Key="RecorderWizardOptionSize">144</x:Double>

  <x:Double x:Key="RecorderMiniHeight">56</x:Double>
  <Thickness x:Key="RecorderMiniPadding">15,7</Thickness>
  <StaticResource x:Key="RecorderMiniGroupGap" ResourceKey="SpaceLg"/>
  <x:Double x:Key="RecorderMiniReadoutWidth">72</x:Double>
  <x:Double x:Key="RecorderMiniMinWidth">276</x:Double>
  <x:Int32 x:Key="RecorderMiniTipDelay">1400</x:Int32>
  <x:Double x:Key="RecorderPreviewWidth">320</x:Double>

  <Thickness x:Key="RecorderFrameBorder">2</Thickness>
  <x:Double x:Key="RecorderFrameThickness">2</x:Double>
  <x:Double x:Key="RecorderPickerScrimOpacity">0.5</x:Double>
  <StaticResource x:Key="RecorderPickerBarGap" ResourceKey="SpaceXl"/>
  <x:Double x:Key="RecorderCompactWindowWidth">640</x:Double>
  <x:Double x:Key="RecorderCompactWindowHeight">720</x:Double>
  <x:Double x:Key="RecorderRegionHandle">12</x:Double>
  <x:Double x:Key="RecorderRegionGrip">4</x:Double>
  <x:Double x:Key="RecorderRegionToolbarGap">4</x:Double>
  <Thickness x:Key="RecorderRegionToolbarPadding">2</Thickness>
  <StaticResource x:Key="RecorderRegionButtonSize" ResourceKey="FieldMinHeight"/>
  <StaticResource x:Key="RecorderRegionButtonRadius" ResourceKey="RadiusSquare"/>
  <StaticResource x:Key="RecorderRegionIconSize" ResourceKey="IconSizeMd"/>
  <StaticResource x:Key="RecorderRegionButtonGap" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="RecorderRegionSnap" ResourceKey="SpaceLg"/>
  <StaticResource x:Key="RecorderRegionSnapLine" ResourceKey="SpaceXs"/>
  <StaticResource x:Key="RecorderRegionDash" ResourceKey="SpaceSm"/>

  <x:Double x:Key="RecorderClickRingSize">48</x:Double>
  <x:Double x:Key="RecorderClickRingThickness">4</x:Double>
  <x:Double x:Key="RecorderPointerRingSmall">32</x:Double>
  <x:Double x:Key="RecorderPointerRingLarge">72</x:Double>
  <x:Double x:Key="RecorderSpotlightSize">160</x:Double>
  <StaticResource x:Key="RecorderSpotlightOpacity" ResourceKey="RecorderPickerScrimOpacity"/>
  <sys:TimeSpan x:Key="RecorderClickRingHold">00:00:00.3600000</sys:TimeSpan>
  <sys:TimeSpan x:Key="RecorderKeyCaptionHold">00:00:01.5000000</sys:TimeSpan>
  <sys:TimeSpan x:Key="RecorderKeyCaptionHoldShort">00:00:00.8000000</sys:TimeSpan>
  <sys:TimeSpan x:Key="RecorderKeyCaptionHoldLong">00:00:03</sys:TimeSpan>
  <StaticResource x:Key="RecorderKeyCaptionFontSmall" ResourceKey="FontSize1"/>
  <StaticResource x:Key="RecorderKeyCaptionFontMedium" ResourceKey="FontSizeMd"/>
  <StaticResource x:Key="RecorderKeyCaptionFontLarge" ResourceKey="FontSizeHero"/>
  <x:Double x:Key="RecorderKeyCaptionGap">24</x:Double>
  <x:Double x:Key="RecorderMagnifierSize">144</x:Double>
  <x:Double x:Key="RecorderMagnifierZoom">2</x:Double>
  <x:Double x:Key="RecorderMagnifierGap">24</x:Double>
  <sys:TimeSpan x:Key="RecorderMagnifierInterval">00:00:00.0333333</sys:TimeSpan>
  <StaticResource x:Key="RecorderResultCardThumbWidth" ResourceKey="PlaybackThumbnailWidth"/>
  <StaticResource x:Key="RecorderResultCardThumbHeight" ResourceKey="PlaybackThumbnailHeight"/>
  <StaticResource x:Key="RecorderResultCardGap" ResourceKey="SpaceLg"/>
  <sys:TimeSpan x:Key="RecorderResultCardHold">00:00:06</sys:TimeSpan>
  <StaticResource x:Key="RecorderHistoryWidth" ResourceKey="TipMaxWidth"/>
  <StaticResource x:Key="RecorderHistoryHeight" ResourceKey="PlanPanelMaxHeight"/>
  <StaticResource x:Key="RecorderSketchStroke" ResourceKey="RecorderClickRingThickness"/>
  <StaticResource x:Key="RecorderSketchArrowHead" ResourceKey="SpaceXl"/>
  <StaticResource x:Key="RecorderSketchNumberSize" ResourceKey="RecorderPointerRingSmall"/>
  <StaticResource x:Key="RecorderSketchFont" ResourceKey="FontSizeHero"/>
  <StaticResource x:Key="RecorderPrompterWidth" ResourceKey="TipMaxWidth"/>
  <StaticResource x:Key="RecorderPrompterHeight" ResourceKey="PlanPanelMaxHeight"/>
  <StaticResource x:Key="RecorderPrompterFont" ResourceKey="FontSizeHero"/>
  <StaticResource x:Key="RecorderPrompterFontMd" ResourceKey="FontSize4"/>
  <StaticResource x:Key="RecorderPrompterFontSm" ResourceKey="FontSizeLg"/>
  <StaticResource x:Key="RecorderPrompterLine" ResourceKey="FocusWidth"/>
  <StaticResource x:Key="RecorderQuickTrimWidth" ResourceKey="TipMaxWidth"/>
  <StaticResource x:Key="RecorderQuickTrimThumbHeight" ResourceKey="PlaybackBarButtonSize"/>

</ResourceDictionary>
