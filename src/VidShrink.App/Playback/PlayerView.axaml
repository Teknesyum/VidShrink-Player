<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auto="using:Avalonia.Automation"
             xmlns:loc="using:VidShrink.App.Localization"
             xmlns:playback="using:VidShrink.App.Playback"
             x:Class="VidShrink.App.Playback.PlayerView"
             Focusable="True"
             Loaded="OnSeritLoaded">

  <UserControl.Styles>
    <Style Selector="Border#MediaTitle">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
    <Style Selector="Border#MediaTitle.dolu">
      <Setter Property="IsVisible" Value="True"/>
    </Style>
    <Style Selector="Window.chrome-hidden Border#MediaTitle">
      <Setter Property="IsVisible" Value="False"/>
    </Style>
  </UserControl.Styles>

  <!--
    Kesit B: sayfanin tek satiri kaldi. Baslik, ses/altyazi parcasi dugmeleri ve uc nokta
    kalkti; ucunun de karsiligi sag klik menusunde duruyor. Zaman cubugu, denetim seridi ve
    tanilama satirlari yerlesimde yer kaplamiyor — hepsi panonun ustune binen katmanlar.
  -->
  <Grid>

    <Border x:Name="Stage"
            Theme="{StaticResource Panel}"
            Background="{StaticResource AppBg}"
            BorderThickness="0"
            CornerRadius="0"
            Padding="0">
      <Panel x:Name="Surface" Background="Transparent" ClipToBounds="True">
        <Image x:Name="Frame" Stretch="Fill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border x:Name="PauseGlyph"
                IsVisible="False"
                IsHitTestVisible="False"
                Opacity="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RenderTransform="scale(0.8)">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}"/>
              <TransformOperationsTransition Property="RenderTransform" Duration="{StaticResource MotionFast}"/>
            </Transitions>
          </Border.Transitions>
          <Panel>
            <Path x:Name="PauseGlyphIcon" Width="{StaticResource PauseGlyphSize}"
                  Height="{StaticResource PauseGlyphSize}"
                  Stretch="Uniform"
                  Data="{StaticResource IconPause}"
                  Fill="{StaticResource NeonBlue}"/>
            <Path x:Name="PauseGlyphGloss" Width="{StaticResource PauseGlyphSize}"
                  Height="{StaticResource PauseGlyphSize}"
                  Stretch="Uniform"
                  Data="{Binding #PauseGlyphIcon.Data}"
                  Fill="{StaticResource PauseGlyphGloss}"/>
          </Panel>
        </Border>
        <Border x:Name="EndCue"
                IsVisible="False"
                IsHitTestVisible="False"
                Opacity="0"
                Background="{x:Null}"
                BorderBrush="{StaticResource NeonBlue}"
                BorderThickness="{StaticResource EndCueThickness}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"/>
        <SarilanMetin x:Name="TxtEmpty"
                   Text="{loc:Text main.player.empty}"
                   Theme="{StaticResource MonoValue}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <SarilanMetin x:Name="TxtEngine"
                   Theme="{StaticResource StatusError}"
                   IsVisible="False"
                   Margin="{StaticResource PlaybackBadgeMargin}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"/>

        <Border x:Name="AudioCard"
                Theme="{StaticResource PlaybackBadge}"
                IsVisible="False"
                IsHitTestVisible="False"
                Opacity="0"
                Margin="{StaticResource PlaybackBadgeMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}"/>
            </Transitions>
          </Border.Transitions>
          <StackPanel Spacing="{StaticResource PlaybackBadgeGap}">
            <StackPanel x:Name="AudioBars"
                        Classes="eq"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpaceXs}"
                        Height="{StaticResource SpaceXl}">
              <StackPanel.Styles>
                <Style Selector="StackPanel.eq > Border">
                  <Setter Property="Width" Value="{StaticResource SpaceXs}"/>
                  <Setter Property="VerticalAlignment" Value="Bottom"/>
                  <Setter Property="Height" Value="{StaticResource SpaceXl}"/>
                  <Setter Property="Background" Value="{StaticResource NeonBlue}"/>
                  <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}"/>
                  <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
                </Style>
                <Style Selector="StackPanel.eq.playing > Border.b1">
                  <Style.Animations>
                    <Animation Duration="0:0:0.85" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="LinearEasing">
                      <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.25"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="0.9"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
                <Style Selector="StackPanel.eq.playing > Border.b2">
                  <Style.Animations>
                    <Animation Duration="0:0:0.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="LinearEasing">
                      <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.45"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
                <Style Selector="StackPanel.eq.playing > Border.b3">
                  <Style.Animations>
                    <Animation Duration="0:0:0.95" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="LinearEasing">
                      <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.2"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="0.7"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
                <Style Selector="StackPanel.eq.playing > Border.b4">
                  <Style.Animations>
                    <Animation Duration="0:0:0.7" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="LinearEasing">
                      <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.35"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="1"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
                <Style Selector="StackPanel.eq.playing > Border.b5">
                  <Style.Animations>
                    <Animation Duration="0:0:1.05" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="LinearEasing">
                      <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleY" Value="0.3"/></KeyFrame>
                      <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleY" Value="0.8"/></KeyFrame>
                    </Animation>
                  </Style.Animations>
                </Style>
              </StackPanel.Styles>
              <Border Classes="b1"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
              <Border Classes="b2"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
              <Border Classes="b3"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
              <Border Classes="b4"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
              <Border Classes="b5"><Border.RenderTransform><ScaleTransform ScaleY="0.2"/></Border.RenderTransform></Border>
            </StackPanel>
            <SarilanMetin x:Name="TxtAudioTitle" Theme="{StaticResource DropTitle}"/>
            <SarilanMetin x:Name="TxtAudioArtist"
                       Theme="{StaticResource PlaybackBadgeText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!--
          Bilgi rozeti ve tanilama satirlari. Dort duz metin satiri sayfadan kalkti ama
          agactan kalkmadi: okuyuculari duruyor, artik yalnizca bilgi panosu acikken
          gorunuyorlar. Gorunurluk kodla degil rozetin kendi bayragina baglanarak
          suruluyor, boylece durumu tek yerden geliyor.
        -->
        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="{StaticResource PlaybackBadgeMargin}"
                    Spacing="{StaticResource PlaybackBadgeGap}">
          <Border x:Name="OsdBadge"
                  Theme="{StaticResource PlaybackBadge}"
                  HorizontalAlignment="Left"
                  IsVisible="False"
                  IsHitTestVisible="False"
                  Opacity="0"
                  auto:AutomationProperties.LiveSetting="Polite">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="{StaticResource MotionFast}"/>
              </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
              <Grid x:Name="OsdSpeedGlyph" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"
                    VerticalAlignment="Center" IsVisible="False">
                <Path x:Name="GlyphOsdSpeed" Stretch="Uniform"
                      Data="{StaticResource IconSpeedSlow}" Fill="{Binding #TxtOsd.Foreground}"/>
                <Path x:Name="GlyphOsdSpeedTip" Stretch="Uniform" IsVisible="False"
                      Data="{StaticResource IconSpeedFastTip}" Fill="{StaticResource EmberFlameGlyph}"/>
              </Grid>
              <SarilanMetin x:Name="TxtOsd" Theme="{StaticResource PlaybackTimeText}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <Border x:Name="InfoPanel" Theme="{StaticResource PlaybackBadge}" IsVisible="False">
            <StackPanel Spacing="{StaticResource SpaceXs}">
              <SarilanMetin x:Name="TxtInfo" Theme="{StaticResource PlaybackTimeText}"/>
              <Button x:Name="BtnInfoDetails" Theme="{StaticResource GhostButton}" HorizontalAlignment="Left"
                      Content="{loc:Text mediainfo.open}" auto:AutomationProperties.Name="{loc:Text mediainfo.open}"
                      Click="OnInfoDetails"/>
            </StackPanel>
          </Border>
          <Border x:Name="DiagPanel"
                  Theme="{StaticResource PlaybackBadge}"
                  IsVisible="{Binding #InfoPanel.IsVisible}">
            <StackPanel Spacing="{StaticResource SpaceXs}">
              <SarilanMetin x:Name="TxtView" Theme="{StaticResource MonoValue}" TextWrapping="Wrap" IsVisible="False"/>
              <SarilanMetin x:Name="TxtState" Theme="{StaticResource MonoValue}" TextWrapping="Wrap"/>
              <SarilanMetin x:Name="TxtControls" Theme="{StaticResource MonoValue}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Takilma ve hata bildirimi tanilamaya bagli degil: kendi bayragiyla gorunur. -->
        <Border Theme="{StaticResource PlaybackBadge}"
                Margin="{StaticResource PlaybackBadgeMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsVisible="{Binding #TxtStall.IsVisible}">
          <SarilanMetin x:Name="TxtStall"
                     Theme="{StaticResource MonoValue}"
                     TextWrapping="Wrap"
                     IsVisible="False"
                     Foreground="{StaticResource EmberBlaze}"/>
        </Border>

        <Border x:Name="GoToBox"
                Theme="{StaticResource PlaybackBadge}"
                Margin="{StaticResource PlaybackBadgeMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="False">
          <TextBox x:Name="GoToText"
                   Width="{StaticResource NumberBoxWidth}"
                   PlaceholderText="{loc:Text player.goto.hint}"
                   auto:AutomationProperties.Name="{loc:Text main.player.menu.goto}"/>
        </Border>

        <Border x:Name="ResumeBox"
                Theme="{StaticResource PlaybackBadge}"
                Margin="{StaticResource PlaybackBadgeMargin}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsVisible="False">
          <StackPanel Spacing="{StaticResource PlaybackBadgeGap}">
            <SarilanMetin Text="{loc:Text player.resume.ask}"
                       Theme="{StaticResource PlaybackBadgeText}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="{StaticResource PlaybackBadgeGap}">
              <Button x:Name="BtnResumeContinue" Content="{loc:Text player.resume.continue}"
                      Theme="{StaticResource PrimaryButton}" Click="OnResumeContinue"/>
              <Button x:Name="BtnResumeRestart" Content="{loc:Text player.resume.restart}"
                      Theme="{StaticResource GhostButton}" Click="OnResumeRestart"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border x:Name="MediaTitle" Theme="{StaticResource PlaybackMediaTitle}" Classes="reveal">
          <SarilanMetin x:Name="TxtMediaTitle" Theme="{StaticResource PlaybackMediaTitleText}"/>
        </Border>

        <Canvas x:Name="ThumbLayer" IsHitTestVisible="False">
          <StackPanel x:Name="ThumbChip" Spacing="{StaticResource SpaceXs}" IsVisible="False">
            <Image x:Name="ThumbImage"
                   Width="{StaticResource PlaybackThumbnailWidth}"
                   Height="{StaticResource PlaybackThumbnailHeight}"
                   Stretch="Fill"/>
            <Border Theme="{StaticResource PlaybackThumbTime}" HorizontalAlignment="Center">
              <SarilanMetin x:Name="ThumbTime" Theme="{StaticResource PlaybackTimeText}"/>
            </Border>
          </StackPanel>
        </Canvas>

        <!--
          7b/K1: otomatik gizlenen alt serit. Gizliyken IsVisible degil Opacity sifirdir —
          klavye odagi icine dusunce belirmesi gerekiyor ve yerlesim olculeri (zaman
          cubugunun genisligi) gizliyken de dogru kalmali. Fareye gorunmez olmasi
          IsHitTestVisible ile kod tarafinda suruluyor.
        -->
        <Border x:Name="StripBar"
                FlowDirection="LeftToRight"
                Theme="{StaticResource PlaybackStrip}"
                VerticalAlignment="Bottom"
                Opacity="0"
                IsHitTestVisible="False"
                auto:AutomationProperties.Name="{loc:Text playback.control.strip}">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="{StaticResource SpaceXs}">

            <Panel Grid.Row="0"
                   x:Name="SeekBar"
                   Height="{StaticResource PlaybackSeekBarHeight}"
                   Background="Transparent"
                   Cursor="Hand"
                   auto:AutomationProperties.Name="{loc:Text playback.control.timeline}">
              <Border x:Name="SeekTrack" Theme="{StaticResource PlaybackSeekTrack}" VerticalAlignment="Center"/>
              <Border x:Name="SeekFill"
                      Theme="{StaticResource PlaybackSeekTrackFill}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      Background="Transparent"
                      Width="0"
                      IsVisible="False">
                <Border x:Name="SeekSpan"
                        HorizontalAlignment="Left"
                        Background="{StaticResource PlaybackSeekSpan}"/>
              </Border>
              <Border x:Name="SeekShimmer"
                      Classes="shimmer"
                      Width="{StaticResource PlaybackSeekShimmerWidth}"
                      Height="{StaticResource PlaybackSeekTrackHeight}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      IsVisible="False"
                      Opacity="0"
                      Background="{StaticResource PlaybackSeekShimmer}"
                      CornerRadius="{StaticResource RadiusChip}">
                <Border.RenderTransform>
                  <TranslateTransform X="0"/>
                </Border.RenderTransform>
                <Border.Styles>
                  <Style Selector="Border.shimmer.run">
                    <Style.Animations>
                      <Animation Duration="0:0:1.4" Easing="CubicEaseOut" FillMode="Forward">
                        <KeyFrame Cue="0%">
                          <Setter Property="Opacity" Value="0"/>
                          <Setter Property="TranslateTransform.X" Value="-24"/>
                        </KeyFrame>
                        <KeyFrame Cue="35%">
                          <Setter Property="Opacity" Value="0.85"/>
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                          <Setter Property="Opacity" Value="0"/>
                          <Setter Property="TranslateTransform.X" Value="-4"/>
                        </KeyFrame>
                      </Animation>
                    </Style.Animations>
                  </Style>
                </Border.Styles>
              </Border>
              <Border x:Name="SeekHead"
                      Width="{StaticResource PlaybackSeekHeadWidth}"
                      Height="{StaticResource PlaybackSeekBarHeight}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      IsVisible="False"
                      Background="{StaticResource NeonBlue}"
                      CornerRadius="{StaticResource RadiusChip}"
                      BoxShadow="{DynamicResource GlowBlue}"/>
              <Canvas x:Name="SeekMarkLayer" IsHitTestVisible="False"/>
            </Panel>

            <!--
              Kesit B: uc oberk. Solda sure okumasi ve ses, ortada -10 / oynat / +10,
              sagda hiz. Oynat dugmesi ortadaki obegin ortasinda durdugu icin izgara
              simetrik: iki yan sutun da yildiz, ortadaki Auto.
            -->
            <Grid Grid.Row="1" x:Name="StripRow" ColumnDefinitions="*,Auto,*" ColumnSpacing="{StaticResource SpaceLg}">

              <Grid Grid.Column="0"
                    ColumnSpacing="{StaticResource SpaceMd}"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*" MaxWidth="{StaticResource PlaybackSliderWidth}"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <SarilanMetin x:Name="TxtSeritTime"
                           Theme="{StaticResource PlaybackTimeText}"
                           Background="Transparent"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="BtnSeritMute" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.mute}">
                  <Path x:Name="GlyphSeritVolume"
                        Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                        Data="{StaticResource IconVolume}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Slider Grid.Column="2" x:Name="SliderSeritVolume"
                        Theme="{StaticResource PlaybackSlider}"
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="{StaticResource PlaybackVolumeTick}"
                        IsSnapToTickEnabled="True"/>
                <Border Grid.Column="3" x:Name="ChipSeritVolume" Theme="{StaticResource PlaybackValueChip}">
                  <SarilanMetin x:Name="TxtSeritVolume" Theme="{StaticResource PlaybackValueTextBright}"/>
                </Border>
              </Grid>

              <StackPanel Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="{StaticResource SpaceMd}"
                          VerticalAlignment="Center">
                <Button x:Name="BtnSeritBack" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.seek}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                    <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                          Data="{StaticResource IconRewind}" Fill="{Binding $parent[Button].Foreground}"/>
                    <SarilanMetin x:Name="TxtSeritBack" Theme="{StaticResource PlaybackValueText}"
                               Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnSeritPlay" Theme="{StaticResource PlaybackPlayButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.playpause}">
                  <Path x:Name="GlyphSeritPlay"
                        Width="{StaticResource IconSizeLg}" Height="{StaticResource IconSizeLg}" Stretch="Uniform"
                        Data="{StaticResource IconPlay}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button x:Name="BtnSeritForward" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.seek}">
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}">
                    <SarilanMetin x:Name="TxtSeritForward" Theme="{StaticResource PlaybackValueText}"
                               Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center"/>
                    <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                          Data="{StaticResource IconFastForward}" Fill="{Binding $parent[Button].Foreground}"/>
                  </StackPanel>
                </Button>
              </StackPanel>

              <Grid Grid.Column="2"
                    ColumnSpacing="{StaticResource SpaceMd}"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*" MaxWidth="{StaticResource PlaybackSliderWidth}"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="1" x:Name="BtnSeritSpeedAb" Theme="{StaticResource PlaybackToggleButton}"
                              auto:AutomationProperties.Name="{loc:Text main.player.menu.speedab}">
                  <Grid x:Name="SeritSpeedGlyph" Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}"
                        VerticalAlignment="Center">
                    <Path x:Name="GlyphSeritSpeed" Stretch="Uniform"
                          Data="{StaticResource IconSpeedSlow}" Fill="{Binding $parent[ToggleButton].Foreground}"/>
                    <Path x:Name="GlyphSeritSpeedTip" Stretch="Uniform" IsVisible="False"
                          Data="{StaticResource IconSpeedFastTip}" Fill="{StaticResource EmberFlameGlyph}"/>
                  </Grid>
                </ToggleButton>
                <Slider Grid.Column="2" x:Name="SliderSeritSpeed"
                        Theme="{StaticResource PlaybackSlider}"
                        TickFrequency="{StaticResource PlaybackSpeedTick}"
                        IsSnapToTickEnabled="True"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.faster}"/>
                <Border Grid.Column="3" x:Name="ChipSeritSpeed" Theme="{StaticResource PlaybackValueChip}">
                  <SarilanMetin x:Name="TxtSeritSpeed" Theme="{StaticResource PlaybackValueTextBright}"/>
                </Border>
                <Button Grid.Column="4" x:Name="BtnSeritEdit" Theme="{StaticResource PlaybackBarButton}" IsVisible="False"
                        auto:AutomationProperties.Name="{loc:Text player.menu.edit}">
                  <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                        Data="{StaticResource IconEditor}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Grid.Column="5" x:Name="BtnSeritFullScreen" Theme="{StaticResource PlaybackBarButton}"
                        auto:AutomationProperties.Name="{loc:Text main.player.menu.fullscreen}">
                  <Path Width="{StaticResource IconSizeMd}" Height="{StaticResource IconSizeMd}" Stretch="Uniform"
                        Data="{StaticResource IconFullScreen}" Fill="{Binding $parent[Button].Foreground}"/>
                </Button>
              </Grid>
            </Grid>
          </Grid>
        </Border>
      </Panel>
    </Border>

    <Popup x:Name="PlaylistPopup"
           Placement="AnchorAndGravity"
           PlacementAnchor="TopLeft"
           PlacementGravity="BottomRight"
           PlacementConstraintAdjustment="SlideX,SlideY,ResizeY"
           IsLightDismissEnabled="False">
      <Border x:Name="PlaylistPanel" Classes="playlist">
        <StackPanel Spacing="{StaticResource SpaceSm}">
          <TextBox x:Name="PlaylistSearch"
                   Width="{StaticResource PlaylistWidth}"
                   PlaceholderText="{loc:Text player.list.search}"
                   auto:AutomationProperties.Name="{loc:Text player.list.search}"/>
          <ListBox x:Name="PlaylistList"
                   Width="{StaticResource PlaylistWidth}"
                   MaxHeight="{StaticResource PlaylistMaxHeight}"
                   Background="Transparent"
                   BorderThickness="0"
                   SelectionMode="Single"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ItemContainerTheme="{StaticResource PlaylistItem}"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
